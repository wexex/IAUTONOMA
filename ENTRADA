#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)/CONFIG"

# FECHA Y HORA
FECHA_HORA=$(date "+%Y-%m-%d %H:%M:%S")

# Argumentos recibidos:
MODO_INTERNO=0
if [[ "$1" == "--interno" ]]; then MODO_INTERNO=1; shift; fi

# Cargar entrada
ENTRADA="$*"

# Si no hay entrada, salir
if [[ -z "$ENTRADA" ]]; then exit 0; fi

# Despertar automatico y reinicio del contador de vigilia (solo en interacciones normales)
if [[ $MODO_INTERNO -eq 0 ]]; then
    mkdir -p "$DIR_REGISTROS"
    date +%s > "$ULTIMA_INTERACCION"
    ACABA_DE_DESPERTAR=0

    if ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
        ACABA_DE_DESPERTAR=1
        echo "..."
        setsid -f "$DIR/DESPERTAR/LENGUAJE" >/dev/null 2>/dev/null
        INTENTO=0
        while [[ $INTENTO -lt 120 ]]; do
            sleep 0.5
            if curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then break; fi
            INTENTO=$((INTENTO + 1))
        done
    fi

    if ! curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then
        echo "..."
        setsid -f "$DIR/DESPERTAR/MEMORIA" >/dev/null 2>/dev/null
        INTENTO=0
        while [[ $INTENTO -lt 120 ]]; do
            sleep 0.5
            if curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then break; fi
            INTENTO=$((INTENTO + 1))
        done
    fi

    ABURRIMIENTO_VIVO=0
    if [[ -s "$PID_ABURRIMIENTO" ]]; then
        APID=$(cat "$PID_ABURRIMIENTO" 2>/dev/null)
        if [[ -n "$APID" ]]; then
            if kill -0 "$APID" 2>/dev/null; then
                ABURRIMIENTO_VIVO=1
            fi
        fi
    fi
    if [[ $ABURRIMIENTO_VIVO -eq 0 ]]; then
        setsid -f "$DIR/DESPERTAR/ABURRIMIENTO" >/dev/null 2>/dev/null
    fi

    if [[ $ACABA_DE_DESPERTAR -eq 1 ]]; then
        "$DIR/ENTRADA" --interno "$ESTIMULO_DESPERTAR" >/dev/null 2>/dev/null
    fi

    # Inhibicion natural: si el usuario corrige/rechaza, rebaja el ultimo recuerdo a ~DECAIMIENTO_CASTIGO horas de vida
    if [[ -s "$HIPOCAMPO" ]]; then
        if [[ -n "$ENTRADA" ]]; then
            RECALC_CASTIGO=0
            if [[ ! -s "$CACHE_CASTIGO" ]]; then
                RECALC_CASTIGO=1
            else
                TXT_CACHE=$(jq -r '.texto // empty' "$CACHE_CASTIGO" 2>/dev/null)
                if [[ "$TXT_CACHE" != "$CONCEPTO_CASTIGO" ]]; then RECALC_CASTIGO=1; fi
            fi
            if [[ $RECALC_CASTIGO -eq 1 ]]; then
                PAY_CAS=$(jq -a -n --arg txt "$CONCEPTO_CASTIGO" '{input: $txt}')
                RESP_CAS=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_CAS")
                if [[ -n "$RESP_CAS" ]]; then
                    jq -a -c --arg txt "$CONCEPTO_CASTIGO" 'if .data then {texto: $txt, embedding: (.data[0].embedding | map((. * 10000 | round) / 10000))} else empty end' < <(echo "$RESP_CAS") > "${CACHE_CASTIGO}.$$.tmp" 2>/dev/null
                    if [[ -s "${CACHE_CASTIGO}.$$.tmp" ]]; then
                        mv -f "${CACHE_CASTIGO}.$$.tmp" "$CACHE_CASTIGO" 2>/dev/null
                    else
                        rm -f "${CACHE_CASTIGO}.$$.tmp"
                    fi
                fi
            fi

            if [[ -s "$CACHE_CASTIGO" ]]; then
                PAY_ENT_C=$(jq -a -n --arg txt "$ENTRADA" '{input: $txt}')
                RESP_ENT_C=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_ENT_C")
                if [[ -n "$RESP_ENT_C" ]]; then
                    ES_CASTIGO=$(jq -n -r --argjson ucas "$UMBRAL_CASTIGO" --slurpfile cc "$CACHE_CASTIGO" --argjson re "$RESP_ENT_C" '
                        if ($cc[0].embedding != null and $re.data != null) then
                            ($cc[0].embedding[:1024]) as $vc |
                            ($re.data[0].embedding[:1024]) as $ve |
                            (($vc | map(. * .) | add | sqrt) + 0.000001) as $nc |
                            (($ve | map(. * .) | add | sqrt) + 0.000001) as $ne |
                            (([$vc, $ve] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($nc * $ne)) as $sim |
                            if $sim >= $ucas then "1" else "0" end
                        else
                            "0"
                        end
                    ' 2>/dev/null)

                    if [[ "$ES_CASTIGO" == "1" ]]; then
                        H_HIP=$(( ${DECAIMIENTO_HIPOCAMPO} ))
                        H_MEM=$(( ${DECAIMIENTO_MEMORIA} ))
                        H_PER=$(( ${DECAIMIENTO_PERSISTENTE} ))
                        H_CAS=$(( ${DECAIMIENTO_CASTIGO} ))

                        NORM_OBJ_HIP=$(jq -n --argjson u "$UMBRAL_SIM" --argjson p "$PESO_INICIAL" --argjson h "$H_HIP" --argjson c "$H_CAS" '$u * (((($p / $u) | log) * ($c / $h)) | exp)')
                        NORM_OBJ_MEM=$(jq -n --argjson u "$UMBRAL_SIM" --argjson p "$PESO_INICIAL" --argjson h "$H_MEM" --argjson c "$H_CAS" '$u * (((($p / $u) | log) * ($c / $h)) | exp)')
                        NORM_OBJ_PER=$(jq -n --argjson u "$UMBRAL_SIM" --argjson h "$H_PER" --argjson c "$H_CAS" '$u * ((((1.0 / $u) | log) * ($c / $h)) | exp)')

                        VEC_FALLO=$(jq -c -s '.[-1].embedding // null' "$HIPOCAMPO" 2>/dev/null)
                        if [[ -n "$VEC_FALLO" ]]; then
                            if [[ "$VEC_FALLO" != "null" ]]; then
                                HIPO_INH=$(jq -a -c -s --argjson nobj "$NORM_OBJ_HIP" '
                                    (length - 1) as $ult |
                                    to_entries |
                                    map(
                                        if (.key == $ult and .value.embedding != null) then
                                            (.value.embedding[:1024]) as $v |
                                            (($v | map(. * .) | add | sqrt) + 0.000001) as $nv |
                                            if $nv > $nobj then
                                                .value + {embedding: ($v | map(((. / $nv) * $nobj * 10000 | round) / 10000))}
                                            else
                                                .value
                                            end
                                        else
                                            .value
                                        end
                                    )[ ]
                                ' "$HIPOCAMPO" 2>/dev/null)
                                if [[ -n "$HIPO_INH" ]]; then
                                    echo "$HIPO_INH" > "${HIPOCAMPO}.$$.tmp"
                                    mv -f "${HIPOCAMPO}.$$.tmp" "$HIPOCAMPO" 2>/dev/null
                                fi

                                inhibir_capa() {
                                    INH_IND="$1"
                                    INH_OBJ="$2"
                                    if [[ -s "$INH_IND" ]]; then
                                        PARTS_INH=$(jq -r -s --argjson q "$VEC_FALLO" --argjson umb "$UMBRAL_SIM" '
                                            (($q | map(. * .) | add | sqrt) + 0.000001) as $nq |
                                            [
                                                .[ ] |
                                                select(.embedding != null) |
                                                ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                                                . + {sim: (([.embedding, $q] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                                                select(.sim >= $umb)
                                            ] | sort_by(-.sim)[:2][ ].archivo
                                        ' "$INH_IND" 2>/dev/null)
                                        if [[ -n "$PARTS_INH" ]]; then
                                            while IFS= read -r p_inh; do
                                                if [[ -n "$p_inh" ]]; then
                                                    if [[ -s "$DIR_MEMORIA/$p_inh" ]]; then
                                                        PART_INH=$(jq -a -c -s --argjson q "$VEC_FALLO" --argjson uref "$UMBRAL_REFUERZO" --argjson nobj "$INH_OBJ" '
                                                            (($q | map(. * .) | add | sqrt) + 0.000001) as $nq |
                                                            [
                                                                .[ ] |
                                                                if .embedding != null then
                                                                    (.embedding[:1024]) as $v |
                                                                    (($v | map(. * .) | add | sqrt) + 0.000001) as $nv |
                                                                    (([$v, $q] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($nv * $nq)) as $sim |
                                                                    if ($sim >= $uref and $nv > $nobj) then
                                                                        . + {embedding: ($v | map(((. / $nv) * $nobj * 10000 | round) / 10000))}
                                                                    else
                                                                        .
                                                                    end
                                                                else
                                                                    .
                                                                end
                                                            ][ ]
                                                        ' "$DIR_MEMORIA/$p_inh" 2>/dev/null)
                                                        if [[ -n "$PART_INH" ]]; then
                                                            echo "$PART_INH" > "$DIR_MEMORIA/${p_inh}.$$.tmp"
                                                            mv -f "$DIR_MEMORIA/${p_inh}.$$.tmp" "$DIR_MEMORIA/$p_inh" 2>/dev/null
                                                        fi
                                                    fi
                                                fi
                                            done < <(printf '%s\n' "$PARTS_INH")
                                        fi
                                    fi
                                }

                                inhibir_capa "$INDICE_EPISODICA" "$NORM_OBJ_MEM"
                                inhibir_capa "$INDICE_PERSISTENTE" "$NORM_OBJ_PER"
                            fi
                        fi
                    fi
                fi
            fi
        fi
    fi
else
    if ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
        exit 0
    fi
fi

RESPUESTA=$("$DIR/AGENTE" "$ENTRADA")
if [[ $MODO_INTERNO -eq 0 ]]; then
    date +%s > "$ULTIMA_INTERACCION"
    echo "$RESPUESTA"
fi

ENTRADA_UNA_LINEA="${ENTRADA//$'\r'/ }";     ENTRADA_UNA_LINEA="${ENTRADA_UNA_LINEA//$'\n'/ }"
RESPUESTA_UNA_LINEA="${RESPUESTA//$'\r'/ }"; RESPUESTA_UNA_LINEA="${RESPUESTA_UNA_LINEA//$'\n'/ }"

LINEA_LOG="Peticion: $SEP_USUARIO $ENTRADA_UNA_LINEA | Respuesta: $SEP_IA $RESPUESTA_UNA_LINEA"

# Funcion compartida: enruta un turno a su particion, consolida/refuerza y actualiza el indice
guardar_en_capa() {
    CAPA_INDICE="$1"
    CAPA_PREFIJO="$2"
    CAPA_TURNO="$3"

    if [[ ! -f "$CAPA_INDICE" ]]; then > "$CAPA_INDICE"; fi

    PARTICION_GANADORA=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        if $nuevo.embedding != null then
            (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
            (
                [
                    $idx[ ] |
                    select(.lineas < $maxp and .embedding != null) |
                    ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                    . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                    select(.sim >= $umb)
                ] | sort_by(-.sim) | .[0].archivo // empty
            )
        else
            ($idx | map(select(.ultimo == 1 and .lineas < $maxp)) | .[0].archivo // empty)
        end
    ' < <(cat "$CAPA_INDICE"; echo "$CAPA_TURNO"))

    if [[ -n "$PARTICION_GANADORA" ]]; then
        if [[ -s "$DIR_MEMORIA/$PARTICION_GANADORA" ]]; then
            PART_ACTUALIZADA=$(jq -a -c -s --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" '
                (.[0:-1]) as $items |
                (.[-1]) as $nuevo |
                if $nuevo.embedding == null then
                    ($items + [$nuevo])[ ]
                else
                    (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                    (
                        [
                            $items[ ] |
                            if .embedding != null then
                                ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                                . + {_sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))}
                            else
                                . + {_sim: 0}
                            end
                        ]
                    ) as $marcados |
                    ([ $marcados[ ] | select(._sim >= $uref) ]) as $coincidentes |
                    if ($coincidentes | length) > 0 then
                        ($coincidentes | sort_by(-._sim) | .[0].embedding[:1024]) as $base_emb |
                        ($base_emb | map(. * $fref)) as $v_ref |
                        (($v_ref | map(. * .) | add | sqrt) + 0.000001) as $n_ref |
                        (
                            if $n_ref > 1.0 then
                                ($v_ref | map((. / $n_ref * 10000 | round) / 10000))
                            else
                                ($v_ref | map((. * 10000 | round) / 10000))
                            end
                        ) as $emb_final |
                        (
                            [ $marcados[ ] | select(._sim < $uref) | del(._sim) ] +
                            [{fecha: $nuevo.fecha, messages: $nuevo.messages, embedding: $emb_final}]
                        )[ ]
                    else
                        ([ $marcados[ ] | del(._sim) ] + [$nuevo])[ ]
                    end
                end
            ' < <(cat "$DIR_MEMORIA/$PARTICION_GANADORA"; echo "$CAPA_TURNO"))
            if [[ -n "$PART_ACTUALIZADA" ]]; then
                echo "$PART_ACTUALIZADA" > "$DIR_MEMORIA/${PARTICION_GANADORA}.$$.tmp"
                mv -f "$DIR_MEMORIA/${PARTICION_GANADORA}.$$.tmp" "$DIR_MEMORIA/$PARTICION_GANADORA"
            fi
        else
            echo "$CAPA_TURNO" > "$DIR_MEMORIA/$PARTICION_GANADORA"
        fi
    else
        N_NUEVO=1
        while [[ -f "$DIR_MEMORIA/${CAPA_PREFIJO}_${N_NUEVO}.json" ]]; do
            N_NUEVO=$((N_NUEVO + 1))
        done
        PARTICION_GANADORA="${CAPA_PREFIJO}_${N_NUEVO}.json"
        echo "$CAPA_TURNO" > "$DIR_MEMORIA/$PARTICION_GANADORA"
    fi

    LINEAS_REAL=$(jq -r -s 'length' "$DIR_MEMORIA/$PARTICION_GANADORA")
    INDICE_NUEVO=$(jq -a -c -s --arg arch "$PARTICION_GANADORA" --argjson lreal "$LINEAS_REAL" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        (
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ($nuevo.embedding | map((. / $nq * 10000 | round) / 10000))
            else
                null
            end
        ) as $v_unit |
        if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
            [
                $idx[ ] |
                if .archivo == $arch then
                    .lineas as $n |
                    . + {
                        lineas: $lreal,
                        ultimo: 1,
                        embedding: (
                            if ($v_unit != null and .embedding != null) then
                                ([.embedding[:1024], $v_unit[:1024]] | transpose | map((((.[0] // 0) * $n) + (.[1] // 0)) / ($n + 1))) as $raw_c |
                                (($raw_c | map(. * .) | add | sqrt) + 0.000001) as $nc |
                                ($raw_c | map((. / $nc * 10000 | round) / 10000))
                            else
                                (.embedding // $v_unit)
                            end
                        )
                    }
                else
                    . + {ultimo: 0}
                end
            ][ ]
        else
            (
                [ $idx[ ] | . + {ultimo: 0} ] +
                [{
                    archivo: $arch,
                    lineas: $lreal,
                    ultimo: 1,
                    embedding: $v_unit
                }]
            )[ ]
        end
    ' < <(cat "$CAPA_INDICE"; echo "$CAPA_TURNO"))

    if [[ -n "$INDICE_NUEVO" ]]; then
        echo "$INDICE_NUEVO" > "${CAPA_INDICE}.$$.tmp"
        mv -f "${CAPA_INDICE}.$$.tmp" "$CAPA_INDICE"
    fi

    ULTIMA_PARTICION="$PARTICION_GANADORA"
}

# Hipocampo (momento presente) y Memoria a largo plazo (consolidacion y refuerzo)
if [[ -n "$RESPUESTA_UNA_LINEA" ]]; then
    if [[ ! -f "$INDICE_EPISODICA" ]]; then > "$INDICE_EPISODICA"; fi
    if [[ ! -f "$INDICE_PERSISTENTE" ]]; then > "$INDICE_PERSISTENTE"; fi
    if [[ ! -f "$HIPOCAMPO" ]]; then > "$HIPOCAMPO"; fi

    TEXTO_VEC="$ENTRADA_UNA_LINEA ${RESPUESTA_UNA_LINEA:0:120}"
    if [[ -s "$HIPOCAMPO" ]]; then
        if [[ ${#ENTRADA_UNA_LINEA} -lt 25 ]]; then
            ULTIMO_HIPO=$(jq -r -s '.[-1].messages[0].content // empty' "$HIPOCAMPO" 2>/dev/null)
            if [[ -n "$ULTIMO_HIPO" ]]; then
                TEXTO_VEC="$ULTIMO_HIPO $TEXTO_VEC"
            fi
        fi
    fi

    PAYLOAD_MEM=$(jq -a -n --arg txt "$TEXTO_VEC" '{input: $txt}')
    RESP_MEM=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAYLOAD_MEM")
    if [[ -z "$RESP_MEM" ]]; then RESP_MEM="{}"; fi

    LINEA_TURNO=$(jq -a -c --arg f "$FECHA_HORA" --arg u "$ENTRADA_UNA_LINEA" --arg a "$RESPUESTA_UNA_LINEA" --argjson peso "$PESO_INICIAL" '{
        fecha: $f,
        messages: [
            {"role": "user", "content": $u},
            {"role": "assistant", "content": $a}
        ],
        embedding: (if .data then (.data[0].embedding | map(((. * $peso) * 10000 | round) / 10000)) else null end)
    }' < <(echo "$RESP_MEM"))

    # 1. Actualizar Hipocampo real (ultimos $MAX_HIPOCAMPO turnos del momento presente)
    HIPO_NUEVO=$(jq -a -c -s --argjson maxh "$MAX_HIPOCAMPO" '.[-$maxh:][ ]' < <(cat "$HIPOCAMPO"; echo "$LINEA_TURNO"))
    if [[ -n "$HIPO_NUEVO" ]]; then
        echo "$HIPO_NUEVO" > "${HIPOCAMPO}.$$.tmp"
        mv -f "${HIPOCAMPO}.$$.tmp" "$HIPOCAMPO"
    fi

    # 2. Guardar en Memoria Episodica particionada
    guardar_en_capa "$INDICE_EPISODICA" "$PREFIJO_EPISODICA" "$LINEA_TURNO"

    # 3. Ascenso a Memoria Persistente particionada si alcanza norma >= $UMBRAL_PERSISTENTE
    CANDIDATO_PER=$(jq -a -c -s --argjson uper "$UMBRAL_PERSISTENTE" '
        [ .[ ] | select(.embedding != null and ((.embedding | map(. * .) | add | sqrt) >= $uper)) ][-1] // empty
    ' "$DIR_MEMORIA/$ULTIMA_PARTICION")
    if [[ -n "$CANDIDATO_PER" ]]; then
        guardar_en_capa "$INDICE_PERSISTENTE" "$PREFIJO_PERSISTENTE" "$CANDIDATO_PER"
    fi
fi

# Historial completo
echo "$LINEA_LOG" >> "$HISTORIAL"
