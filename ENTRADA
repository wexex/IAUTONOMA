#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)/CONFIG"

# FECHA Y HORA
FECHA_HORA=$(date "+%Y-%m-%d %H:%M:%S")

# Argumentos recibidos:
MODO_CONSOLIDAR=0
ARCH_TURNO_CONSOLIDAR=""
ARCH_TRAZA_CONSOLIDAR=""
MODO_INTERNO=0
if [[ "$1" == "--consolidar" ]]; then
    MODO_CONSOLIDAR=1
    ARCH_TURNO_CONSOLIDAR="$2"
    ARCH_TRAZA_CONSOLIDAR="$3"
elif [[ "$1" == "--interno" ]]; then
    MODO_INTERNO=1
    shift
fi
export MODO_INTERNO

if [[ $MODO_CONSOLIDAR -eq 1 ]]; then
    if [[ ! -s "$ARCH_TURNO_CONSOLIDAR" ]]; then
        rm -f "$ARCH_TRAZA_CONSOLIDAR" 2>/dev/null
        exit 0
    fi
    mkdir -p "$DIR_REGISTROS"
    ESPERA_C=0
    while [[ $ESPERA_C -lt 100 ]]; do
        if [[ ! -s "$LOCK_MEMORIA" ]]; then break; fi
        LPID_C=$(cat "$LOCK_MEMORIA" 2>/dev/null)
        if [[ -z "$LPID_C" ]]; then break; fi
        if ! kill -0 "$LPID_C" 2>/dev/null; then
            rm -f "$LOCK_MEMORIA" 2>/dev/null
            break
        fi
        sleep 0.1
        ESPERA_C=$((ESPERA_C + 1))
    done
    echo "$$" > "$LOCK_MEMORIA"
    trap 'rm -f "$LOCK_MEMORIA" "$ARCH_TURNO_CONSOLIDAR" "$ARCH_TRAZA_CONSOLIDAR"' EXIT
    {
        IFS= read -r FECHA_HORA
        IFS= read -r ENTRADA_UNA_LINEA
        IFS= read -r RESPUESTA_UNA_LINEA
    } < "$ARCH_TURNO_CONSOLIDAR"
else
    # Cargar entrada
    ENTRADA="$*"

    # Si no hay entrada, salir
    if [[ -z "$ENTRADA" ]]; then exit 0; fi

    # Despertar automatico y reinicio del contador de vigilia (solo en interacciones normales)
    if [[ $MODO_INTERNO -eq 0 ]]; then
        mkdir -p "$DIR_REGISTROS"
        date +%s > "$ULTIMA_INTERACCION"
        ACABA_DE_DESPERTAR=0

        # Si el agente esta durmiendo (entrenamiento/REM), avisar despertar y esperar pausa limpia con checkpoint
        if [[ -s "$PID_DORMIR" ]]; then
            DPID=$(cat "$PID_DORMIR" 2>/dev/null)
            DORMIR_ACTIVO=0
            if [[ -n "$DPID" ]]; then
                if kill -0 "$DPID" 2>/dev/null; then
                    DORMIR_ACTIVO=1
                    echo "..."
                    date +%s > "$SENAL_DESPERTAR"
                    ESPERA_D=0
                    while [[ $ESPERA_D -lt 250 ]]; do
                        if ! kill -0 "$DPID" 2>/dev/null; then
                            DORMIR_ACTIVO=0
                            break
                        fi
                        if [[ $ESPERA_D -eq 200 ]]; then
                            kill -TERM "$DPID" 2>/dev/null
                        fi
                        sleep 0.2
                        ESPERA_D=$((ESPERA_D + 1))
                    done
                fi
            fi
            if [[ $DORMIR_ACTIVO -eq 0 ]]; then
                rm -f "$PID_DORMIR" "$SENAL_DESPERTAR" 2>/dev/null
            fi
        elif [[ -f "$SENAL_DESPERTAR" ]]; then
            rm -f "$SENAL_DESPERTAR" 2>/dev/null
        fi

        if ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
            ACABA_DE_DESPERTAR=1
            echo "..."
            true < <(setsid "$DIR/DESPERTAR/LENGUAJE" </dev/null >/dev/null 2>/dev/null)
            INTENTO=0
            while [[ $INTENTO -lt 120 ]]; do
                sleep 0.5
                if curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then break; fi
                INTENTO=$((INTENTO + 1))
            done
        fi

        if ! curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then
            echo "..."
            true < <(setsid "$DIR/DESPERTAR/MEMORIA" </dev/null >/dev/null 2>/dev/null)
            INTENTO=0
            while [[ $INTENTO -lt 120 ]]; do
                sleep 0.5
                if curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then break; fi
                INTENTO=$((INTENTO + 1))
            done
        fi

        ABURRIMIENTO_VIVO=0
        if [[ -s "$PID_ABURRIMIENTO" ]]; then
            APID=$(cat "$PID_ABURRIMIENTO" 2>/dev/null)
            if [[ -n "$APID" ]]; then
                if kill -0 "$APID" 2>/dev/null; then
                    ABURRIMIENTO_VIVO=1
                fi
            fi
        fi
        if [[ $ABURRIMIENTO_VIVO -eq 0 ]]; then
            true < <(setsid "$DIR/DESPERTAR/ABURRIMIENTO" </dev/null >/dev/null 2>/dev/null)
        fi

        if [[ ! -e "$PARADA_OLVIDO" ]]; then
            OLVIDO_VIVO=0
            if [[ -s "$PID_OLVIDO" ]]; then
                OPID=$(cat "$PID_OLVIDO" 2>/dev/null)
                if [[ -n "$OPID" ]]; then
                    if kill -0 "$OPID" 2>/dev/null; then
                        OLVIDO_VIVO=1
                    fi
                fi
            fi
            if [[ $OLVIDO_VIVO -eq 0 ]]; then
                true < <(setsid "$DIR/DESPERTAR/OLVIDO" --daemon </dev/null >/dev/null 2>/dev/null)
            fi
        fi

        if [[ $ACABA_DE_DESPERTAR -eq 1 ]]; then
            ENTRADA="[$FECHA_HORA] $ESTIMULO_DESPERTAR $ENTRADA"
        fi
    else
        if ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
            exit 0
        fi
    fi

    ARCH_TRAZA_TOOL=""
    if [[ $MODO_INTERNO -eq 0 ]]; then
        ARCH_TRAZA_TOOL="$DIR_REGISTROS/.traza_tool.$$.json"
        rm -f "$ARCH_TRAZA_TOOL" 2>/dev/null
        export ARCH_TRAZA_TOOL
    fi

    RESPUESTA=$("$DIR/AGENTE" "$ENTRADA")
    if [[ $MODO_INTERNO -eq 0 ]]; then
        date +%s > "$ULTIMA_INTERACCION"
        echo "$RESPUESTA"
    fi

    ENTRADA_UNA_LINEA="${ENTRADA//$'\r'/ }";     ENTRADA_UNA_LINEA="${ENTRADA_UNA_LINEA//$'\n'/ }"
    RESPUESTA_UNA_LINEA="${RESPUESTA//$'\r'/ }"; RESPUESTA_UNA_LINEA="${RESPUESTA_UNA_LINEA//$'\n'/ }"

    LINEA_LOG="Peticion: $SEP_USUARIO $ENTRADA_UNA_LINEA | Respuesta: $SEP_IA $RESPUESTA_UNA_LINEA"
    echo "$LINEA_LOG" >> "$HISTORIAL"

    if [[ $MODO_INTERNO -eq 0 ]]; then
        if [[ -n "$RESPUESTA_UNA_LINEA" ]]; then
            ARCH_TURNO_TMP="$DIR_REGISTROS/.turno.$$.tmp"
            printf '%s\n%s\n%s\n' "$FECHA_HORA" "$ENTRADA_UNA_LINEA" "$RESPUESTA_UNA_LINEA" > "$ARCH_TURNO_TMP"
            true < <(setsid "$DIR/ENTRADA" --consolidar "$ARCH_TURNO_TMP" "$ARCH_TRAZA_TOOL" </dev/null >/dev/null 2>/dev/null)
        else
            rm -f "$ARCH_TRAZA_TOOL" 2>/dev/null
        fi
        exit 0
    fi
fi

# Funcion compartida: enruta un turno a su particion, reconsolida/refuerza (LTP) o atenua por divergencia (LTD) y actualiza el indice
guardar_en_capa() {
    CAPA_INDICE="$1"
    CAPA_PREFIJO="$2"
    CAPA_TURNO="$3"
    CAPA_NORM_OBJ="$4"

    if [[ ! -f "$CAPA_INDICE" ]]; then > "$CAPA_INDICE"; fi

    PARTICION_GANADORA=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        if $nuevo.embedding != null then
            (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
            (
                [
                    $idx[ ] |
                    select(.lineas < $maxp and .embedding != null) |
                    ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                    . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                    select(.sim >= $umb)
                ] | sort_by(-.sim) | .[0].archivo // empty
            )
        else
            ($idx | map(select(.ultimo == 1 and .lineas < $maxp)) | .[0].archivo // empty)
        end
    ' < <(cat "$CAPA_INDICE"; echo "$CAPA_TURNO"))

    if [[ -n "$PARTICION_GANADORA" ]]; then
        if [[ -s "$DIR_MEMORIA/$PARTICION_GANADORA" ]]; then
            PART_ACTUALIZADA=$(jq -a -c -s --argjson umb "$UMBRAL_SIM" --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" --argjson nobj "$CAPA_NORM_OBJ" '
                def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                def cos($a; $b):
                    if ($a != null and $b != null) then
                        (dot($a; $b) / (norm($a) * norm($b)))
                    else
                        null
                    end;
                (.[0:-1]) as $items |
                (.[-1]) as $nuevo |
                if $nuevo.embedding == null then
                    ($items + [$nuevo])[ ]
                else
                    (norm($nuevo.embedding)) as $nq |
                    ($nuevo.embedding[:1024] | map(. / $nq)) as $u_nuevo |
                    (($umb + $uref) / 2) as $u_med |
                    (($uref + 1.0) / 2) as $u_loro |
                    (($fref - 1.0) / 2) as $d_min |
                    (cos($nuevo.emb_u; $nuevo.emb_a)) as $nua |
                    (
                        [
                            $items[ ] |
                            if (type == "object" and .embedding != null) then
                                (norm(.embedding)) as $ne |
                                (cos(.emb_u; $nuevo.emb_u)) as $su |
                                (cos(.emb_a; $nuevo.emb_a)) as $sa |
                                (cos(.emb_u; $nuevo.emb_a)) as $sua |
                                . + {
                                    _sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq)),
                                    _su: $su,
                                    _sa: $sa,
                                    _sua: $sua,
                                    _loro: (if ($sa != null and $su != null and $sa >= $u_loro and $su < $u_med) then 1 else 0 end),
                                    _ne: $ne
                                }
                            else
                                . + {_sim: 0, _su: null, _sa: null, _sua: null, _loro: 0, _ne: 0}
                            end
                        ]
                    ) as $marcados |
                    ([ $marcados[ ] | select(._sim >= $uref and ._loro == 0) ]) as $coincidentes |
                    if ($coincidentes | length) > 0 then
                        ($coincidentes | sort_by(-._sim) | .[0]) as $gan |
                        ($gan._ne) as $n_base |
                        (
                            if (($nuevo.herramienta // 0) == 1 or ($gan.herramienta // 0) == 1 or ((($nuevo.messages[1].content // "") | startswith("["))) or ((($gan.messages[1].content // "") | startswith("[")))) then
                                1
                            else
                                0
                            end
                        ) as $es_herr |
                        (
                            if $es_herr == 1 then
                                $nq
                            else
                                (if ($n_base * $fref) > $nq then ($n_base * $fref) else $nq end) as $n_bruto |
                                (if $n_bruto > 1.0 then 1.0 else $n_bruto end)
                            end
                        ) as $n_ref |
                        ($u_nuevo | map((. * $n_ref * 10000 | round) / 10000)) as $emb_final |
                        (
                            [ $marcados[ ] | select(._sim < $uref or ._loro == 1) | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne) ] +
                            [($nuevo + {herramienta: $es_herr, embedding: $emb_final})]
                        )[ ]
                    else
                        ([
                            $marcados | to_entries[ ] |
                            select(
                                (((.value.messages[0].content // "") | startswith("<<")) | not) and
                                .value._sim >= $umb and .value._sim < $uref and
                                (.value._su == null or .value._sua == null or .value._sa == null or .value._su >= .value._sua or .value._sa < $uref) and
                                (
                                    if (.value._sa != null and .value._su != null) then
                                        ((.value._sa >= $u_med and (.value._sa - .value._su) >= $d_min) or (.value._su >= $u_med and (.value._su - .value._sa) >= ($d_min * 2)))
                                    else
                                        (.value._sim >= $u_med)
                                    end
                                )
                            )
                        ] | sort_by(-.value._sim) | .[0].key // -1) as $k_ltd |
                        ([ $marcados[ ] | select(._loro == 1) ] | length) as $hay_loro |
                        (
                            if $hay_loro > 0 then
                                ($nuevo + {embedding: ($u_nuevo | map((. * $nobj * 10000 | round) / 10000))})
                            else
                                $nuevo
                            end
                        ) as $nuevo_fin |
                        (
                            [
                                $marcados | to_entries[ ] |
                                if ($k_ltd >= 0 and .key == $k_ltd and .value._ne > $nobj) then
                                    (.value.embedding[:1024]) as $v |
                                    (.value._ne) as $ne |
                                    (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne)) + {embedding: ($v | map(((. / $ne) * $nobj * 10000 | round) / 10000))}
                                else
                                    (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne))
                                end
                            ] + [$nuevo_fin]
                        )[ ]
                    end
                end
            ' < <(cat "$DIR_MEMORIA/$PARTICION_GANADORA"; echo "$CAPA_TURNO"))
            if [[ -n "$PART_ACTUALIZADA" ]]; then
                echo "$PART_ACTUALIZADA" > "$DIR_MEMORIA/${PARTICION_GANADORA}.$$.tmp"
                mv -f "$DIR_MEMORIA/${PARTICION_GANADORA}.$$.tmp" "$DIR_MEMORIA/$PARTICION_GANADORA"
            fi
        else
            echo "$CAPA_TURNO" > "$DIR_MEMORIA/$PARTICION_GANADORA"
        fi
    else
        N_NUEVO=1
        while [[ -f "$DIR_MEMORIA/${CAPA_PREFIJO}_${N_NUEVO}.json" ]]; do
            N_NUEVO=$((N_NUEVO + 1))
        done
        PARTICION_GANADORA="${CAPA_PREFIJO}_${N_NUEVO}.json"
        echo "$CAPA_TURNO" > "$DIR_MEMORIA/$PARTICION_GANADORA"
    fi

    LINEAS_REAL=$(jq -r -s 'length' "$DIR_MEMORIA/$PARTICION_GANADORA")
    INDICE_NUEVO=$(jq -a -c -s --arg arch "$PARTICION_GANADORA" --argjson lreal "$LINEAS_REAL" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        (
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ($nuevo.embedding | map((. / $nq * 10000 | round) / 10000))
            else
                null
            end
        ) as $v_unit |
        if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
            [
                $idx[ ] |
                if .archivo == $arch then
                    .lineas as $n |
                    . + {
                        lineas: $lreal,
                        ultimo: 1,
                        embedding: (
                            if ($v_unit != null and .embedding != null) then
                                ([.embedding[:1024], $v_unit[:1024]] | transpose | map((((.[0] // 0) * $n) + (.[1] // 0)) / ($n + 1))) as $raw_c |
                                (($raw_c | map(. * .) | add | sqrt) + 0.000001) as $nc |
                                ($raw_c | map((. / $nc * 10000 | round) / 10000))
                            else
                                (.embedding // $v_unit)
                            end
                        )
                    }
                else
                    . + {ultimo: 0}
                end
            ][ ]
        else
            (
                [ $idx[ ] | . + {ultimo: 0} ] +
                [{
                    archivo: $arch,
                    lineas: $lreal,
                    ultimo: 1,
                    embedding: $v_unit
                }]
            )[ ]
        end
    ' < <(cat "$CAPA_INDICE"; echo "$CAPA_TURNO"))

    if [[ -n "$INDICE_NUEVO" ]]; then
        echo "$INDICE_NUEVO" > "${CAPA_INDICE}.$$.tmp"
        mv -f "${CAPA_INDICE}.$$.tmp" "$CAPA_INDICE"
    fi

    ULTIMA_PARTICION="$PARTICION_GANADORA"
}

# Hipocampo (momento presente) y Memoria a largo plazo (consolidacion y refuerzo)
if [[ -n "$RESPUESTA_UNA_LINEA" ]]; then
    if [[ ! -f "$INDICE_EPISODICA" ]]; then > "$INDICE_EPISODICA"; fi
    if [[ ! -f "$INDICE_PERSISTENTE" ]]; then > "$INDICE_PERSISTENTE"; fi
    if [[ ! -f "$HIPOCAMPO" ]]; then > "$HIPOCAMPO"; fi

    TEXTO_RESP_VEC="${RESPUESTA_UNA_LINEA:0:120}"
    TEXTO_VEC="$ENTRADA_UNA_LINEA $TEXTO_RESP_VEC"

    PAYLOAD_MEM=$(jq -a -n --arg t "$TEXTO_VEC" --arg u "$ENTRADA_UNA_LINEA" --arg a "$TEXTO_RESP_VEC" '{input: [$t, $u, $a]}')
    RESP_MEM=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAYLOAD_MEM")
    if [[ -z "$RESP_MEM" ]]; then RESP_MEM="{}"; fi

    LINEA_TURNO=$(jq -a -c --arg f "$FECHA_HORA" --arg u "$ENTRADA_UNA_LINEA" --arg a "$RESPUESTA_UNA_LINEA" --argjson peso "$PESO_INICIAL" '{
        fecha: $f,
        herramienta: (if ($a | startswith("[")) then 1 else 0 end),
        messages: [
            {"role": "user", "content": $u},
            {"role": "assistant", "content": $a}
        ],
        embedding: (if (.data and (.data | length) > 0) then (.data[0].embedding | map(((. * $peso) * 10000 | round) / 10000)) else null end),
        emb_u: (if (.data and (.data | length) > 1) then (.data[1].embedding | map((. * 10000 | round) / 10000)) else null end),
        emb_a: (if (.data and (.data | length) > 2) then (.data[2].embedding | map((. * 10000 | round) / 10000)) else null end)
    }' < <(echo "$RESP_MEM"))

    H_HIP=$(( ${DECAIMIENTO_HIPOCAMPO} ))
    H_MEM=$(( ${DECAIMIENTO_MEMORIA} ))
    H_PER=$(( ${DECAIMIENTO_PERSISTENTE} ))
    H_CAS=$(( ${DECAIMIENTO_CASTIGO} ))

    read -r NORM_OBJ_HIP NORM_OBJ_MEM NORM_OBJ_PER < <(jq -r -n \
        --argjson u "$UMBRAL_SIM" \
        --argjson p "$PESO_INICIAL" \
        --argjson hh "$H_HIP" \
        --argjson hm "$H_MEM" \
        --argjson hp "$H_PER" \
        --argjson c "$H_CAS" '
        [
            ($u * (((($p / $u) | log) * ($c / $hh)) | exp)),
            ($u * (((($p / $u) | log) * ($c / $hm)) | exp)),
            ($u * ((((1.0 / $u) | log) * ($c / $hp)) | exp))
        ] | map(tostring) | join(" ")
    ')

    # 1. Actualizar Hipocampo real con plasticidad LTP / LTD de doble vector (OLVIDO gestiona su decaimiento de 24h)
    HIPO_NUEVO=$(jq -a -c -s --argjson maxp "$MAX_PARTICION" --argjson umb "$UMBRAL_SIM" --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" --argjson nobj "$NORM_OBJ_HIP" '
        def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
        def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
        def cos($a; $b):
            if ($a != null and $b != null) then
                (dot($a; $b) / (norm($a) * norm($b)))
            else
                null
            end;
        (.[0:-1]) as $items |
        (.[-1]) as $nuevo |
        if ($nuevo.embedding == null or ($items | length) == 0) then
            ($items + [$nuevo])[-$maxp:][ ]
        else
            (norm($nuevo.embedding)) as $nq |
            ($nuevo.embedding[:1024] | map(. / $nq)) as $u_nuevo |
            (($umb + $uref) / 2) as $u_med |
            (($uref + 1.0) / 2) as $u_loro |
            (($fref - 1.0) / 2) as $d_min |
            (cos($nuevo.emb_u; $nuevo.emb_a)) as $nua |
            (
                [
                    $items[ ] |
                    if (type == "object" and .embedding != null) then
                        (norm(.embedding)) as $ne |
                        (cos(.emb_u; $nuevo.emb_u)) as $su |
                        (cos(.emb_a; $nuevo.emb_a)) as $sa |
                        (cos(.emb_u; $nuevo.emb_a)) as $sua |
                        . + {
                            _sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq)),
                            _su: $su,
                            _sa: $sa,
                            _sua: $sua,
                            _loro: (if ($sa != null and $su != null and $sa >= $u_loro and $su < $u_med) then 1 else 0 end),
                            _ne: $ne
                        }
                    else
                        . + {_sim: 0, _su: null, _sa: null, _sua: null, _loro: 0, _ne: 0}
                    end
                ]
            ) as $marcados |
            ([ $marcados[ ] | select(._sim >= $uref and ._loro == 0) ]) as $coincidentes |
            if ($coincidentes | length) > 0 then
                ($coincidentes | sort_by(-._sim) | .[0]) as $gan |
                ($gan._ne) as $n_base |
                (
                    if (($nuevo.herramienta // 0) == 1 or ($gan.herramienta // 0) == 1 or ((($nuevo.messages[1].content // "") | startswith("["))) or ((($gan.messages[1].content // "") | startswith("[")))) then
                        1
                    else
                        0
                    end
                ) as $es_herr |
                (
                    if $es_herr == 1 then
                        $nq
                    else
                        (if ($n_base * $fref) > $nq then ($n_base * $fref) else $nq end) as $n_bruto |
                        (if $n_bruto > 1.0 then 1.0 else $n_bruto end)
                    end
                ) as $n_ref |
                ($u_nuevo | map((. * $n_ref * 10000 | round) / 10000)) as $emb_final |
                (
                    [ $marcados[ ] | select(._sim < $uref or ._loro == 1) | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne) ] +
                    [($nuevo + {herramienta: $es_herr, embedding: $emb_final})]
                )[-$maxp:][ ]
            else
                ([
                    $marcados | to_entries[ ] |
                    select(
                        (((.value.messages[0].content // "") | startswith("<<")) | not) and
                        .value._sim >= $umb and .value._sim < $uref and
                        (.value._su == null or .value._sua == null or .value._sa == null or .value._su >= .value._sua or .value._sa < $uref) and
                        (
                            if (.value._sa != null and .value._su != null) then
                                ((.value._sa >= $u_med and (.value._sa - .value._su) >= $d_min) or (.value._su >= $u_med and (.value._su - .value._sa) >= ($d_min * 2)))
                            else
                                (.value._sim >= $u_med)
                            end
                        )
                    )
                ] | sort_by(-.value._sim) | .[0].key // -1) as $k_ltd |
                ([ $marcados[ ] | select(._loro == 1) ] | length) as $hay_loro |
                (
                    if $hay_loro > 0 then
                        ($nuevo + {embedding: ($u_nuevo | map((. * $nobj * 10000 | round) / 10000))})
                    else
                        $nuevo
                    end
                ) as $nuevo_fin |
                (
                    [
                        $marcados | to_entries[ ] |
                        if ($k_ltd >= 0 and .key == $k_ltd and .value._ne > $nobj) then
                            (.value.embedding[:1024]) as $v |
                            (.value._ne) as $ne |
                            (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne)) + {embedding: ($v | map(((. / $ne) * $nobj * 10000 | round) / 10000))}
                        else
                            (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne))
                        end
                    ] + [$nuevo_fin]
                )[-$maxp:][ ]
            end
        end
    ' < <(cat "$HIPOCAMPO"; echo "$LINEA_TURNO"))
    if [[ -n "$HIPO_NUEVO" ]]; then
        echo "$HIPO_NUEVO" > "${HIPOCAMPO}.$$.tmp"
        mv -f "${HIPOCAMPO}.$$.tmp" "$HIPOCAMPO"
    fi

    # 2. Guardar en Memoria Episodica particionada
    guardar_en_capa "$INDICE_EPISODICA" "$PREFIJO_EPISODICA" "$LINEA_TURNO" "$NORM_OBJ_MEM"

    # 3. Ascenso a Memoria Persistente particionada solo si el turno recien guardado (ultima linea) alcanzo norma >= $UMBRAL_PERSISTENTE, o LTD si colisiona con un recuerdo persistente
    CANDIDATO_PER=$(jq -a -c --argjson uper "$UMBRAL_PERSISTENTE" '
        select((.herramienta // 0) == 0 and (((.messages[1].content // "") | startswith("[")) | not) and (((.messages[0].content // "") | startswith("<<")) | not) and .embedding != null and ((.embedding | map(. * .) | add | sqrt) >= $uper))
    ' < <(tail -n 1 "$DIR_MEMORIA/$ULTIMA_PARTICION"))
    if [[ -n "$CANDIDATO_PER" ]]; then
        guardar_en_capa "$INDICE_PERSISTENTE" "$PREFIJO_PERSISTENTE" "$CANDIDATO_PER" "$NORM_OBJ_PER"
    elif [[ -s "$INDICE_PERSISTENTE" ]]; then
        PART_PER_LTD=$(jq -r -s --argjson umb "$UMBRAL_SIM" '
            (.[0:-1]) as $idx |
            (.[-1]) as $nuevo |
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                (
                    [
                        $idx[ ] |
                        select(.embedding != null) |
                        ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                        . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                        select(.sim >= $umb)
                    ] | sort_by(-.sim) | .[0].archivo // empty
                )
            else
                empty
            end
        ' < <(cat "$INDICE_PERSISTENTE"; echo "$LINEA_TURNO"))
        if [[ -n "$PART_PER_LTD" ]]; then
            if [[ -s "$DIR_MEMORIA/$PART_PER_LTD" ]]; then
                PER_LTD_ACT=$(jq -a -c -s --argjson umb "$UMBRAL_SIM" --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" --argjson nobj "$NORM_OBJ_PER" '
                    def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    def cos($a; $b):
                        if ($a != null and $b != null) then
                            (dot($a; $b) / (norm($a) * norm($b)))
                        else
                            null
                        end;
                    (.[0:-1]) as $items |
                    (.[-1]) as $nuevo |
                    if $nuevo.embedding == null then
                        empty
                    else
                        (norm($nuevo.embedding)) as $nq |
                        (($umb + $uref) / 2) as $u_med |
                        (($uref + 1.0) / 2) as $u_loro |
                        (($fref - 1.0) / 2) as $d_min |
                        (
                            [
                                $items[ ] |
                                if (type == "object" and .embedding != null) then
                                    (norm(.embedding)) as $ne |
                                    (cos(.emb_u; $nuevo.emb_u)) as $su |
                                    (cos(.emb_a; $nuevo.emb_a)) as $sa |
                                    . + {
                                        _sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq)),
                                        _su: $su,
                                        _sa: $sa,
                                        _loro: (if ($sa != null and $su != null and $sa >= $u_loro and $su < $uref) then 1 else 0 end),
                                        _ne: $ne
                                    }
                                else
                                    . + {_sim: 0, _su: null, _sa: null, _loro: 0, _ne: 0}
                                end
                            ]
                        ) as $marcados |
                        ([
                            $marcados | to_entries[ ] |
                            select(
                                (((.value.messages[0].content // "") | startswith("<<")) | not) and
                                (
                                    .value._loro == 1 or
                                    (
                                        .value._sim >= $umb and .value._sim < $uref and
                                        (
                                            if (.value._sa != null and .value._su != null) then
                                                ((.value._sa >= $u_med and (.value._sa - .value._su) >= $d_min) or (.value._su >= $u_med and (.value._su - .value._sa) >= ($d_min * 2)))
                                            else
                                                (.value._sim >= $u_med)
                                            end
                                        )
                                    )
                                )
                            )
                        ] | sort_by(-.value._sim) | .[0].key // -1) as $k_ltd |
                        if ($k_ltd >= 0 and $marcados[$k_ltd]._ne > $nobj) then
                            [
                                $marcados | to_entries[ ] |
                                if .key == $k_ltd then
                                    (.value.embedding[:1024]) as $v |
                                    (.value._ne) as $ne |
                                    (.value | del(._sim, ._su, ._sa, ._loro, ._ne)) + {embedding: ($v | map(((. / $ne) * $nobj * 10000 | round) / 10000))}
                                else
                                    (.value | del(._sim, ._su, ._sa, ._loro, ._ne))
                                end
                            ][ ]
                        else
                            empty
                        end
                    end
                ' < <(cat "$DIR_MEMORIA/$PART_PER_LTD"; echo "$LINEA_TURNO"))
                if [[ -n "$PER_LTD_ACT" ]]; then
                    echo "$PER_LTD_ACT" > "$DIR_MEMORIA/${PART_PER_LTD}.$$.tmp"
                    mv -f "$DIR_MEMORIA/${PART_PER_LTD}.$$.tmp" "$DIR_MEMORIA/$PART_PER_LTD"
                fi
            fi
        fi
    fi

    # 4. Capa procedimental (trazas reales completas de herramientas: usar + leer, solo para entrenamiento en sueno)
    if [[ -n "$ARCH_TRAZA_CONSOLIDAR" ]]; then
        if [[ -s "$ARCH_TRAZA_CONSOLIDAR" ]]; then
            if [[ ! -f "$INDICE_PROCEDIMENTAL" ]]; then > "$INDICE_PROCEDIMENTAL"; fi
            LINEA_PROC=$(jq -a -c -s --arg f "$FECHA_HORA" '
                def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                (.[0]) as $resp |
                (.[1]) as $msgs |
                if ($msgs | type) == "array" and ($msgs | length) >= 4 then
                    {
                        fecha: $f,
                        tipo: "procedimental",
                        messages: $msgs,
                        embedding: (
                            if ($resp.data and ($resp.data | length) > 0) then
                                ($resp.data[0].embedding) as $v |
                                (norm($v)) as $n |
                                ($v | map(((. / $n) * 10000 | round) / 10000))
                            else
                                null
                            end
                        ),
                        emb_u: (if ($resp.data and ($resp.data | length) > 1) then ($resp.data[1].embedding | map((. * 10000 | round) / 10000)) else null end),
                        emb_a: (if ($resp.data and ($resp.data | length) > 2) then ($resp.data[2].embedding | map((. * 10000 | round) / 10000)) else null end)
                    }
                else
                    empty
                end
            ' < <(printf '%s\n' "$RESP_MEM"; cat "$ARCH_TRAZA_CONSOLIDAR") 2>/dev/null)

            if [[ -n "$LINEA_PROC" ]]; then
                PART_PROC=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    (.[0:-1]) as $idx |
                    (.[-1]) as $nuevo |
                    if $nuevo.embedding != null then
                        (norm($nuevo.embedding)) as $nq |
                        [
                            $idx[ ] |
                            select((.lineas // 0) < $maxp and .embedding != null and ((.embedding | length) == ($nuevo.embedding | length))) |
                            (norm(.embedding)) as $ne |
                            . + {_sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq))} |
                            select(._sim >= $umb)
                        ] | sort_by(-._sim) | .[0].archivo // empty
                    else
                        ($idx | map(select(.ultimo == 1 and (.lineas // 0) < $maxp)) | .[0].archivo // empty)
                    end
                ' < <(cat "$INDICE_PROCEDIMENTAL"; printf '%s\n' "$LINEA_PROC") 2>/dev/null)

                if [[ -n "$PART_PROC" ]]; then
                    if [[ -s "$DIR_MEMORIA/$PART_PROC" ]]; then
                        PROC_ACT=$(jq -a -c -s --argjson uref "$UMBRAL_REFUERZO" '
                            def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                            def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                            (.[0:-1]) as $items |
                            (.[-1]) as $nuevo |
                            if $nuevo.emb_u == null then
                                ($items + [$nuevo])[ ]
                            else
                                (norm($nuevo.emb_u)) as $nu |
                                (
                                    [
                                        $items[ ] |
                                        select(
                                            type != "object" or
                                            .emb_u == null or
                                            ((.emb_u | length) != ($nuevo.emb_u | length)) or
                                            ((dot(.emb_u; $nuevo.emb_u) / (norm(.emb_u) * $nu)) < $uref)
                                        )
                                    ] + [$nuevo]
                                )[ ]
                            end
                        ' < <(cat "$DIR_MEMORIA/$PART_PROC"; printf '%s\n' "$LINEA_PROC") 2>/dev/null)
                        if [[ -n "$PROC_ACT" ]]; then
                            printf '%s\n' "$PROC_ACT" > "$DIR_MEMORIA/${PART_PROC}.$$.tmp"
                            mv -f "$DIR_MEMORIA/${PART_PROC}.$$.tmp" "$DIR_MEMORIA/$PART_PROC"
                        fi
                    else
                        printf '%s\n' "$LINEA_PROC" > "$DIR_MEMORIA/$PART_PROC"
                    fi
                else
                    N_PR=1
                    while [[ -f "$DIR_MEMORIA/${PREFIJO_PROCEDIMENTAL}_${N_PR}.json" ]]; do
                        N_PR=$((N_PR + 1))
                    done
                    PART_PROC="${PREFIJO_PROCEDIMENTAL}_${N_PR}.json"
                    printf '%s\n' "$LINEA_PROC" > "$DIR_MEMORIA/$PART_PROC"
                fi

                LIN_PROC=$(( $(wc -l < "$DIR_MEMORIA/$PART_PROC") ))
                IND_PROC_NUEVO=$(jq -a -c -s --arg arch "$PART_PROC" --argjson lreal "$LIN_PROC" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    (.[0:-1]) as $idx |
                    (.[-1]) as $nuevo |
                    ($nuevo.embedding) as $v_unit |
                    if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
                        [
                            $idx[ ] |
                            if .archivo == $arch then
                                (.lineas // 1) as $n |
                                . + {
                                    lineas: $lreal,
                                    ultimo: 1,
                                    embedding: (
                                        if ($v_unit != null and .embedding != null and ((.embedding | length) == ($v_unit | length))) then
                                            (.embedding) as $old |
                                            ($old | length) as $dim |
                                            (reduce range(0; $dim) as $i ([ ]; . + [((($old[$i] // 0) * $n) + ($v_unit[$i] // 0)) / ($n + 1)])) as $raw_c |
                                            (norm($raw_c)) as $nc |
                                            ($raw_c | map(((. / $nc) * 10000 | round) / 10000))
                                        else
                                            (.embedding // $v_unit)
                                        end
                                    )
                                }
                            else
                                . + {ultimo: 0}
                            end
                        ][ ]
                    else
                        (
                            [ $idx[ ] | . + {ultimo: 0} ] +
                            [{
                                archivo: $arch,
                                lineas: $lreal,
                                ultimo: 1,
                                embedding: $v_unit
                            }]
                        )[ ]
                    end
                ' < <(cat "$INDICE_PROCEDIMENTAL"; printf '%s\n' "$LINEA_PROC") 2>/dev/null)
                if [[ -n "$IND_PROC_NUEVO" ]]; then
                    printf '%s\n' "$IND_PROC_NUEVO" > "${INDICE_PROCEDIMENTAL}.$$.tmp"
                    mv -f "${INDICE_PROCEDIMENTAL}.$$.tmp" "$INDICE_PROCEDIMENTAL"
                fi
            fi
        fi
    fi
fi
