#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)/CONFIG"

# FECHA Y HORA
FECHA_HORA=$(date "+%Y-%m-%d %H:%M:%S")
TS_TURNO=$(date +%s)
HUBO_DESPERTAR=0

# Argumentos recibidos:
MODO_CONSOLIDAR=0
ARCH_TURNO_CONSOLIDAR=""
ARCH_TRAZA_CONSOLIDAR=""
MODO_INTERNO=0
if [[ "$1" == "--consolidar" ]]; then
    MODO_CONSOLIDAR=1
    ARCH_TURNO_CONSOLIDAR="$2"
    ARCH_TRAZA_CONSOLIDAR="$3"
elif [[ "$1" == "--interno" ]]; then
    MODO_INTERNO=1
    shift
fi
export MODO_INTERNO

if [[ $MODO_CONSOLIDAR -eq 1 ]]; then
    if [[ ! -s "$ARCH_TURNO_CONSOLIDAR" ]]; then
        rm -f "$ARCH_TRAZA_CONSOLIDAR" 2>/dev/null
        exit 0
    fi
    mkdir -p "$DIR_REGISTROS"
    ESPERA_C=0
    while [[ $ESPERA_C -lt 100 ]]; do
        if [[ ! -s "$LOCK_MEMORIA" ]]; then break; fi
        LPID_C=$(cat "$LOCK_MEMORIA" 2>/dev/null)
        if [[ -z "$LPID_C" ]]; then break; fi
        if ! kill -0 "$LPID_C" 2>/dev/null; then
            rm -f "$LOCK_MEMORIA" 2>/dev/null
            break
        fi
        sleep 0.1
        ESPERA_C=$((ESPERA_C + 1))
    done
    echo "$$" > "$LOCK_MEMORIA"
    trap 'rm -f "$LOCK_MEMORIA" "$ARCH_TURNO_CONSOLIDAR" "$ARCH_TRAZA_CONSOLIDAR"' EXIT
    {
        IFS= read -r FECHA_HORA
        IFS= read -r ENTRADA_UNA_LINEA
        IFS= read -r RESPUESTA_UNA_LINEA
        IFS= read -r TS_TURNO
        IFS= read -r HUBO_DESPERTAR
        IFS= read -r VAL_TURNO
    } < "$ARCH_TURNO_CONSOLIDAR"
    if [[ -z "$TS_TURNO" ]]; then TS_TURNO=$(date +%s); fi
    if [[ -z "$HUBO_DESPERTAR" ]]; then HUBO_DESPERTAR=0; fi
    if [[ -z "$VAL_TURNO" ]]; then VAL_TURNO=0; fi
else
    # Cargar entrada
    ENTRADA="$*"

    # Si no hay entrada, salir
    if [[ -z "$ENTRADA" ]]; then exit 0; fi

    # Despertar automatico y reinicio del contador de vigilia (solo en interacciones normales)
    if [[ $MODO_INTERNO -eq 0 ]]; then
        mkdir -p "$DIR_REGISTROS"
        date +%s > "$ULTIMA_INTERACCION"
        ACABA_DE_DESPERTAR=0

        # Si el agente esta durmiendo (entrenamiento/REM), avisar despertar y esperar pausa limpia con checkpoint
        if [[ -s "$PID_DORMIR" ]]; then
            DPID=$(cat "$PID_DORMIR" 2>/dev/null)
            DORMIR_ACTIVO=0
            if [[ -n "$DPID" ]]; then
                if kill -0 "$DPID" 2>/dev/null; then
                    DORMIR_ACTIVO=1
                    echo "..."
                    date +%s > "$SENAL_DESPERTAR"
                    ESPERA_D=0
                    while [[ $ESPERA_D -lt 250 ]]; do
                        if ! kill -0 "$DPID" 2>/dev/null; then
                            DORMIR_ACTIVO=0
                            break
                        fi
                        if [[ $ESPERA_D -eq 200 ]]; then
                            kill -TERM "$DPID" 2>/dev/null
                        fi
                        sleep 0.2
                        ESPERA_D=$((ESPERA_D + 1))
                    done
                fi
            fi
            if [[ $DORMIR_ACTIVO -eq 0 ]]; then
                rm -f "$PID_DORMIR" "$SENAL_DESPERTAR" 2>/dev/null
            fi
        elif [[ -f "$SENAL_DESPERTAR" ]]; then
            rm -f "$SENAL_DESPERTAR" 2>/dev/null
        fi

        if ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
            ACABA_DE_DESPERTAR=1
            echo "..."
            NGL_AUTO=""
            HILOS_AUTO=""
            if [[ -x "$DIR/DESPERTAR/EQUILIBRIO" ]]; then
                IFS=$'\t' read -r NGL_AUTO HILOS_AUTO _MEQ _VEQ _PEQ _CEQ < <("$DIR/DESPERTAR/EQUILIBRIO" "$MODELO" "4096" "LENGUAJE" 2>/dev/null)
            fi
            true < <(setsid "$DIR/DESPERTAR/LENGUAJE" "$NGL_AUTO" "$HILOS_AUTO" </dev/null >/dev/null 2>/dev/null)
            INTENTO=0
            while [[ $INTENTO -lt 120 ]]; do
                sleep 0.5
                if curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then break; fi
                INTENTO=$((INTENTO + 1))
            done
        fi

        if ! curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then
            echo "..."
            NGL_AUTO=""
            HILOS_AUTO=""
            if [[ -x "$DIR/DESPERTAR/EQUILIBRIO" ]]; then
                IFS=$'\t' read -r NGL_AUTO HILOS_AUTO _MEQ _VEQ _PEQ _CEQ < <("$DIR/DESPERTAR/EQUILIBRIO" "$MODELO_MEMORIA" "512" "MEMORIA" 2>/dev/null)
            fi
            true < <(setsid "$DIR/DESPERTAR/MEMORIA" "$NGL_AUTO" "$HILOS_AUTO" </dev/null >/dev/null 2>/dev/null)
            INTENTO=0
            while [[ $INTENTO -lt 120 ]]; do
                sleep 0.5
                if curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then break; fi
                INTENTO=$((INTENTO + 1))
            done
        fi

        if [[ -s "$MODELO_AMIGDALA" ]]; then
            if [[ -x "$DIR/DESPERTAR/AMIGDALA" ]]; then
                if ! curl -sf "http://${HOST}:${PUERTO_AMIGDALA}/health" >/dev/null 2>/dev/null; then
                    NGL_AUTO=""
                    HILOS_AUTO=""
                    if [[ -x "$DIR/DESPERTAR/EQUILIBRIO" ]]; then
                        IFS=$'\t' read -r NGL_AUTO HILOS_AUTO _MEQ _VEQ _PEQ _CEQ < <("$DIR/DESPERTAR/EQUILIBRIO" "$MODELO_AMIGDALA" "1024" "AMIGDALA" 2>/dev/null)
                    fi
                    true < <(setsid "$DIR/DESPERTAR/AMIGDALA" "$NGL_AUTO" "$HILOS_AUTO" </dev/null >/dev/null 2>/dev/null)
                    INTENTO=0
                    while [[ $INTENTO -lt 40 ]]; do
                        sleep 0.25
                        if curl -sf "http://${HOST}:${PUERTO_AMIGDALA}/health" >/dev/null 2>/dev/null; then break; fi
                        INTENTO=$((INTENTO + 1))
                    done
                fi
            fi
        fi

        ABURRIMIENTO_VIVO=0
        if [[ -s "$PID_ABURRIMIENTO" ]]; then
            APID=$(cat "$PID_ABURRIMIENTO" 2>/dev/null)
            if [[ -n "$APID" ]]; then
                if kill -0 "$APID" 2>/dev/null; then
                    ABURRIMIENTO_VIVO=1
                fi
            fi
        fi
        if [[ $ABURRIMIENTO_VIVO -eq 0 ]]; then
            true < <(setsid "$DIR/DESPERTAR/ABURRIMIENTO" </dev/null >/dev/null 2>/dev/null)
        fi

        if [[ ! -e "$PARADA_OLVIDO" ]]; then
            OLVIDO_VIVO=0
            if [[ -s "$PID_OLVIDO" ]]; then
                OPID=$(cat "$PID_OLVIDO" 2>/dev/null)
                if [[ -n "$OPID" ]]; then
                    if kill -0 "$OPID" 2>/dev/null; then
                        OLVIDO_VIVO=1
                    fi
                fi
            fi
            if [[ $OLVIDO_VIVO -eq 0 ]]; then
                true < <(setsid "$DIR/DESPERTAR/OLVIDO" --daemon </dev/null >/dev/null 2>/dev/null)
            fi
        fi

        if [[ $ACABA_DE_DESPERTAR -eq 1 ]]; then
            ENTRADA="[$FECHA_HORA] $ESTIMULO_DESPERTAR $ENTRADA"
        fi
    else
        if ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
            exit 0
        fi
    fi

    ARCH_TRAZA_TOOL=""
    if [[ $MODO_INTERNO -eq 0 ]]; then
        ARCH_TRAZA_TOOL="$DIR_REGISTROS/.traza_tool.$$.json"
        rm -f "$ARCH_TRAZA_TOOL" 2>/dev/null
        export ARCH_TRAZA_TOOL
    fi

    RESPUESTA=$("$DIR/AGENTE" "$ENTRADA")
    if [[ $MODO_INTERNO -eq 0 ]]; then
        date +%s > "$ULTIMA_INTERACCION"
        echo "$RESPUESTA"
    fi

    ENTRADA_UNA_LINEA="${ENTRADA//$'\r'/ }";     ENTRADA_UNA_LINEA="${ENTRADA_UNA_LINEA//$'\n'/ }"
    RESPUESTA_UNA_LINEA="${RESPUESTA//$'\r'/ }"; RESPUESTA_UNA_LINEA="${RESPUESTA_UNA_LINEA//$'\n'/ }"

    LINEA_LOG="Peticion: $SEP_USUARIO $ENTRADA_UNA_LINEA | Respuesta: $SEP_IA $RESPUESTA_UNA_LINEA"
    echo "$LINEA_LOG" >> "$HISTORIAL"

    if [[ $MODO_INTERNO -eq 0 ]]; then
        if [[ -n "$RESPUESTA_UNA_LINEA" ]]; then
            VAL_TURNO="0"
            if [[ -s "$AMIGDALA" ]]; then
                VAL_AM=$(jq -r '.ultima_valencia // 0' "$AMIGDALA" 2>/dev/null)
                if [[ -n "$VAL_AM" ]]; then VAL_TURNO="$VAL_AM"; fi
            fi
            ARCH_TURNO_TMP="$DIR_REGISTROS/.turno.$$.tmp"
            printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$FECHA_HORA" "$ENTRADA_UNA_LINEA" "$RESPUESTA_UNA_LINEA" "$TS_TURNO" "${ACABA_DE_DESPERTAR:-0}" "$VAL_TURNO" > "$ARCH_TURNO_TMP"
            true < <(setsid "$DIR/ENTRADA" --consolidar "$ARCH_TURNO_TMP" "$ARCH_TRAZA_TOOL" </dev/null >/dev/null 2>/dev/null)
        else
            rm -f "$ARCH_TRAZA_TOOL" 2>/dev/null
        fi
        exit 0
    elif [[ -n "$RESPUESTA_UNA_LINEA" ]]; then
        mkdir -p "$DIR_REGISTROS"
        ESPERA_I=0
        while [[ $ESPERA_I -lt 100 ]]; do
            if [[ ! -s "$LOCK_MEMORIA" ]]; then break; fi
            LPID_I=$(cat "$LOCK_MEMORIA" 2>/dev/null)
            if [[ -z "$LPID_I" ]]; then break; fi
            if ! kill -0 "$LPID_I" 2>/dev/null; then
                rm -f "$LOCK_MEMORIA" 2>/dev/null
                break
            fi
            sleep 0.1
            ESPERA_I=$((ESPERA_I + 1))
        done
        echo "$$" > "$LOCK_MEMORIA"
        trap 'if [[ -s "$LOCK_MEMORIA" ]]; then if [[ "$(cat "$LOCK_MEMORIA" 2>/dev/null)" == "$$" ]]; then rm -f "$LOCK_MEMORIA" 2>/dev/null; fi; fi' EXIT
    fi
fi

# Funcion compartida: enruta un turno a su particion, reconsolida/refuerza (LTP) o atenua por divergencia (LTD) y actualiza el indice
guardar_en_capa() {
    CAPA_INDICE="$1"
    CAPA_PREFIJO="$2"
    CAPA_TURNO="$3"
    CAPA_NORM_OBJ="$4"

    if [[ ! -f "$CAPA_INDICE" ]]; then > "$CAPA_INDICE"; fi

    PARTICION_GANADORA=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        if $nuevo.embedding != null then
            (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
            (
                [
                    $idx[ ] |
                    select(.lineas < $maxp and .embedding != null) |
                    ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                    . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                    select(.sim >= $umb)
                ] | sort_by(-.sim) | .[0].archivo // empty
            )
        else
            ($idx | map(select(.ultimo == 1 and .lineas < $maxp)) | .[0].archivo // empty)
        end
    ' < <(cat "$CAPA_INDICE"; echo "$CAPA_TURNO"))

    if [[ -n "$PARTICION_GANADORA" ]]; then
        if [[ -s "$DIR_MEMORIA/$PARTICION_GANADORA" ]]; then
            PART_ACTUALIZADA=$(jq -a -c -s --argjson umb "$UMBRAL_SIM" --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" --argjson nobj "$CAPA_NORM_OBJ" '
                def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                def cos($a; $b):
                    if ($a != null and $b != null) then
                        (dot($a; $b) / (norm($a) * norm($b)))
                    else
                        null
                    end;
                (.[0:-1]) as $items |
                (.[-1]) as $nuevo |
                if $nuevo.embedding == null then
                    ($items + [$nuevo])[ ]
                else
                    (norm($nuevo.embedding)) as $nq |
                    ($nuevo.embedding[:1024] | map(. / $nq)) as $u_nuevo |
                    (($umb + $uref) / 2) as $u_med |
                    (($uref + 1.0) / 2) as $u_loro |
                    (($fref - 1.0) / 2) as $d_min |
                    (cos($nuevo.emb_u; $nuevo.emb_a)) as $nua |
                    (
                        [
                            $items[ ] |
                            if (type == "object" and .embedding != null) then
                                (norm(.embedding)) as $ne |
                                (cos(.emb_u; $nuevo.emb_u)) as $su |
                                (cos(.emb_a; $nuevo.emb_a)) as $sa |
                                (cos(.emb_u; $nuevo.emb_a)) as $sua |
                                . + {
                                    _sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq)),
                                    _su: $su,
                                    _sa: $sa,
                                    _sua: $sua,
                                    _loro: (if ($sa != null and $su != null and $sa >= $u_loro and $su < $u_med) then 1 else 0 end),
                                    _ne: $ne
                                }
                            else
                                . + {_sim: 0, _su: null, _sa: null, _sua: null, _loro: 0, _ne: 0}
                            end
                        ]
                    ) as $marcados |
                    ([ $marcados[ ] | select(._sim >= $uref and ._loro == 0) ]) as $coincidentes |
                    if ($coincidentes | length) > 0 then
                        ($coincidentes | sort_by(-._sim) | .[0]) as $gan |
                        ($gan._ne) as $n_base |
                        (
                            if (($nuevo.herramienta // 0) == 1 or ($gan.herramienta // 0) == 1 or ((($nuevo.messages[1].content // "") | startswith("["))) or ((($gan.messages[1].content // "") | startswith("[")))) then
                                1
                            else
                                0
                            end
                        ) as $es_herr |
                        (
                            if $es_herr == 1 then
                                $nq
                            else
                                (if ($n_base * $fref) > $nq then ($n_base * $fref) else $nq end) as $n_bruto |
                                (if $n_bruto > 1.0 then 1.0 else $n_bruto end)
                            end
                        ) as $n_ref |
                        ($u_nuevo | map((. * $n_ref * 10000 | round) / 10000)) as $emb_final |
                        (
                            [ $marcados[ ] | select(._sim < $uref or ._loro == 1) | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne) ] +
                            [($nuevo + {herramienta: $es_herr, embedding: $emb_final, sensor: (if ($nuevo.sensor != null and ($nuevo.sensor | length) > 0) then $nuevo.sensor else ($gan.sensor // null) end)})]
                        )[ ]
                    else
                        ([
                            $marcados | to_entries[ ] |
                            select(
                                (((.value.messages[0].content // "") | startswith("<<")) | not) and
                                .value._sim >= $umb and .value._sim < $uref and
                                (.value._su == null or .value._sua == null or .value._sa == null or .value._su >= .value._sua or .value._sa < $uref) and
                                (
                                    if (.value._sa != null and .value._su != null) then
                                        ((.value._sa >= $u_med and (.value._sa - .value._su) >= $d_min) or (.value._su >= $u_med and (.value._su - .value._sa) >= ($d_min * 2)))
                                    else
                                        (.value._sim >= $u_med)
                                    end
                                )
                            )
                        ] | sort_by(-.value._sim) | .[0].key // -1) as $k_ltd |
                        ([ $marcados[ ] | select(._loro == 1) ] | length) as $hay_loro |
                        (
                            if $hay_loro > 0 then
                                ($nuevo + {embedding: ($u_nuevo | map((. * $nobj * 10000 | round) / 10000))})
                            else
                                $nuevo
                            end
                        ) as $nuevo_fin |
                        (
                            [
                                $marcados | to_entries[ ] |
                                if ($k_ltd >= 0 and .key == $k_ltd and .value._ne > $nobj) then
                                    (.value.embedding[:1024]) as $v |
                                    (.value._ne) as $ne |
                                    (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne)) + {embedding: ($v | map(((. / $ne) * $nobj * 10000 | round) / 10000))}
                                else
                                    (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne))
                                end
                            ] + [$nuevo_fin]
                        )[ ]
                    end
                end
            ' < <(cat "$DIR_MEMORIA/$PARTICION_GANADORA"; echo "$CAPA_TURNO"))
            if [[ -n "$PART_ACTUALIZADA" ]]; then
                echo "$PART_ACTUALIZADA" > "$DIR_MEMORIA/${PARTICION_GANADORA}.$$.tmp"
                mv -f "$DIR_MEMORIA/${PARTICION_GANADORA}.$$.tmp" "$DIR_MEMORIA/$PARTICION_GANADORA"
            fi
        else
            echo "$CAPA_TURNO" > "$DIR_MEMORIA/$PARTICION_GANADORA"
        fi
    else
        N_NUEVO=1
        while [[ -f "$DIR_MEMORIA/${CAPA_PREFIJO}_${N_NUEVO}.json" ]]; do
            N_NUEVO=$((N_NUEVO + 1))
        done
        PARTICION_GANADORA="${CAPA_PREFIJO}_${N_NUEVO}.json"
        echo "$CAPA_TURNO" > "$DIR_MEMORIA/$PARTICION_GANADORA"
    fi

    LINEAS_REAL=$(jq -r -s 'length' "$DIR_MEMORIA/$PARTICION_GANADORA")
    INDICE_NUEVO=$(jq -a -c -s --arg arch "$PARTICION_GANADORA" --argjson lreal "$LINEAS_REAL" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        (
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ($nuevo.embedding | map((. / $nq * 10000 | round) / 10000))
            else
                null
            end
        ) as $v_unit |
        if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
            [
                $idx[ ] |
                if .archivo == $arch then
                    .lineas as $n |
                    . + {
                        lineas: $lreal,
                        ultimo: 1,
                        embedding: (
                            if ($v_unit != null and .embedding != null) then
                                ([.embedding[:1024], $v_unit[:1024]] | transpose | map((((.[0] // 0) * $n) + (.[1] // 0)) / ($n + 1))) as $raw_c |
                                (($raw_c | map(. * .) | add | sqrt) + 0.000001) as $nc |
                                ($raw_c | map((. / $nc * 10000 | round) / 10000))
                            else
                                (.embedding // $v_unit)
                            end
                        )
                    }
                else
                    . + {ultimo: 0}
                end
            ][ ]
        else
            (
                [ $idx[ ] | . + {ultimo: 0} ] +
                [{
                    archivo: $arch,
                    lineas: $lreal,
                    ultimo: 1,
                    embedding: $v_unit
                }]
            )[ ]
        end
    ' < <(cat "$CAPA_INDICE"; echo "$CAPA_TURNO"))

    if [[ -n "$INDICE_NUEVO" ]]; then
        echo "$INDICE_NUEVO" > "${CAPA_INDICE}.$$.tmp"
        mv -f "${CAPA_INDICE}.$$.tmp" "$CAPA_INDICE"
    fi

    ULTIMA_PARTICION="$PARTICION_GANADORA"
}

# Memoria Reloj (ciclo biologico separado del hipocampo: despertar, silencio, dormir y sueno)
registrar_en_reloj() {
    EV_R="$1"
    F_R="$2"
    TS_R="$3"
    U_R="$4"
    A_R="$5"
    TXT_EMB_R="$6"

    if [[ ! -f "$RELOJ" ]]; then > "$RELOJ"; fi
    PAY_R=$(jq -a -n --arg t "$TXT_EMB_R" '{input: $t}')
    RESP_R=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_R" 2>/dev/null)
    if [[ -z "$RESP_R" ]]; then RESP_R="{}"; fi

    LIN_R=$(jq -a -c --arg ev "$EV_R" --arg f "$F_R" --argjson ts "$TS_R" --arg u "$U_R" --arg a "$A_R" '{
        fecha: $f,
        ts: $ts,
        evento: $ev,
        messages: [
            {"role": "user", "content": $u},
            {"role": "assistant", "content": $a}
        ],
        embedding: (if (.data and (.data | length) > 0) then (.data[0].embedding | map((. * 10000 | round) / 10000)) else null end)
    }' < <(printf '%s' "$RESP_R") 2>/dev/null)

    if [[ -n "$LIN_R" ]]; then
        RELOJ_ACT=$(jq -a -c -s --argjson maxp "$MAX_PARTICION" '.[-$maxp:][ ]' < <(cat "$RELOJ"; printf '%s\n' "$LIN_R") 2>/dev/null)
        if [[ -n "$RELOJ_ACT" ]]; then
            printf '%s\n' "$RELOJ_ACT" > "${RELOJ}.$$.tmp"
            mv -f "${RELOJ}.$$.tmp" "$RELOJ" 2>/dev/null
        fi
    fi
}

# Hipocampo (momento presente) y Memoria a largo plazo (consolidacion y refuerzo)
if [[ -n "$RESPUESTA_UNA_LINEA" ]]; then
    if [[ $MODO_INTERNO -eq 1 ]]; then
        EV_INT="interno"
        if [[ "$ENTRADA_UNA_LINEA" == "$ESTIMULO_SILENCIO" ]]; then EV_INT="silencio"; fi
        if [[ "$ENTRADA_UNA_LINEA" == "$ESTIMULO_DORMIR" ]]; then EV_INT="dormir"; fi
        TXT_INT_R="reloj ciclo $EV_INT cuando dormiste silencio vigilia $ENTRADA_UNA_LINEA $RESPUESTA_UNA_LINEA"
        registrar_en_reloj "$EV_INT" "$FECHA_HORA" "$TS_TURNO" "$ENTRADA_UNA_LINEA" "$RESPUESTA_UNA_LINEA" "$TXT_INT_R"
        exit 0
    fi

    if [[ ! -f "$INDICE_EPISODICA" ]]; then > "$INDICE_EPISODICA"; fi
    if [[ ! -f "$INDICE_PERSISTENTE" ]]; then > "$INDICE_PERSISTENTE"; fi
    if [[ ! -f "$HIPOCAMPO" ]]; then > "$HIPOCAMPO"; fi

    if [[ "${HUBO_DESPERTAR:-0}" -eq 1 ]]; then
        registrar_en_reloj "despertar" "$FECHA_HORA" "$TS_TURNO" "$ESTIMULO_DESPERTAR" "Me desperte el $FECHA_HORA." "reloj ciclo despertar cuando te despertaste ultimo despertar vigilia $FECHA_HORA"
        ENTRADA_LIMPIA="$ENTRADA_UNA_LINEA"
        if [[ "$ENTRADA_LIMPIA" == "["*"] <<"*">> "* ]]; then
            ENTRADA_LIMPIA="${ENTRADA_LIMPIA#*>> }"
        fi
        if [[ -n "$ENTRADA_LIMPIA" ]]; then
            ENTRADA_UNA_LINEA="$ENTRADA_LIMPIA"
        fi
    fi

    # Amigdala Fase 2 (en segundo plano, 0 ms en chat): detectar tono, sarcasmo y valencia emocional del usuario
    VAL_EMO="0"
    MATIZ_EMO="neutro"
    if [[ -x "$DIR/AMIGDALA" ]]; then
        if [[ ${#ENTRADA_UNA_LINEA} -ge 5 ]]; then
            PREV_ASIST=""
            if [[ -s "$HIPOCAMPO" ]]; then
                PREV_ASIST=$(jq -r -s '
                    [ .[ ] | select(type == "object" and (((.messages[0].content // "") | startswith("<<")) | not)) ][-1].messages[1].content // ""
                ' "$HIPOCAMPO" 2>/dev/null)
            fi
            IFS=$'\t' read -r VAL_EMO MATIZ_EMO < <("$DIR/AMIGDALA" --tono "$ENTRADA_UNA_LINEA" "$PREV_ASIST" 2>/dev/null)
            if [[ -z "$VAL_EMO" ]]; then VAL_EMO="0"; fi
            if [[ -z "$MATIZ_EMO" ]]; then MATIZ_EMO="neutro"; fi

            if [[ "$VAL_EMO" -lt 0 ]]; then
                VAL_TURNO="-1"
                # Feedback retroactivo: si el turno previo en Hipocampo es reciente (<600s), marcarlo negativo y rebajar su peso
                if [[ -s "$HIPOCAMPO" ]]; then
                    HIPO_CAST=$(jq -a -c -s --argjson ahora "$TS_TURNO" '
                        def norm($v): ((reduce $v[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                        if length > 0 then
                            (length - 1) as $ult |
                            to_entries |
                            map(
                                if (.key == $ult and (.value.ts != null) and (($ahora - .value.ts) <= 600) and ((.value.valencia // 0) >= 0)) then
                                    .value + {
                                        valencia: -1,
                                        embedding: (if .value.embedding != null then (.value.embedding[:1024] | map(((. * 0.65) * 10000 | round) / 10000)) else null end)
                                    }
                                else
                                    .value
                                end
                            )[ ]
                        else
                            empty
                        end
                    ' "$HIPOCAMPO" 2>/dev/null)
                    if [[ -n "$HIPO_CAST" ]]; then
                        printf '%s\n' "$HIPO_CAST" > "${HIPOCAMPO}.$$.tmp"
                        mv -f "${HIPOCAMPO}.$$.tmp" "$HIPOCAMPO" 2>/dev/null
                    fi
                fi
            elif [[ "$VAL_EMO" -gt 0 ]]; then
                if [[ "${VAL_TURNO:-0}" -eq 0 ]]; then
                    VAL_TURNO="1"
                fi
            fi

            # Registrar estado emocional en MEMORIA/amigdala.json
            AMIG_C="{}"
            if [[ -s "$AMIGDALA" ]]; then
                AMIG_C=$(cat "$AMIGDALA" 2>/dev/null)
                if [[ -z "$AMIG_C" ]]; then AMIG_C="{}"; fi
            fi
            AMIG_C_NUEVA=$(jq -a -c \
                --arg mat "$MATIZ_EMO" \
                --argjson vemo "$VAL_EMO" \
                --argjson maxf "${MAX_FRUSTRACION:-3}" '
                (
                    if $vemo < 0 then
                        (((.frustracion // 0) + 1) | if . > $maxf then $maxf else . end)
                    elif $vemo > 0 then
                        0
                    else
                        (.frustracion // 0)
                    end
                ) as $fr |
                (if $vemo != 0 then $vemo else (.ultima_valencia // 0) end) as $uval |
                . + {
                    tono_usuario: $mat,
                    valencia_emocional: $vemo,
                    frustracion: $fr,
                    ultima_valencia: $uval
                }
            ' < <(printf '%s' "$AMIG_C") 2>/dev/null)
            if [[ -n "$AMIG_C_NUEVA" ]]; then
                mkdir -p "$DIR_MEMORIA"
                printf '%s\n' "$AMIG_C_NUEVA" > "${AMIGDALA}.$$.tmp"
                mv -f "${AMIGDALA}.$$.tmp" "$AMIGDALA" 2>/dev/null
            fi
        fi
    fi

    TEXTO_RESP_VEC="${RESPUESTA_UNA_LINEA:0:120}"
    TEXTO_VEC="$ENTRADA_UNA_LINEA $TEXTO_RESP_VEC"

    PAYLOAD_MEM=$(jq -a -n --arg t "$TEXTO_VEC" --arg u "$ENTRADA_UNA_LINEA" --arg a "$TEXTO_RESP_VEC" '{input: [$t, $u, $a]}')
    RESP_MEM=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAYLOAD_MEM")
    if [[ -z "$RESP_MEM" ]]; then RESP_MEM="{}"; fi

    LINEA_TURNO=$(jq -a -c --arg f "$FECHA_HORA" --argjson ts "$TS_TURNO" --arg u "$ENTRADA_UNA_LINEA" --arg a "$RESPUESTA_UNA_LINEA" --argjson peso "$PESO_INICIAL" --argjson val "${VAL_TURNO:-0}" '
        (if $val < 0 then ($peso * 0.65) else $peso end) as $p_ef |
        {
            fecha: $f,
            ts: $ts,
            valencia: $val,
            herramienta: (if ($a | startswith("[")) then 1 else 0 end),
            messages: [
                {"role": "user", "content": $u},
                {"role": "assistant", "content": $a}
            ],
            embedding: (if (.data and (.data | length) > 0) then (.data[0].embedding | map(((. * $p_ef) * 10000 | round) / 10000)) else null end),
            emb_u: (if (.data and (.data | length) > 1) then (.data[1].embedding | map((. * 10000 | round) / 10000)) else null end),
            emb_a: (if (.data and (.data | length) > 2) then (.data[2].embedding | map((. * 10000 | round) / 10000)) else null end)
        }
    ' < <(echo "$RESP_MEM"))

    # Hipocampo sensorial: adjuntar salida real compactada de herramienta SOLO al registro del hipocampo (nunca sube a persistente)
    LINEA_HIPO="$LINEA_TURNO"
    if [[ -n "$ARCH_TRAZA_CONSOLIDAR" ]]; then
        if [[ -s "$ARCH_TRAZA_CONSOLIDAR" ]]; then
            SENSOR_TXT=$(jq -r '
                [
                    .[ ] |
                    select(.role == "tool" and ((.content // "") | length) > 0) |
                    ((.content // "") | gsub("[\r\n]+"; " | ") | .[0:700])
                ] | join(" ; ") | .[0:800]
            ' "$ARCH_TRAZA_CONSOLIDAR" 2>/dev/null)
            if [[ -n "$SENSOR_TXT" ]]; then
                LINEA_HIPO=$(jq -a -c --arg sens "$SENSOR_TXT" '. + {sensor: $sens}' < <(printf '%s' "$LINEA_TURNO") 2>/dev/null)
                if [[ -z "$LINEA_HIPO" ]]; then LINEA_HIPO="$LINEA_TURNO"; fi
            fi
        fi
    fi

    H_HIP=$(( ${DECAIMIENTO_HIPOCAMPO} ))
    H_MEM=$(( ${DECAIMIENTO_MEMORIA} ))
    H_PER=$(( ${DECAIMIENTO_PERSISTENTE} ))
    H_CAS=$(( ${DECAIMIENTO_CASTIGO} ))

    read -r NORM_OBJ_HIP NORM_OBJ_MEM NORM_OBJ_PER < <(jq -r -n \
        --argjson u "$UMBRAL_SIM" \
        --argjson p "$PESO_INICIAL" \
        --argjson hh "$H_HIP" \
        --argjson hm "$H_MEM" \
        --argjson hp "$H_PER" \
        --argjson c "$H_CAS" '
        [
            ($u * (((($p / $u) | log) * ($c / $hh)) | exp)),
            ($u * (((($p / $u) | log) * ($c / $hm)) | exp)),
            ($u * ((((1.0 / $u) | log) * ($c / $hp)) | exp))
        ] | map(tostring) | join(" ")
    ')

    # 1. Actualizar Hipocampo real con plasticidad LTP / LTD de doble vector (OLVIDO gestiona su decaimiento de 24h)
    HIPO_NUEVO=$(jq -a -c -s --argjson maxp "$MAX_PARTICION" --argjson umb "$UMBRAL_SIM" --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" --argjson nobj "$NORM_OBJ_HIP" '
        def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
        def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
        def cos($a; $b):
            if ($a != null and $b != null) then
                (dot($a; $b) / (norm($a) * norm($b)))
            else
                null
            end;
        (.[0:-1]) as $items |
        (.[-1]) as $nuevo |
        if ($nuevo.embedding == null or ($items | length) == 0) then
            ($items + [$nuevo])[-$maxp:][ ]
        else
            (norm($nuevo.embedding)) as $nq |
            ($nuevo.embedding[:1024] | map(. / $nq)) as $u_nuevo |
            (($umb + $uref) / 2) as $u_med |
            (($uref + 1.0) / 2) as $u_loro |
            (($fref - 1.0) / 2) as $d_min |
            (cos($nuevo.emb_u; $nuevo.emb_a)) as $nua |
            (
                [
                    $items[ ] |
                    if (type == "object" and .embedding != null) then
                        (norm(.embedding)) as $ne |
                        (cos(.emb_u; $nuevo.emb_u)) as $su |
                        (cos(.emb_a; $nuevo.emb_a)) as $sa |
                        (cos(.emb_u; $nuevo.emb_a)) as $sua |
                        . + {
                            _sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq)),
                            _su: $su,
                            _sa: $sa,
                            _sua: $sua,
                            _loro: (if ($sa != null and $su != null and $sa >= $u_loro and $su < $u_med) then 1 else 0 end),
                            _ne: $ne
                        }
                    else
                        . + {_sim: 0, _su: null, _sa: null, _sua: null, _loro: 0, _ne: 0}
                    end
                ]
            ) as $marcados |
            ([ $marcados[ ] | select(._sim >= $uref and ._loro == 0) ]) as $coincidentes |
            if ($coincidentes | length) > 0 then
                ($coincidentes | sort_by(-._sim) | .[0]) as $gan |
                ($gan._ne) as $n_base |
                (
                    if (($nuevo.herramienta // 0) == 1 or ($gan.herramienta // 0) == 1 or ((($nuevo.messages[1].content // "") | startswith("["))) or ((($gan.messages[1].content // "") | startswith("[")))) then
                        1
                    else
                        0
                    end
                ) as $es_herr |
                (
                    if $es_herr == 1 then
                        $nq
                    else
                        (if ($n_base * $fref) > $nq then ($n_base * $fref) else $nq end) as $n_bruto |
                        (if $n_bruto > 1.0 then 1.0 else $n_bruto end)
                    end
                ) as $n_ref |
                ($u_nuevo | map((. * $n_ref * 10000 | round) / 10000)) as $emb_final |
                (
                    [ $marcados[ ] | select(._sim < $uref or ._loro == 1) | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne) ] +
                    [($nuevo + {herramienta: $es_herr, embedding: $emb_final, sensor: (if ($nuevo.sensor != null and ($nuevo.sensor | length) > 0) then $nuevo.sensor else ($gan.sensor // null) end)})]
                )[-$maxp:][ ]
            else
                ([
                    $marcados | to_entries[ ] |
                    select(
                        (((.value.messages[0].content // "") | startswith("<<")) | not) and
                        .value._sim >= $umb and .value._sim < $uref and
                        (.value._su == null or .value._sua == null or .value._sa == null or .value._su >= .value._sua or .value._sa < $uref) and
                        (
                            if (.value._sa != null and .value._su != null) then
                                ((.value._sa >= $u_med and (.value._sa - .value._su) >= $d_min) or (.value._su >= $u_med and (.value._su - .value._sa) >= ($d_min * 2)))
                            else
                                (.value._sim >= $u_med)
                            end
                        )
                    )
                ] | sort_by(-.value._sim) | .[0].key // -1) as $k_ltd |
                ([ $marcados[ ] | select(._loro == 1) ] | length) as $hay_loro |
                (
                    if $hay_loro > 0 then
                        ($nuevo + {embedding: ($u_nuevo | map((. * $nobj * 10000 | round) / 10000))})
                    else
                        $nuevo
                    end
                ) as $nuevo_fin |
                (
                    [
                        $marcados | to_entries[ ] |
                        if ($k_ltd >= 0 and .key == $k_ltd and .value._ne > $nobj) then
                            (.value.embedding[:1024]) as $v |
                            (.value._ne) as $ne |
                            (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne)) + {embedding: ($v | map(((. / $ne) * $nobj * 10000 | round) / 10000))}
                        else
                            (.value | del(._sim, ._su, ._sa, ._sua, ._loro, ._ne))
                        end
                    ] + [$nuevo_fin]
                )[-$maxp:][ ]
            end
        end
    ' < <(cat "$HIPOCAMPO"; echo "$LINEA_HIPO"))
    if [[ -n "$HIPO_NUEVO" ]]; then
        echo "$HIPO_NUEVO" > "${HIPOCAMPO}.$$.tmp"
        mv -f "${HIPOCAMPO}.$$.tmp" "$HIPOCAMPO"
    fi

    # 2. Destilar Hecho Atomico (estilo Mem0) en background antes de guardar en Episodica (sin saludos ni relleno)
    LINEA_EPI="$LINEA_TURNO"
    OMITIR_EPI=0
    ES_HERR_EPI=$(jq -r '.herramienta // 0' < <(printf '%s' "$LINEA_TURNO") 2>/dev/null)
    if [[ "${ES_HERR_EPI:-0}" -eq 0 ]]; then
        if [[ ${#ENTRADA_UNA_LINEA} -ge 15 ]]; then
            PAY_ATOM=$(jq -a -n --arg u "$ENTRADA_UNA_LINEA" --arg a "$RESPUESTA_UNA_LINEA" '{
                messages: [
                    {"role": "system", "content": "Extrae SOLO los hechos concretos y objetivos dichos en este turno (datos del usuario, nombres, gustos, codigos, decisiones) en UNA sola frase corta en tercera persona, sin saludos ni emojis. Si solo es un saludo o charla vacia sin hechos concretos, responde exactamente: NINGUNO"},
                    {"role": "user", "content": ("Usuario: " + $u + "\nAsistente: " + ($a | .[0:300]))}
                ],
                temperature: 0.0,
                max_tokens: 64
            }')
            RESP_ATOM=$(curl -sf -m 15 "$URL" -H "Content-Type: application/json" -d "$PAY_ATOM" 2>/dev/null)
            HECHO_ATOM=$(jq -r '.choices[0].message.content // empty' < <(printf '%s' "$RESP_ATOM") 2>/dev/null)
            HECHO_ATOM="${HECHO_ATOM//$'\r'/ }"
            HECHO_ATOM="${HECHO_ATOM//$'\n'/ }"
            HECHO_ATOM=$(jq -r -n --arg s "$HECHO_ATOM" '$s | gsub("^\\s+|\\s+$"; "")')
            if [[ "${HECHO_ATOM^^}" == "NINGUNO"* ]]; then
                OMITIR_EPI=1
            elif [[ ${#HECHO_ATOM} -ge 10 ]]; then
                PAY_EMB_AT=$(jq -a -n --arg t "$HECHO_ATOM" '{input: $t}')
                RESP_EMB_AT=$(curl -sf -m 10 "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_EMB_AT" 2>/dev/null)
                if [[ -z "$RESP_EMB_AT" ]]; then RESP_EMB_AT="{}"; fi
                LINEA_ATOM=$(jq -a -c -s --arg h "$HECHO_ATOM" --argjson peso "$PESO_INICIAL" '
                    (.[0]) as $base |
                    (.[1]) as $emb |
                    if ($emb.data and ($emb.data | length) > 0) then
                        ($emb.data[0].embedding) as $v |
                        $base + {
                            atomico: 1,
                            messages: [
                                {"role": "user", "content": $h},
                                {"role": "assistant", "content": $h}
                            ],
                            embedding: ($v | map(((. * $peso) * 10000 | round) / 10000)),
                            emb_u: ($v | map((. * 10000 | round) / 10000)),
                            emb_a: ($v | map((. * 10000 | round) / 10000))
                        }
                    else
                        empty
                    end
                ' < <(printf '%s\n%s\n' "$LINEA_TURNO" "$RESP_EMB_AT") 2>/dev/null)
                if [[ -n "$LINEA_ATOM" ]]; then
                    LINEA_EPI="$LINEA_ATOM"
                fi
            fi
        fi
    fi

    # 2b. Guardar en Memoria Episodica particionada (si no fue saludo vacio)
    ULTIMA_PARTICION=""
    if [[ $OMITIR_EPI -eq 0 ]]; then
        guardar_en_capa "$INDICE_EPISODICA" "$PREFIJO_EPISODICA" "$LINEA_EPI" "$NORM_OBJ_MEM"
    fi

    # 3. Ascenso a Memoria Persistente particionada solo si el turno recien guardado (ultima linea) alcanzo norma >= $UMBRAL_PERSISTENTE, o LTD si colisiona con un recuerdo persistente
    CANDIDATO_PER=""
    if [[ -n "$ULTIMA_PARTICION" ]]; then
        CANDIDATO_PER=$(jq -a -c --argjson uper "$UMBRAL_PERSISTENTE" '
            select((.herramienta // 0) == 0 and (((.messages[1].content // "") | startswith("[")) | not) and (((.messages[0].content // "") | startswith("<<")) | not) and .embedding != null and ((.embedding | map(. * .) | add | sqrt) >= $uper))
        ' < <(tail -n 1 "$DIR_MEMORIA/$ULTIMA_PARTICION"))
    fi
    if [[ -n "$CANDIDATO_PER" ]]; then
        guardar_en_capa "$INDICE_PERSISTENTE" "$PREFIJO_PERSISTENTE" "$CANDIDATO_PER" "$NORM_OBJ_PER"
    elif [[ -s "$INDICE_PERSISTENTE" ]]; then
        PART_PER_LTD=$(jq -r -s --argjson umb "$UMBRAL_SIM" '
            (.[0:-1]) as $idx |
            (.[-1]) as $nuevo |
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                (
                    [
                        $idx[ ] |
                        select(.embedding != null) |
                        ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                        . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                        select(.sim >= $umb)
                    ] | sort_by(-.sim) | .[0].archivo // empty
                )
            else
                empty
            end
        ' < <(cat "$INDICE_PERSISTENTE"; echo "$LINEA_TURNO"))
        if [[ -n "$PART_PER_LTD" ]]; then
            if [[ -s "$DIR_MEMORIA/$PART_PER_LTD" ]]; then
                PER_LTD_ACT=$(jq -a -c -s --argjson umb "$UMBRAL_SIM" --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" --argjson nobj "$NORM_OBJ_PER" '
                    def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    def cos($a; $b):
                        if ($a != null and $b != null) then
                            (dot($a; $b) / (norm($a) * norm($b)))
                        else
                            null
                        end;
                    (.[0:-1]) as $items |
                    (.[-1]) as $nuevo |
                    if $nuevo.embedding == null then
                        empty
                    else
                        (norm($nuevo.embedding)) as $nq |
                        (($umb + $uref) / 2) as $u_med |
                        (($uref + 1.0) / 2) as $u_loro |
                        (($fref - 1.0) / 2) as $d_min |
                        (
                            [
                                $items[ ] |
                                if (type == "object" and .embedding != null) then
                                    (norm(.embedding)) as $ne |
                                    (cos(.emb_u; $nuevo.emb_u)) as $su |
                                    (cos(.emb_a; $nuevo.emb_a)) as $sa |
                                    . + {
                                        _sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq)),
                                        _su: $su,
                                        _sa: $sa,
                                        _loro: (if ($sa != null and $su != null and $sa >= $u_loro and $su < $uref) then 1 else 0 end),
                                        _ne: $ne
                                    }
                                else
                                    . + {_sim: 0, _su: null, _sa: null, _loro: 0, _ne: 0}
                                end
                            ]
                        ) as $marcados |
                        ([
                            $marcados | to_entries[ ] |
                            select(
                                (((.value.messages[0].content // "") | startswith("<<")) | not) and
                                (
                                    .value._loro == 1 or
                                    (
                                        .value._sim >= $umb and .value._sim < $uref and
                                        (
                                            if (.value._sa != null and .value._su != null) then
                                                ((.value._sa >= $u_med and (.value._sa - .value._su) >= $d_min) or (.value._su >= $u_med and (.value._su - .value._sa) >= ($d_min * 2)))
                                            else
                                                (.value._sim >= $u_med)
                                            end
                                        )
                                    )
                                )
                            )
                        ] | sort_by(-.value._sim) | .[0].key // -1) as $k_ltd |
                        if ($k_ltd >= 0 and $marcados[$k_ltd]._ne > $nobj) then
                            [
                                $marcados | to_entries[ ] |
                                if .key == $k_ltd then
                                    (.value.embedding[:1024]) as $v |
                                    (.value._ne) as $ne |
                                    (.value | del(._sim, ._su, ._sa, ._loro, ._ne)) + {embedding: ($v | map(((. / $ne) * $nobj * 10000 | round) / 10000))}
                                else
                                    (.value | del(._sim, ._su, ._sa, ._loro, ._ne))
                                end
                            ][ ]
                        else
                            empty
                        end
                    end
                ' < <(cat "$DIR_MEMORIA/$PART_PER_LTD"; echo "$LINEA_TURNO"))
                if [[ -n "$PER_LTD_ACT" ]]; then
                    echo "$PER_LTD_ACT" > "$DIR_MEMORIA/${PART_PER_LTD}.$$.tmp"
                    mv -f "$DIR_MEMORIA/${PART_PER_LTD}.$$.tmp" "$DIR_MEMORIA/$PART_PER_LTD"
                fi
            fi
        fi
    fi

    # 4. Capa procedimental (trazas reales completas de herramientas: usar + leer, solo para entrenamiento en sueno si valencia >= 0)
    LINEA_PROC=""
    if [[ -n "$ARCH_TRAZA_CONSOLIDAR" ]]; then
        if [[ -s "$ARCH_TRAZA_CONSOLIDAR" ]]; then
            if [[ "${VAL_TURNO:-0}" -ge 0 ]]; then
            if [[ ! -f "$INDICE_PROCEDIMENTAL" ]]; then > "$INDICE_PROCEDIMENTAL"; fi
            LINEA_PROC=$(jq -a -c -s --arg f "$FECHA_HORA" --argjson peso "$PESO_INICIAL" '
                def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                (.[0]) as $resp |
                (.[1]) as $msgs |
                if ($msgs | type) == "array" and ($msgs | length) >= 4 then
                    {
                        fecha: $f,
                        tipo: "procedimental",
                        messages: $msgs,
                        embedding: (
                            if ($resp.data and ($resp.data | length) > 0) then
                                ($resp.data[0].embedding) as $v |
                                (norm($v)) as $n |
                                ($v | map(((. / $n) * $peso * 10000 | round) / 10000))
                            else
                                null
                            end
                        ),
                        emb_u: (if ($resp.data and ($resp.data | length) > 1) then ($resp.data[1].embedding | map((. * 10000 | round) / 10000)) else null end),
                        emb_a: (if ($resp.data and ($resp.data | length) > 2) then ($resp.data[2].embedding | map((. * 10000 | round) / 10000)) else null end)
                    }
                else
                    empty
                end
            ' < <(printf '%s\n' "$RESP_MEM"; cat "$ARCH_TRAZA_CONSOLIDAR") 2>/dev/null)

            if [[ -n "$LINEA_PROC" ]]; then
                PART_PROC=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    (.[0:-1]) as $idx |
                    (.[-1]) as $nuevo |
                    if $nuevo.embedding != null then
                        (norm($nuevo.embedding)) as $nq |
                        [
                            $idx[ ] |
                            select((.lineas // 0) < $maxp and .embedding != null and ((.embedding | length) == ($nuevo.embedding | length))) |
                            (norm(.embedding)) as $ne |
                            . + {_sim: (dot(.embedding; $nuevo.embedding) / ($ne * $nq))} |
                            select(._sim >= $umb)
                        ] | sort_by(-._sim) | .[0].archivo // empty
                    else
                        ($idx | map(select(.ultimo == 1 and (.lineas // 0) < $maxp)) | .[0].archivo // empty)
                    end
                ' < <(cat "$INDICE_PROCEDIMENTAL"; printf '%s\n' "$LINEA_PROC") 2>/dev/null)

                if [[ -n "$PART_PROC" ]]; then
                    if [[ -s "$DIR_MEMORIA/$PART_PROC" ]]; then
                        PROC_ACT=$(jq -a -c -s --argjson uref "$UMBRAL_REFUERZO" --argjson fref "$FACTOR_REFUERZO" '
                            def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                            def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                            def mod_cmd($m):
                                (([ $m[ ] | select(.tool_calls != null and (.tool_calls | length) > 0) ][0].tool_calls[0].function.arguments // "{}") as $raw |
                                (if ($raw | type) == "string" then (try ($raw | fromjson) catch {comando: $raw}) else $raw end) |
                                (.comando // "") | split(" ")[0] // "");
                            (.[0:-1]) as $items |
                            (.[-1]) as $nuevo |
                            if $nuevo.emb_u == null then
                                ($items + [$nuevo])[ ]
                            else
                                (norm($nuevo.emb_u)) as $nu |
                                (mod_cmd($nuevo.messages)) as $mod_n |
                                (
                                    [
                                        $items[ ] |
                                        if (type == "object" and .emb_u != null and ((.emb_u | length) == ($nuevo.emb_u | length))) then
                                            . + {_su: (dot(.emb_u; $nuevo.emb_u) / (norm(.emb_u) * $nu))}
                                        else
                                            . + {_su: 0}
                                        end
                                    ]
                                ) as $marc |
                                ([ $marc[ ] | select(._su >= $uref) ] | sort_by(-._su) | .[0] // null) as $prev |
                                (
                                    if ($prev != null and $prev.embedding != null and $nuevo.embedding != null and (mod_cmd($prev.messages) == $mod_n)) then
                                        (norm($prev.embedding)) as $np |
                                        (norm($nuevo.embedding)) as $nn |
                                        ((if ($np * $fref) > $nn then ($np * $fref) else $nn end) | if . > 1.0 then 1.0 else . end) as $nfin |
                                        ($nuevo + {embedding: ($nuevo.embedding | map(((. / $nn) * $nfin * 10000 | round) / 10000))})
                                    else
                                        $nuevo
                                    end
                                ) as $nuevo_fin |
                                (
                                    [ $marc[ ] | select(._su < $uref) | del(._su) ] + [$nuevo_fin]
                                )[ ]
                            end
                        ' < <(cat "$DIR_MEMORIA/$PART_PROC"; printf '%s\n' "$LINEA_PROC") 2>/dev/null)
                        if [[ -n "$PROC_ACT" ]]; then
                            printf '%s\n' "$PROC_ACT" > "$DIR_MEMORIA/${PART_PROC}.$$.tmp"
                            mv -f "$DIR_MEMORIA/${PART_PROC}.$$.tmp" "$DIR_MEMORIA/$PART_PROC"
                        fi
                    else
                        printf '%s\n' "$LINEA_PROC" > "$DIR_MEMORIA/$PART_PROC"
                    fi
                else
                    N_PR=1
                    while [[ -f "$DIR_MEMORIA/${PREFIJO_PROCEDIMENTAL}_${N_PR}.json" ]]; do
                        N_PR=$((N_PR + 1))
                    done
                    PART_PROC="${PREFIJO_PROCEDIMENTAL}_${N_PR}.json"
                    printf '%s\n' "$LINEA_PROC" > "$DIR_MEMORIA/$PART_PROC"
                fi

                LIN_PROC=$(( $(wc -l < "$DIR_MEMORIA/$PART_PROC") ))
                IND_PROC_NUEVO=$(jq -a -c -s --arg arch "$PART_PROC" --argjson lreal "$LIN_PROC" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    (.[0:-1]) as $idx |
                    (.[-1]) as $nuevo |
                    (
                        if $nuevo.embedding != null then
                            (norm($nuevo.embedding)) as $nq |
                            ($nuevo.embedding | map(((. / $nq) * 10000 | round) / 10000))
                        else
                            null
                        end
                    ) as $v_unit |
                    if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
                        [
                            $idx[ ] |
                            if .archivo == $arch then
                                (.lineas // 1) as $n |
                                . + {
                                    lineas: $lreal,
                                    ultimo: 1,
                                    embedding: (
                                        if ($v_unit != null and .embedding != null and ((.embedding | length) == ($v_unit | length))) then
                                            (.embedding) as $old |
                                            ($old | length) as $dim |
                                            (reduce range(0; $dim) as $i ([ ]; . + [((($old[$i] // 0) * $n) + ($v_unit[$i] // 0)) / ($n + 1)])) as $raw_c |
                                            (norm($raw_c)) as $nc |
                                            ($raw_c | map(((. / $nc) * 10000 | round) / 10000))
                                        else
                                            (.embedding // $v_unit)
                                        end
                                    )
                                }
                            else
                                . + {ultimo: 0}
                            end
                        ][ ]
                    else
                        (
                            [ $idx[ ] | . + {ultimo: 0} ] +
                            [{
                                archivo: $arch,
                                lineas: $lreal,
                                ultimo: 1,
                                embedding: $v_unit
                            }]
                        )[ ]
                    end
                ' < <(cat "$INDICE_PROCEDIMENTAL"; printf '%s\n' "$LINEA_PROC") 2>/dev/null)
                if [[ -n "$IND_PROC_NUEVO" ]]; then
                    printf '%s\n' "$IND_PROC_NUEVO" > "${INDICE_PROCEDIMENTAL}.$$.tmp"
                    mv -f "${INDICE_PROCEDIMENTAL}.$$.tmp" "$INDICE_PROCEDIMENTAL"
                fi
            fi
            fi
        fi
    elif [[ $MODO_INTERNO -eq 0 ]]; then
        # Turno sin herramienta: purgar de procedimental si habia una traza previa para la misma consulta o si el hipocampo castigo (LTD) una herramienta
        if [[ -s "$INDICE_PROCEDIMENTAL" ]]; then
            U_CASTIGADOS=$(jq -a -c -s --argjson nh "$NORM_OBJ_HIP" '
                def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                [ .[ ] | select(type == "object" and (.herramienta // 0) == 1 and .embedding != null and norm(.embedding) <= ($nh + 0.003)) | (.messages[0].content // "") ] | unique
            ' "$HIPOCAMPO" 2>/dev/null)
            if [[ -z "$U_CASTIGADOS" ]]; then U_CASTIGADOS="[ ]"; fi
            for pf_p in "$DIR_MEMORIA/${PREFIJO_PROCEDIMENTAL}_"*.json; do
                if [[ -s "$pf_p" ]]; then
                    BASE_PP="$(basename "$pf_p")"
                    ANT_LP=$(( $(wc -l < "$pf_p") ))
                    FILT_PP=$(jq -a -c -s --argjson uref "$UMBRAL_REFUERZO" --argjson cast "$U_CASTIGADOS" '
                        def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                        def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                        (.[0:-1]) as $items |
                        (.[-1]) as $turno |
                        (if $turno.emb_u != null then norm($turno.emb_u) else 0 end) as $nu |
                        $items[ ] |
                        select(
                            (((.messages[0].content // "") as $u | ($cast | index($u)) == null)) and
                            (
                                $nu == 0 or
                                .emb_u == null or
                                ((.emb_u | length) != ($turno.emb_u | length)) or
                                ((dot(.emb_u; $turno.emb_u) / (norm(.emb_u) * $nu)) < $uref)
                            )
                        )
                    ' < <(cat "$pf_p"; printf '%s\n' "$LINEA_TURNO") 2>/dev/null)
                    if [[ -n "$FILT_PP" ]]; then
                        printf '%s\n' "$FILT_PP" > "${pf_p}.$$.tmp"
                        NUEV_LP=$(( $(wc -l < "${pf_p}.$$.tmp") ))
                        if [[ $NUEV_LP -lt $ANT_LP ]]; then
                            mv -f "${pf_p}.$$.tmp" "$pf_p" 2>/dev/null
                            IND_PP_ACT=$(jq -a -c --arg arch "$BASE_PP" --argjson lin "$NUEV_LP" 'if .archivo == $arch then . + {lineas: $lin} else . end' "$INDICE_PROCEDIMENTAL" 2>/dev/null)
                            if [[ -n "$IND_PP_ACT" ]]; then
                                printf '%s\n' "$IND_PP_ACT" > "${INDICE_PROCEDIMENTAL}.$$.tmp"
                                mv -f "${INDICE_PROCEDIMENTAL}.$$.tmp" "$INDICE_PROCEDIMENTAL" 2>/dev/null
                            fi
                        else
                            rm -f "${pf_p}.$$.tmp" 2>/dev/null
                        fi
                    else
                        rm -f "$pf_p" 2>/dev/null
                        IND_PP_ACT=$(jq -a -c --arg arch "$BASE_PP" 'select(.archivo != $arch)' "$INDICE_PROCEDIMENTAL" 2>/dev/null)
                        if [[ -n "$IND_PP_ACT" ]]; then
                            printf '%s\n' "$IND_PP_ACT" > "${INDICE_PROCEDIMENTAL}.$$.tmp"
                            mv -f "${INDICE_PROCEDIMENTAL}.$$.tmp" "$INDICE_PROCEDIMENTAL" 2>/dev/null
                        else
                            > "$INDICE_PROCEDIMENTAL"
                        fi
                    fi
                fi
            done
        fi
    fi

    # 5. Reconsolidacion / rectificacion geometrica de LoRAs de sueno en conflicto con la experiencia actual
    if [[ $MODO_INTERNO -eq 0 ]]; then
        if [[ -s "$INDICE_LORA_DATASETS" ]]; then
            LORAS_CONF_CAND=$(jq -r -s --argjson umb "$UMBRAL_SIM" '
                def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                (.[0:-1]) as $idx |
                (.[-1]) as $turno |
                if ($turno.embedding == null and $turno.emb_u == null) then
                    empty
                else
                    (if $turno.embedding != null then norm($turno.embedding) else 1 end) as $nt |
                    (if $turno.emb_u != null then norm($turno.emb_u) else 1 end) as $nu |
                    [
                        $idx[ ] |
                        select(((.nombre // "") | startswith("sueno_")) and .embedding != null) |
                        (norm(.embedding)) as $ne |
                        (if ($turno.embedding != null and (.embedding | length) == ($turno.embedding | length)) then (dot(.embedding; $turno.embedding) / ($ne * $nt)) else 0 end) as $st |
                        (if ($turno.emb_u != null and (.embedding | length) == ($turno.emb_u | length)) then (dot(.embedding; $turno.emb_u) / ($ne * $nu)) else 0 end) as $su |
                        (if $su > $st then $su else $st end) as $smax |
                        select($smax >= $umb) |
                        {nombre: .nombre, s: $smax}
                    ] | sort_by(-.s)[:3][ ].nombre
                end
            ' < <(cat "$INDICE_LORA_DATASETS"; printf '%s\n' "$LINEA_TURNO") 2>/dev/null)

            if [[ -n "$LORAS_CONF_CAND" ]]; then
                U_TURNO_LIMPIO=$(jq -r '(.messages[0].content // "") | sub("^\\[[^\\]]+\\] <<[^>]+>> *"; "")' < <(printf '%s' "$LINEA_TURNO") 2>/dev/null)
                A_TURNO_LIMPIO=$(jq -r '.messages[1].content // ""' < <(printf '%s' "$LINEA_TURNO") 2>/dev/null)
                PROC_PARA_CONF="null"
                if [[ -n "$LINEA_PROC" ]]; then
                    PROC_PARA_CONF="$LINEA_PROC"
                fi

                while IFS= read -r nom_cand; do
                    if [[ -n "$nom_cand" ]]; then
                        DS_SRC="$DIR_LORA_DATASETS/${nom_cand}.jsonl"
                        if [[ -s "$DIR_SUENO/$nom_cand/dataset.jsonl" ]]; then
                            DS_SRC="$DIR_SUENO/$nom_cand/dataset.jsonl"
                        fi
                        if [[ -s "$DS_SRC" ]]; then
                            CLASE_CAND="declarativo"
                            if [[ "$nom_cand" == sueno_herr_* ]]; then
                                CLASE_CAND="procedimental"
                            fi
                            PAY_CONF=$(jq -a -c -s '
                                {
                                    input: (
                                        [ .[ ] | (.messages[0].content // "") ] +
                                        [ .[ ] | (.messages[-1].content // "") ]
                                    )
                                }
                            ' "$DS_SRC" 2>/dev/null)
                            RESP_CONF=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_CONF" 2>/dev/null)
                            if [[ -n "$RESP_CONF" ]]; then
                                EVAL_CONF=$(jq -a -c -s \
                                    --arg clase "$CLASE_CAND" \
                                    --argjson uref "$UMBRAL_REFUERZO" \
                                    --arg unew "$U_TURNO_LIMPIO" \
                                    --arg anew "$A_TURNO_LIMPIO" '
                                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                                    def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                                    def mod_cmd($m):
                                        (([ $m[ ] | select(.tool_calls != null and (.tool_calls | length) > 0) ][0].tool_calls[0].function.arguments // "{}") as $raw |
                                        (if ($raw | type) == "string" then (try ($raw | fromjson) catch {comando: $raw}) else $raw end) |
                                        (.comando // "") | split(" ")[0] // "");
                                    (.[0]) as $ds |
                                    (.[1]) as $embs |
                                    (.[2]) as $turno |
                                    (.[3]) as $proc |
                                    ($ds | length) as $n |
                                    if ($n == 0 or $turno.emb_u == null or ($embs.data // [ ] | length) < ($n * 2)) then
                                        {conflicto: 0}
                                    else
                                        (norm($turno.emb_u)) as $nu |
                                        (if $turno.emb_a != null then norm($turno.emb_a) else 0 end) as $na |
                                        (if $proc != null then mod_cmd($proc.messages) else "" end) as $mod_new |
                                        [
                                            range(0; $n) as $i |
                                            ($ds[$i]) as $item |
                                            ($embs.data[$i].embedding) as $eu |
                                            ($embs.data[$n + $i].embedding) as $ea |
                                            (dot($eu; $turno.emb_u) / (norm($eu) * $nu)) as $su |
                                            (if $na > 0 then (dot($ea; $turno.emb_a) / (norm($ea) * $na)) else 0 end) as $sa |
                                            (mod_cmd($item.messages)) as $mod_ds |
                                            (
                                                if ($su >= $uref) then
                                                    if $clase == "procedimental" then
                                                        (if ($proc == null or $mod_new != $mod_ds or $sa < $uref) then 1 else 0 end)
                                                    else
                                                        (if ($proc != null or $sa < $uref) then 1 else 0 end)
                                                    end
                                                else
                                                    0
                                                end
                                            ) as $es_conf |
                                            {item: $item, conf: $es_conf}
                                        ] as $evals |
                                        ([ $evals[ ] | select(.conf == 1) ] | length) as $nconf |
                                        if $nconf == 0 then
                                            {conflicto: 0}
                                        else
                                            ([ $evals[ ] | select(.conf == 0) | .item ]) as $base_items |
                                            (
                                                if ($clase == "procedimental" and $proc != null) then
                                                    $base_items + [{messages: $proc.messages}]
                                                elif ($clase == "declarativo" and $proc == null and ($unew | length) > 0 and ($anew | length) > 0 and (($unew | startswith("<<")) | not) and (($anew | startswith("[")) | not)) then
                                                    $base_items + [{messages: [{"role": "user", "content": $unew}, {"role": "assistant", "content": $anew}]}]
                                                else
                                                    $base_items
                                                end
                                            ) as $nuevo_ds |
                                            {conflicto: $nconf, items: $nuevo_ds}
                                        end
                                    end
                                ' < <(jq -a -c -s '.' "$DS_SRC" 2>/dev/null; printf '%s\n%s\n%s\n' "$RESP_CONF" "$LINEA_TURNO" "$PROC_PARA_CONF") 2>/dev/null)

                                NUM_CONF=$(jq -r '.conflicto // 0' < <(printf '%s' "$EVAL_CONF") 2>/dev/null)
                                if [[ "${NUM_CONF:-0}" -gt 0 ]]; then
                                    mkdir -p "$DIR_MEM_LORA" "$DIR_SUENO/$nom_cand"
                                    if [[ ! -f "$LORAS_RECTIFICAR" ]]; then > "$LORAS_RECTIFICAR"; fi
                                    if ! grep -Fxq "$nom_cand" "$LORAS_RECTIFICAR" 2>/dev/null; then
                                        printf '%s\n' "$nom_cand" >> "$LORAS_RECTIFICAR"
                                    fi

                                    # Borrar checkpoints/pesos candidatos viejos para reentrenar limpio sin arrastrar el sesgo malo
                                    rm -f \
                                        "$DIR_SUENO/$nom_cand/modelo.ckpt" \
                                        "$DIR_SUENO/$nom_cand/cache.pt" \
                                        "$DIR_SUENO/$nom_cand/best.ckpt" \
                                        "$DIR_SUENO/$nom_cand/best.gguf" \
                                        "$DIR_SUENO/$nom_cand/candidato.gguf" \
                                        "$DIR_SUENO/$nom_cand/best_aprobados.txt" 2>/dev/null

                                    jq -a -c '.items[ ]' < <(printf '%s' "$EVAL_CONF") > "$DIR_SUENO/$nom_cand/dataset.jsonl" 2>/dev/null
                                    NUM_REST=$(( $(wc -l < "$DIR_SUENO/$nom_cand/dataset.jsonl") ))

                                    if [[ $NUM_REST -lt "${MIN_RECUERDOS_SUENO:-3}" ]]; then
                                        jq -a -n \
                                            --arg nom "$nom_cand" \
                                            --arg clase "$CLASE_CAND" \
                                            --argjson nej "$NUM_REST" '{
                                            nombre: $nom,
                                            particion: "",
                                            clase: $clase,
                                            es_fusion: 0,
                                            rectificacion: 1,
                                            fase: "purgar",
                                            ciclo: 0,
                                            epocas_obj: 1,
                                            mejor_epocas: 0,
                                            lr: 0.0005,
                                            num_ejemplos: $nej,
                                            mejor_errores: 9999,
                                            mejor_sim: 0.0,
                                            reset_lr: 0
                                        }' > "$DIR_SUENO/$nom_cand/estado.json"
                                    else
                                        if [[ "$CLASE_CAND" == "procedimental" ]]; then
                                            jq -a -c '
                                                ([ .messages[ ] | select(.tool_calls != null and (.tool_calls | length) > 0) ][0].tool_calls[0]) as $tc |
                                                ($tc.function.arguments // "{}") as $raw_args |
                                                (if ($raw_args | type) == "string" then (try ($raw_args | fromjson) catch {comando: $raw_args}) else $raw_args end) as $obj_args |
                                                {
                                                    u: (.messages[0].content // ""),
                                                    tool_name: ($tc.function.name // "bash"),
                                                    tool_cmd: ($obj_args.comando // ""),
                                                    tool_out: ([ .messages[ ] | select(.role == "tool") ][0].content // ""),
                                                    a: (.messages[-1].content // "")
                                                }
                                            ' "$DIR_SUENO/$nom_cand/dataset.jsonl" > "$DIR_SUENO/$nom_cand/origen.json" 2>/dev/null
                                        else
                                            jq -a -c '{u: .messages[0].content, a: .messages[1].content}' "$DIR_SUENO/$nom_cand/dataset.jsonl" > "$DIR_SUENO/$nom_cand/origen.json" 2>/dev/null
                                        fi
                                        cp -f "$DIR_SUENO/$nom_cand/origen.json" "$DIR_SUENO/$nom_cand/origen_nuevos.json" 2>/dev/null

                                        # Recalcular centroide real del dataset rectificado
                                        PAY_CENT_R=$(jq -a -c -s '{input: [ .[ ] | ((.messages[0].content // "") + " " + (.messages[-1].content // "")) ]}' "$DIR_SUENO/$nom_cand/dataset.jsonl" 2>/dev/null)
                                        RESP_CENT_R=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_CENT_R" 2>/dev/null)
                                        CENT_RECT=$(jq -a -c '
                                            def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                                            if (.data and (.data | length) > 0) then
                                                ([ .data[ ].embedding | (norm(.)) as $n | map(. / $n) ]) as $units |
                                                ($units[0] | length) as $dim |
                                                (reduce range(0; $dim) as $i ([ ]; . + [(reduce $units[ ] as $u (0; . + ($u[$i] // 0))) / ($units | length)])) as $mean |
                                                (norm($mean)) as $nm |
                                                ($mean | map(((. / $nm) * 10000 | round) / 10000))
                                            else
                                                null
                                            end
                                        ' < <(printf '%s' "$RESP_CENT_R") 2>/dev/null)
                                        if [[ -z "$CENT_RECT" ]]; then CENT_RECT="null"; fi
                                        printf '%s\n' "$CENT_RECT" > "$DIR_SUENO/$nom_cand/centroide.json"

                                        G_ACC_R="${GRAD_ACCUM_SUENO:-2}"
                                        PASOS_EP_R=$(( (NUM_REST + G_ACC_R - 1) / G_ACC_R ))
                                        if [[ $PASOS_EP_R -lt 1 ]]; then PASOS_EP_R=1; fi
                                        EP_INIT_R=$(( ${PASOS_OBJ_SUENO:-16} / PASOS_EP_R ))
                                        if [[ $EP_INIT_R -lt 1 ]]; then EP_INIT_R=1; fi

                                        jq -a -n \
                                            --arg nom "$nom_cand" \
                                            --arg clase "$CLASE_CAND" \
                                            --argjson ep0 "$EP_INIT_R" \
                                            --argjson lr "${LR_SUENO:-0.0005}" \
                                            --argjson nej "$NUM_REST" '{
                                            nombre: $nom,
                                            particion: "",
                                            clase: $clase,
                                            es_fusion: 0,
                                            rectificacion: 1,
                                            fase: "profundo",
                                            ciclo: 0,
                                            epocas_obj: $ep0,
                                            mejor_epocas: 0,
                                            lr: $lr,
                                            num_ejemplos: $nej,
                                            mejor_errores: 9999,
                                            mejor_sim: 0.0,
                                            reset_lr: 0
                                        }' > "$DIR_SUENO/$nom_cand/estado.json"
                                    fi

                                    printf '[%s] RECTIFICACION LoRA=%s | clase=%s | conflictos=%s | restantes=%s (silenciado hasta sueno)\n' \
                                        "$(date "+%Y-%m-%d %H:%M:%S")" "$nom_cand" "$CLASE_CAND" "$NUM_CONF" "$NUM_REST" >> "$LOG_LORA_ENTRENAR"
                                fi
                            fi
                        fi
                    fi
                done < <(printf '%s\n' "$LORAS_CONF_CAND")
            fi
        fi
    fi
fi
