#!/bin/bash
# Modulo: escribir <ruta> [linea_ini] [linea_fin] '<texto>' y anadir <ruta> '<texto>' - Escribe, sobrescribe o anade texto en un fichero (usar comillas simples '')

escribir() {
    ESC_RUTA="$1"
    shift
    if [[ -n "$ESC_RUTA" ]]; then
        mkdir -p "$(dirname "$ESC_RUTA")"
        if [[ $# -ge 2 ]]; then
            if [[ "$1" =~ ^[0-9]+$ ]]; then
                if [[ -f "$ESC_RUTA" ]]; then
                    ESC_INI="$1"
                    ESC_FIN="$1"
                    shift
                    if [[ $# -ge 2 ]]; then
                        if [[ "$1" =~ ^[0-9]+$ ]]; then
                            ESC_FIN="$1"
                            shift
                        fi
                    fi
                    : > "$ESC_RUTA.tmp"
                    if [[ "$ESC_INI" -gt 1 ]]; then
                        head -n "$((ESC_INI - 1))" "$ESC_RUTA" >> "$ESC_RUTA.tmp"
                    fi
                    printf "%b\n" "$*" >> "$ESC_RUTA.tmp"
                    tail -n "+$((ESC_FIN + 1))" "$ESC_RUTA" >> "$ESC_RUTA.tmp"
                    mv "$ESC_RUTA.tmp" "$ESC_RUTA"
                    echo "Escrito ($ESC_INI-$ESC_FIN): $ESC_RUTA"
                else
                    echo "Error: no existe $ESC_RUTA"
                    test 0 -eq 1
                fi
            else
                printf "%b\n" "$*" > "$ESC_RUTA"
                echo "Escrito: $ESC_RUTA"
            fi
        else
            printf "%b\n" "$*" > "$ESC_RUTA"
            echo "Escrito: $ESC_RUTA"
        fi
    else
        echo "Error: falta ruta"
        test 0 -eq 1
    fi
}

anadir() {
    AN_RUTA="$1"
    shift
    if [[ -n "$AN_RUTA" ]]; then
        mkdir -p "$(dirname "$AN_RUTA")"
        printf "%b\n" "$*" >> "$AN_RUTA"
        echo "Anadido: $AN_RUTA"
    else
        echo "Error: falta ruta"
        test 0 -eq 1
    fi
}
