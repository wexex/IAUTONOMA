#!/bin/bash
# Modulo: meteo_hoy - Pronostico completo por horas de HOY

meteo_hoy() {
    # 1. Obtener coordenadas (con respaldo por si falla la red)
    LAT=""
    LON=""

    # 1. En Android Termux (GPS real del móvil en Bash)
    if command -v termux-location &>/dev/null; then
        LOC=$(termux-location -p network -r once 2>/dev/null || termux-location -p gps -r once 2>/dev/null)
        LAT=$(echo "$LOC" | grep -o '"latitude": *[0-9.-]*' | head -n1 | cut -d: -f2 | tr -d ' ')
        LON=$(echo "$LOC" | grep -o '"longitude": *[0-9.-]*' | head -n1 | cut -d: -f2 | tr -d ' ')
    fi

    # 2. En Windows PC (triangulación Wi-Fi real del sistema)
    if [[ -z "$LAT" || -z "$LON" ]] && command -v powershell.exe &>/dev/null; then
        LOC_WIN=$(powershell.exe -NoProfile -Command "Add-Type -AssemblyName System.Device; \$w = New-Object System.Device.Location.GeoCoordinateWatcher; \$w.Start(); Start-Sleep -Milliseconds 2500; \$loc = \$w.Position.Location; \$w.Stop(); if (!\$loc.IsUnknown) { Write-Output \"\$([Math]::Round(\$loc.Latitude, 4)), \$([Math]::Round(\$loc.Longitude, 4))\" }" 2>/dev/null)
        LAT=$(echo "$LOC_WIN" | cut -d, -f1 | tr -d ' \r\n')
        LON=$(echo "$LOC_WIN" | cut -d, -f2 | tr -d ' \r\n')
    fi

    # 3. Respaldo por IP si no hay sensor disponible
    if [[ -z "$LAT" || -z "$LON" ]]; then
        LOC_IP=$(curl -s -A "curl" --max-time 3 "https://ipinfo.io/loc" 2>/dev/null)
        LAT=$(echo "${LOC_IP%,*}" | tr -d ' \r\n')
        LON=$(echo "${LOC_IP#*,}" | tr -d ' \r\n')
    fi
    if [[ -z "$LAT" || -z "$LON" || ! "$LAT" =~ ^[0-9\.-]+$ ]]; then LAT="40.4168"; LON="-3.7038"; fi

    # 2. Diccionario de estados WMO nativo en Bash
    declare -A WMO=(
        [0]="Soleado" [1]="Nublado-" [2]="Nublado+" [3]="Nublado"
        [45]="Niebla-" [48]="Niebla" 
        [51]="Llovizna-" [53]="Llovizna+" [55]="Llovizna"
        [61]="Lluvia-" [63]="Lluvia+" [65]="Lluvia"
        [71]="Nieve-" [75]="Nieve"
        [80]="Chubascos-" [81]="Chubascos+" [82]="Chubascos"
        [95]="Tormenta"
    )

    API="https://api.open-meteo.com/v1/forecast"
    FIELDS="hourly=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation_probability,precipitation,wind_speed_10m,wind_gusts_10m,weather_code"
    URL="${API}?latitude=${LAT}&longitude=${LON}&${FIELDS}&forecast_days=1&timezone=auto&format=csv"

    # Obtener nombre del lugar a partir de las coordenadas
    LUGAR=$(curl -s -A "curl" --max-time 3 "https://nominatim.openstreetmap.org/reverse?lat=${LAT}&lon=${LON}&format=json" 2>/dev/null | grep -oE '"(town|city|village|municipality)":"[^"]*"' | head -n1 | cut -d'"' -f4)

    # Traducimos la fecha de inglés a español
    dias=("" "Lunes" "Martes" "Miércoles" "Jueves" "Viernes" "Sábado" "Domingo")
    dia_str="${dias[$(date +%u)]}"
    FECHA="$dia_str, $(date +'%d-%m-%Y')"

    # 3. Procesamos las 24 horas línea a línea
    echo "Hoy $FECHA (${LUGAR:+$LUGAR, }$LAT,$LON):"
    curl -s --max-time 5 "$URL" 2>/dev/null | while IFS=',' read -r fecha_hora temp sens humedad probabilidad_lluvia cantidada_agua viento_10m racha_viento code || [[ -n "$fecha_hora" ]]; do
        if [[ "$fecha_hora" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then
            hora="${fecha_hora#*T}"
            code="${code//[$'\r\n']}"
            desc="${WMO[$code]:-Variable}"

            # Marca la hora actual
            if [[ "$hora" == "$(date +%H:00)" ]]; then hora="[AHORA] ${hora}"; else hora="$hora"; fi

            # Muestra la informacion en pantalla
            echo "${hora} | ${temp}C (${sens}C), (Hum:${humedad}% Prob:${probabilidad_lluvia}% Lluvia:${cantidada_agua}mm) (Viento:${viento_10m}km/h Racha:${racha_viento}km/h), ${desc}"
        fi
        
    done

}
