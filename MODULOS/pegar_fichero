#!/bin/bash
# Modulo: pegar_fichero [destino] - Pega en el destino el fichero o archivo copiado previamente

pegar_fichero() {
    PF_CLIP="/tmp/.cerebro2_clip_fichero"
    PF_DEST="${1:-.}"
    if [[ ! -f "$PF_CLIP" ]]; then
        echo "Error: no hay ningun fichero copiado en el portapapeles"
        test 0 -eq 1
    else
        PF_ORIG=$(<"$PF_CLIP")
        if [[ -f "$PF_ORIG" ]]; then
            if cp "$PF_ORIG" "$PF_DEST"; then echo "Fichero pegado: $PF_ORIG -> $PF_DEST"
            else test 0 -eq 1; fi
        else
            echo "Error: ya no existe el fichero copiado ($PF_ORIG)"
            test 0 -eq 1
        fi
    fi
}
