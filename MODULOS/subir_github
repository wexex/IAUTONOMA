#!/bin/bash
# Modulo: subir_github [mensaje] - Guarda y sube el codigo del proyecto a GitHub

subir_github() {
    source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/CONFIG"
    SUBIR_MSG="${*:-Actualizacion}"
    SUBIR_RUTA="$DIR"
    SUBIR_OK=1

    SUBIR_IGNORAR=(
        "MODELO/" "*.gguf"
        "MEMORIA/"
        "REGISTROS/"

        "TODO_JUNTO" "todo_junto.txt"
        
        "*.log"
        "*.tmp"
    )

    if [[ ! -d "$SUBIR_RUTA" ]]; then
        echo "Error: no existe la carpeta $SUBIR_RUTA"
        SUBIR_OK=0
    elif ! command -v git >/dev/null 2>/dev/null; then
        echo "Error: git no esta instalado en el sistema"
        SUBIR_OK=0
    fi

    if [[ $SUBIR_OK -eq 1 ]]; then
        (
            cd "$SUBIR_RUTA"
            if [[ ! -d ".git" ]]; then
                echo "Error: $SUBIR_RUTA no es un repositorio git"
            else
                if [[ ! -f ".gitignore" ]]; then
                    : > ".gitignore"
                fi

                for SUBIR_ITEM in "${SUBIR_IGNORAR[@]}"; do
                    if ! grep -Fxq "$SUBIR_ITEM" ".gitignore" 2>/dev/null; then
                        printf '%s\n' "$SUBIR_ITEM" >> ".gitignore"
                    fi
                done

                git rm -r --cached --ignore-unmatch "${SUBIR_IGNORAR[@]}" >/dev/null 2>/dev/null
                git add -A

                if git diff --cached --quiet; then
                    echo "Sin cambios nuevos para subir"
                else
                    if git commit -m "$SUBIR_MSG" >/dev/null 2>/dev/null; then
                        SUBIR_RAMA="$(git branch --show-current 2>/dev/null)"
                        if [[ -z "$SUBIR_RAMA" ]]; then
                            SUBIR_RAMA="main"
                        fi
                        if git push -u origin "$SUBIR_RAMA" 2>/dev/null; then
                            echo "Subido a GitHub ($SUBIR_RAMA): $SUBIR_MSG"
                        else
                            echo "Error al hacer git push"
                        fi
                    else
                        echo "Error al crear el commit"
                    fi
                fi
            fi
        )
    fi
}