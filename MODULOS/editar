#!/bin/bash
# Modulo: editar <ruta> <buscar> <reemplazar> - Modifica un fichero reemplazando un texto por otro

editar() {
    local ruta="$1" buscar="$2" reemplazar="$3"
    if [[ -f "$ruta" ]]; then
        local txt
        txt=$(<"$ruta")
        if [[ "$txt" == *"$buscar"* ]]; then
            printf "%s\n" "${txt/"$buscar"/"$reemplazar"}" > "$ruta"
            echo "Editado: $ruta"
        else
            echo "Error: texto no encontrado"
            false
        fi
    else
        echo "Error: no existe $ruta"
        false
    fi
}
