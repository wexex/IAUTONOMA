#!/bin/bash
# Modulo: buscar_texto <texto> [ruta] - Busca en que fichero o parte dice o aparece una palabra, variable o cadena de texto

buscar_texto() {
    if [[ -n "$1" ]]; then
        grep -rn -m 20 "$1" "${2:-.}"
    else
        echo "Error: falta texto a buscar"
        test 0 -eq 1
    fi
}
