#!/bin/bash
# Modulo: renombrar <origen> <destino> - Cambia el nombre de un fichero o carpeta existente

renombrar() {
    if [[ -e "$1" ]]; then
        if mv "$1" "$2"; then echo "Renombrado: $1 -> $2"
        else test 0 -eq 1; fi
    else
        echo "Error: no existe $1"
        test 0 -eq 1
    fi
}
