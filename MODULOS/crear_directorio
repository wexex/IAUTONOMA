#!/bin/bash
# Modulo: crear_dir <ruta> / crear_directorio <ruta> - Crea una carpeta o directorio nuevo

crear_dir() {
    if [[ -n "$1" ]]; then
        if mkdir -p "$1"; then echo "Carpeta: $1"; else test 0 -eq 1; fi
    else
        echo "Error: falta ruta"
        test 0 -eq 1
    fi
}

crear_directorio() { crear_dir "$1"; }
