#!/bin/bash
# Modulo: maquina - Muestra informacion del equipo, usuario, sistema operativo, CPU, memoria RAM y GPU

maquina() {
    echo "Usuario: $(whoami)"
    echo "Equipo: $(hostname)"
    echo "Sistema: $(uname -srm)"

    if [[ -f /proc/cpuinfo ]]; then
        MAQ_CPU_MOD=""
        MAQ_NUCLEOS=0
        while IFS=: read -r MAQ_K MAQ_V; do
            if [[ "$MAQ_K" == model\ name* ]]; then
                if [[ -z "$MAQ_CPU_MOD" ]]; then
                    MAQ_CPU_MOD="${MAQ_V# }"
                fi
            elif [[ "$MAQ_K" == processor* ]]; then
                MAQ_NUCLEOS=$((MAQ_NUCLEOS + 1))
            fi
        done < /proc/cpuinfo
        echo "CPU: $MAQ_CPU_MOD ($MAQ_NUCLEOS nucleos)"
    fi

    if [[ -f /proc/meminfo ]]; then
        MAQ_MEM_TOT=0
        MAQ_MEM_FREE=0
        MAQ_MEM_AVAIL=0
        while read -r MAQ_K MAQ_VAL _; do
            if [[ "$MAQ_K" == "MemTotal:" ]]; then
                MAQ_MEM_TOT=$((MAQ_VAL / 1024))
            elif [[ "$MAQ_K" == "MemFree:" ]]; then
                MAQ_MEM_FREE=$((MAQ_VAL / 1024))
            elif [[ "$MAQ_K" == "MemAvailable:" ]]; then
                MAQ_MEM_AVAIL=$((MAQ_VAL / 1024))
            fi
        done < /proc/meminfo
        if [[ $MAQ_MEM_AVAIL -gt 0 ]]; then
            MAQ_MEM_FREE=$MAQ_MEM_AVAIL
        fi
        MAQ_MEM_USADA=$((MAQ_MEM_TOT - MAQ_MEM_FREE))
        echo "RAM: ${MAQ_MEM_USADA} MB usados / ${MAQ_MEM_TOT} MB total (${MAQ_MEM_FREE} MB libres)"
    fi

    if type -P nvidia-smi >/dev/null 2>/dev/null; then
        echo "GPU: $(nvidia-smi --query-gpu=name,memory.used,memory.total,memory.free --format=csv,noheader)"
    else
        echo "GPU: No detectada"
    fi
}
