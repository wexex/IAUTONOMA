#!/bin/bash
# Modulo: pegar_directorio [destino] - Pega en el destino la carpeta o directorio copiado previamente

pegar_directorio() {
    PD_CLIP="/tmp/.cerebro2_clip_directorio"
    PD_DEST="${1:-.}"
    if [[ ! -f "$PD_CLIP" ]]; then
        echo "Error: no hay ningun directorio copiado en el portapapeles"
        test 0 -eq 1
    else
        PD_ORIG=$(<"$PD_CLIP")
        if [[ -d "$PD_ORIG" ]]; then
            if cp -r "$PD_ORIG" "$PD_DEST"; then echo "Directorio pegado: $PD_ORIG -> $PD_DEST"
            else test 0 -eq 1; fi
        else
            echo "Error: ya no existe el directorio copiado ($PD_ORIG)"
            test 0 -eq 1
        fi
    fi
}
