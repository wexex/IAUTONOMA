#!/bin/bash
# Modulo: skill [nombre] - Lista o lee las guias de la carpeta SKILLS (usa "skill" para listar las skills o "skill <nombre>" para leer una skill)

skill() {
    base="$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/SKILLS"
    arg_sk="$1"
    listar_skills() {
        echo "Unicas skills disponibles en la carpeta SKILLS/ (no confundir con los modulos de bash):"
        for arch_l in "$base"/*; do
            if [[ -f "$arch_l" ]]; then
                nom_l="$(basename "$arch_l")"
                tit_l="$(head -n 1 "$arch_l" 2>/dev/null)"
                echo "- ${nom_l%.*} ($nom_l): $tit_l"
            fi
        done
    }
    if [[ -z "$arg_sk" ]]; then
        listar_skills
    elif [[ "$arg_sk" == -* ]]; then
        listar_skills
    elif [[ "${arg_sk,,}" == "list"* ]]; then
        listar_skills
    elif [[ "${arg_sk,,}" == "skills" ]]; then
        listar_skills
    else
        encontrado=0
        for ext in "" ".txt" ".md"; do
            if [[ -f "$base/$arg_sk$ext" ]]; then
                cat "$base/$arg_sk$ext"
                encontrado=1
                break
            fi
        done
        if [[ $encontrado -eq 0 ]]; then
            for arch_s in "$base"/*; do
                if [[ -f "$arch_s" ]]; then
                    nom_s="$(basename "$arch_s")"
                    if [[ "${nom_s,,}" == *"${arg_sk,,}"* ]]; then
                        cat "$arch_s"
                        encontrado=1
                        break
                    fi
                fi
            done
        fi
        if [[ $encontrado -eq 0 ]]; then
            listar_skills
        fi
    fi
}
