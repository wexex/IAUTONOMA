if [[ "${MODO_INTERNO:-0}" -eq 0 ]]; then
    TS_FIN_MS=$(date +%s%3N 2>/dev/null)
    if [[ ! "$TS_FIN_MS" =~ ^[0-9]+$ ]]; then TS_FIN_MS=$(($(date +%s) * 1000)); fi
    LAT_MS=$((TS_FIN_MS - TS_INI_MS))
    if [[ $LAT_MS -lt 1 ]]; then LAT_MS=1; fi
    AMIG_PREV="{}"
    if [[ -s "$AMIGDALA" ]]; then
        AMIG_PREV=$(cat "$AMIGDALA" 2>/dev/null)
        if [[ -z "$AMIG_PREV" ]]; then AMIG_PREV="{}"; fi
    fi
    AMIG_NUEVA=$(jq -a -c \
        --arg f "$FECHA_AHORA" \
        --argjson ts "$TS_AHORA" \
        --argjson lat "$LAT_MS" \
        --argjson val "${VALENCIA_TURNO:-0}" \
        --argjson alr "${ALERTA_TURNO:-0}" \
        --arg amot "$ALERTA_MOTIVO" \
        --argjson cdisp "${CRIT_DISP:-0}" \
        --argjson ccorr "${CRIT_CORR:-0}" \
        --arg cmot "$CRIT_MOT" \
        --argjson maxf "${MAX_FRUSTRACION:-3}" '
        (if ((.lat_media_ms // 0) > 0) then (((.lat_media_ms * 0.8) + ($lat * 0.2)) | round) else $lat end) as $med |
        (if $med > 0 then ((($lat / $med) * 100 | round) / 100) else 1.0 end) as $fat |
        (
            if $val < 0 then
                (((.frustracion // 0) + 1) | if . > $maxf then $maxf else . end)
            elif $val > 0 then
                0
            else
                (.frustracion // 0)
            end
        ) as $fr |
        . + {
            fecha: $f,
            ts: $ts,
            lat_actual_ms: $lat,
            lat_media_ms: $med,
            fatiga: $fat,
            frustracion: $fr,
            ultima_valencia: $val,
            alerta: $alr,
            alerta_motivo: $amot,
            critico_disparado: $cdisp,
            critico_corrigio: $ccorr,
            critico_motivo: $cmot
        }
    ' < <(printf '%s' "$AMIG_PREV") 2>/dev/null)
    if [[ -n "$AMIG_NUEVA" ]]; then
        mkdir -p "$DIR_MEMORIA"
        printf '%s\n' "$AMIG_NUEVA" > "${AMIGDALA}.$$.tmp"
        mv -f "${AMIGDALA}.$$.tmp" "$AMIGDALA" 2>/dev/null
    fi
fi

if [[ -n "$ETIQUETAS_TOOLS" ]]; then
    if [[ -n "$TEXTO_FINAL" ]]; then
        if [[ "${VALENCIA_TURNO:-0}" -ge 0 ]]; then
            if [[ -n "${ARCH_TRAZA_TOOL:-}" ]]; then
            TRAZA_JSON=$(jq -a -c --arg txt "$TEXTO_FINAL" '
                if any(.[ ]; .role == "tool" and (((.content // "") | startswith("BLOQUEADO:")) or ((.content // "") | startswith("[AMIGDALA_ALERTA:")) or ((.content // "") | startswith("Error: herramienta no disponible")))) then
                    empty
                else
                    [
                        to_entries[ ] |
                        if (.key == 0 and .value.role == "user") then
                            {
                                role: "user",
                                content: ((.value.content // "") | sub("^\\[[^\\]]+\\] <<[^>]+>> *"; ""))
                            }
                        elif (.value.role == "assistant" and .value.tool_calls != null) then
                            {
                                role: "assistant",
                                content: (.value.content // ""),
                                tool_calls: [
                                    .value.tool_calls[ ] |
                                    {
                                        id: (.id // "call_1"),
                                        type: (.type // "function"),
                                        function: {
                                            name: (.function.name // "bash"),
                                            arguments: (if (.function.arguments | type) == "string" then .function.arguments else (.function.arguments | tojson) end)
                                        }
                                    }
                                ]
                            }
                        elif .value.role == "tool" then
                            {
                                role: "tool",
                                tool_call_id: (.value.tool_call_id // "call_1"),
                                name: (.value.name // "bash"),
                                content: (.value.content // "")
                            }
                        else
                            .value
                        end
                    ] + [{"role": "assistant", "content": $txt}]
                end
            ' < <(printf '%s' "$MENSAJES_TURNO") 2>/dev/null)
            if [[ -n "$TRAZA_JSON" ]]; then
                printf '%s\n' "$TRAZA_JSON" > "$ARCH_TRAZA_TOOL" 2>/dev/null
            fi
        fi
        fi
    fi
    printf '%s%s\n' "$ETIQUETAS_TOOLS" "$TEXTO_FINAL"
else
    echo "$TEXTO_FINAL"
fi
