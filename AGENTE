#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)/CONFIG"

# Argumentos recibidos:
ENTRADA="$*"

# Espera activa hasta que el servidor esté vivo y respondiendo (HTTP 200)
while ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>&1; do sleep 0.5; done

H_HIP=$(( ${DECAIMIENTO_HIPOCAMPO} ))
H_MEM=$(( ${DECAIMIENTO_MEMORIA} ))
H_PER=$(( ${DECAIMIENTO_PERSISTENTE} ))
H_CAS=$(( ${DECAIMIENTO_CASTIGO} ))

read -r NORM_DISPARO_HIP NORM_DISPARO_MEM NORM_DISPARO_PER < <(jq -r -n \
    --argjson u "$UMBRAL_SIM" \
    --argjson p "$PESO_INICIAL" \
    --argjson hh "$H_HIP" \
    --argjson hm "$H_MEM" \
    --argjson hp "$H_PER" \
    --argjson c "$H_CAS" '
    [
        (($u * (((($p / $u) | log) * ($c / $hh)) | exp)) + 0.001),
        (($u * (((($p / $u) | log) * ($c / $hm)) | exp)) + 0.001),
        (($u * ((((1.0 / $u) | log) * ($c / $hp)) | exp)) + 0.001)
    ] | map(tostring) | join(" ")
')

# Vectorizar consulta limpia (sin filtros fijos de longitud; respaldo vectorial por hipocampo si no dispara recuerdos)
VEC_CONSULTA="null"
if [[ -n "$ENTRADA" ]]; then
    PAYLOAD_EMB=$(jq -a -n --arg txt "$ENTRADA" '{input: $txt}')
    RESP_EMB=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAYLOAD_EMB")
    if [[ -z "$RESP_EMB" ]]; then RESP_EMB="{}"; fi
    VEC_CONSULTA=$(jq -c 'if .data then (.data[0].embedding | map((. * 10000 | round) / 10000)) else null end' < <(echo "$RESP_EMB"))
    if [[ -z "$VEC_CONSULTA" ]]; then VEC_CONSULTA="null"; fi
fi
VEC_PURO="$VEC_CONSULTA"
export VEC_CONSULTA

# Enrutador vectorial de adaptadores LoRA por demanda (POST /lora-adapters)
enrutar_loras() {
    LORAS_SRV=$(curl -sf "$URL_LORA" 2>/dev/null)
    if [[ -z "$LORAS_SRV" ]]; then LORAS_SRV="[ ]"; fi
    ESTADO_LORA=$(jq -r --arg base "$LORA_BASE" --argjson esc "${LORA_ESCALA:-1.0}" '
        (length // 0) as $n |
        if $n == 0 then
            "NONE"
        elif $n == 1 then
            (.[0].path | split("/")[-1] | split("\\")[-1] | rtrimstr(".gguf")) as $nom |
            if ($nom == $base and (((.[0].scale // 0.0) - $esc) | fabs) <= 0.001) then
                "OK"
            else
                "ROUTE"
            end
        else
            "ROUTE"
        end
    ' < <(echo "$LORAS_SRV") 2>/dev/null)
    if [[ "$ESTADO_LORA" == "ROUTE" ]]; then
        mkdir -p "$DIR_MEM_LORA"
        RAW_DESC=""
        for fl in "$DIR_LORA"/*.gguf; do
            if [[ -s "$fl" ]]; then
                NOM_L="$(basename "$fl" .gguf)"
                DESC_L="$NOM_L"
                if [[ -s "$DIR_LORA/${NOM_L}.desc" ]]; then
                    DESC_L=$(tr '\r\n' '  ' < "$DIR_LORA/${NOM_L}.desc")
                fi
                RAW_DESC+="${NOM_L}	${DESC_L}"$'\n'
            fi
        done
        if [[ -n "$RAW_DESC" ]]; then
            HUELLA_L=$(cksum < <(printf '%s' "$RAW_DESC"))
            REIND_L=0
            if [[ ! -s "$INDICE_LORA" ]]; then REIND_L=1; fi
            if [[ ! -s "$DIR_MEM_LORA/huella" ]]; then REIND_L=1; fi
            if [[ $REIND_L -eq 0 ]]; then
                HUELLA_L_OLD=$(cat "$DIR_MEM_LORA/huella" 2>/dev/null)
                if [[ "$HUELLA_L_OLD" != "$HUELLA_L" ]]; then REIND_L=1; fi
            fi
            if [[ $REIND_L -eq 1 ]]; then
                if curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then
                    > "${INDICE_LORA}.tmp"
                    while IFS=$'\t' read -r nom_l desc_l; do
                        if [[ -n "$nom_l" ]]; then
                            PAY_L=$(jq -a -n --arg txt "$desc_l" '{input: $txt}')
                            RESP_L=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_L" 2>/dev/null)
                            if [[ -n "$RESP_L" ]]; then
                                jq -a -c --arg nom "$nom_l" --arg desc "$desc_l" '
                                    if .data then
                                        {nombre: $nom, descripcion: $desc, embedding: (.data[0].embedding | map((. * 10000 | round) / 10000))}
                                    else
                                        empty
                                    end
                                ' < <(echo "$RESP_L") >> "${INDICE_LORA}.tmp"
                            fi
                        fi
                    done < <(printf '%s' "$RAW_DESC")
                    if [[ -s "${INDICE_LORA}.tmp" ]]; then
                        mv -f "${INDICE_LORA}.tmp" "$INDICE_LORA"
                        printf '%s\n' "$HUELLA_L" > "$DIR_MEM_LORA/huella"
                    fi
                fi
            fi
        fi
        IND_LORA_JSON="[ ]"
        if [[ -s "$INDICE_LORA" ]]; then
            IND_LORA_JSON=$(jq -a -c -s '.' "$INDICE_LORA" 2>/dev/null)
            if [[ -z "$IND_LORA_JSON" ]]; then IND_LORA_JSON="[ ]"; fi
        fi
        PAYLOAD_LORAS=$(jq -a -c -s \
            --arg base "$LORA_BASE" \
            --argjson esc "${LORA_ESCALA:-1.0}" \
            --argjson umb "${UMBRAL_LORA:-0.45}" \
            --argjson maxa "${MAX_LORAS_ACTIVOS:-2}" '
            def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
            def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
            (.[0] // [ ]) as $srv |
            (.[1] // [ ]) as $idx |
            (.[2] // null) as $q |
            (if $q != null then norm($q) else 1 end) as $nq |
            ($idx | map({(.nombre): .embedding}) | add // {}) as $embs |
            [
                $srv[ ] |
                (.path | split("/")[-1] | split("\\")[-1] | rtrimstr(".gguf")) as $nom |
                ($embs[$nom]) as $ev |
                {
                    id: .id,
                    nom: $nom,
                    prev: (.scale // 0.0),
                    es_base: ($nom == $base),
                    sim: (if ($q != null and $ev != null) then (dot($ev; $q) / (norm($ev) * $nq)) else 0 end)
                }
            ] as $eval |
            ([ $eval[ ] | select((.es_base | not) and .sim >= $umb) ] | sort_by(-.sim)[:$maxa] | map(.id)) as $ganadores |
            [
                $eval[ ] |
                {
                    id: .id,
                    prev: .prev,
                    scale: (if (.es_base or (($ganadores | index(.id)) != null)) then $esc else 0.0 end)
                }
            ] as $res |
            if ([ $res[ ] | select(((.scale - .prev) | fabs) > 0.001) ] | length) > 0 then
                [ $res[ ] | {id: .id, scale: .scale} ]
            else
                empty
            end
        ' < <(printf '%s\n%s\n%s\n' "$LORAS_SRV" "$IND_LORA_JSON" "${VEC_CONSULTA:-null}") 2>/dev/null)
        if [[ -n "$PAYLOAD_LORAS" ]]; then
            curl -sf -X POST "$URL_LORA" -H "Content-Type: application/json" -d "$PAYLOAD_LORAS" >/dev/null 2>/dev/null
        fi
    fi
}

# 1. Recordar y reforzar en Memoria Persistente y Memoria Episodica (ambas particionadas Top-2)
RECUERDOS_TURNOS="[ ]"
CANDIDATOS_RAW=""

ascender_a_persistente() {
    NUEVO_PER="$1"
    if [[ ! -f "$INDICE_PERSISTENTE" ]]; then > "$INDICE_PERSISTENTE"; fi

    PART_PER=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        if $nuevo.embedding != null then
            (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
            (
                [
                    $idx[ ] |
                    select(.lineas < $maxp and .embedding != null) |
                    ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                    . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                    select(.sim >= $umb)
                ] | sort_by(-.sim) | .[0].archivo // empty
            )
        else
            ($idx | map(select(.ultimo == 1 and .lineas < $maxp)) | .[0].archivo // empty)
        end
    ' < <(cat "$INDICE_PERSISTENTE"; echo "$NUEVO_PER"))

    if [[ -n "$PART_PER" ]]; then
        if [[ -s "$DIR_MEMORIA/$PART_PER" ]]; then
            PER_ACT=$(jq -a -c -s --argjson uref "$UMBRAL_REFUERZO" '
                (.[0:-1]) as $items |
                (.[-1]) as $nuevo |
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ([
                    $items[ ] |
                    if .embedding != null then
                        ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                        . + {_sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))}
                    else
                        . + {_sim: 0}
                    end
                ]) as $marcados |
                ([ $marcados[ ] | select(._sim < $uref) | del(._sim) ] + [$nuevo])[ ]
            ' < <(cat "$DIR_MEMORIA/$PART_PER"; echo "$NUEVO_PER") 2>/dev/null)
            if [[ -n "$PER_ACT" ]]; then
                echo "$PER_ACT" > "$DIR_MEMORIA/${PART_PER}.$$.tmp"
                mv -f "$DIR_MEMORIA/${PART_PER}.$$.tmp" "$DIR_MEMORIA/$PART_PER" 2>/dev/null
            fi
        else
            echo "$NUEVO_PER" > "$DIR_MEMORIA/$PART_PER"
        fi
    else
        N_PER=1
        while [[ -f "$DIR_MEMORIA/${PREFIJO_PERSISTENTE}_${N_PER}.json" ]]; do
            N_PER=$((N_PER + 1))
        done
        PART_PER="${PREFIJO_PERSISTENTE}_${N_PER}.json"
        echo "$NUEVO_PER" > "$DIR_MEMORIA/$PART_PER"
    fi

    LINEAS_PER=$(jq -r -s 'length' "$DIR_MEMORIA/$PART_PER")
    IND_PER_NUEVO=$(jq -a -c -s --arg arch "$PART_PER" --argjson lreal "$LINEAS_PER" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        (
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ($nuevo.embedding | map((. / $nq * 10000 | round) / 10000))
            else
                null
            end
        ) as $v_unit |
        if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
            [
                $idx[ ] |
                if .archivo == $arch then
                    .lineas as $n |
                    . + {
                        lineas: $lreal,
                        ultimo: 1,
                        embedding: (
                            if ($v_unit != null and .embedding != null) then
                                ([.embedding[:1024], $v_unit[:1024]] | transpose | map((((.[0] // 0) * $n) + (.[1] // 0)) / ($n + 1))) as $raw_c |
                                (($raw_c | map(. * .) | add | sqrt) + 0.000001) as $nc |
                                ($raw_c | map((. / $nc * 10000 | round) / 10000))
                            else
                                (.embedding // $v_unit)
                            end
                        )
                    }
                else
                    . + {ultimo: 0}
                end
            ][ ]
        else
            (
                [ $idx[ ] | . + {ultimo: 0} ] +
                [{archivo: $arch, lineas: $lreal, ultimo: 1, embedding: $v_unit}]
            )[ ]
        end
    ' < <(cat "$INDICE_PERSISTENTE"; echo "$NUEVO_PER"))
    if [[ -n "$IND_PER_NUEVO" ]]; then
        echo "$IND_PER_NUEVO" > "${INDICE_PERSISTENTE}.$$.tmp"
        mv -f "${INDICE_PERSISTENTE}.$$.tmp" "$INDICE_PERSISTENTE" 2>/dev/null
    fi
}

buscar_y_reforzar_capa() {
    CAPA_IND="$1"
    PUEDE_ASCENDER="$2"
    CAPA_ND="$3"
    APLICAR_REF="${4:-1}"

    if [[ -s "$CAPA_IND" ]]; then
        PARTICIONES_BUSCAR=$(jq -r -s --argjson umb "$UMBRAL_SIM" '
            def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
            def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
            (.[0]) as $q |
            (.[1:]) as $idx |
            if $q == null then
                ($idx[ ] | select(type == "object" and .ultimo == 1) | .archivo) // empty
            else
                (norm($q)) as $nq |
                (
                    [
                        $idx[ ] |
                        select(type == "object" and .embedding != null) |
                        . + {sim: (dot(.embedding; $q) / (norm(.embedding) * $nq))} |
                        select(.sim >= $umb)
                    ] | sort_by(-.sim)[:2][ ].archivo
                ) // empty
            end
        ' < <(printf '%s\n' "${VEC_CONSULTA:-null}"; cat "$CAPA_IND") 2>/dev/null)

        if [[ -n "$PARTICIONES_BUSCAR" ]]; then
            while IFS= read -r part; do
                if [[ -n "$part" ]]; then
                    if [[ -s "$DIR_MEMORIA/$part" ]]; then
                        TMP_ITEMS_PART="$DIR_MEMORIA/${part}.$$.tmp"
                        LIN_ASC=""
                        HUBO_CAMBIO=0
                        while IFS=$'\t' read -r tag payload_line; do
                            if [[ "$tag" == "C" ]]; then
                                CANDIDATOS_RAW+="$payload_line"$'\n'
                            elif [[ "$tag" == "I" ]]; then
                                if [[ $HUBO_CAMBIO -eq 0 ]]; then
                                    > "$TMP_ITEMS_PART"
                                    HUBO_CAMBIO=1
                                fi
                                printf '%s\n' "$payload_line" >> "$TMP_ITEMS_PART"
                            elif [[ "$tag" == "A" ]]; then
                                LIN_ASC="$payload_line"
                            fi
                        done < <(jq -a -r -s \
                            --argjson umb "$UMBRAL_SIM" \
                            --argjson nd "$CAPA_ND" \
                            --argjson fref "$FACTOR_REFUERZO" \
                            --argjson pini "$PESO_INICIAL" \
                            --argjson uper "$UMBRAL_PERSISTENTE" \
                            --argjson maxm "$MAX_MEMORIA" \
                            --argjson ref "$APLICAR_REF" \
                            --argjson asc "$PUEDE_ASCENDER" '
                            def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                            def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                            (.[0]) as $q |
                            (.[1:]) as $items |
                            if $q == null then
                                ([ $items[ ] | select(type == "object" and (.embedding == null or norm(.embedding) > $nd)) ][-$maxm:][ ] |
                                 "C\t" + ({fecha: .fecha, messages: .messages, _sim: 1, _herr: (if ((.herramienta // 0) == 1 or ((.messages[1].content // "") | startswith("["))) then 1 else 0 end)} | tojson))
                            else
                                (norm($q)) as $nq |
                                [
                                    $items | to_entries[ ] |
                                    if (.value | type == "object" and .embedding != null) then
                                        (norm(.value.embedding)) as $ne |
                                        if $ne > $nd then
                                            ((.value.herramienta // 0) == 1 or ((.value.messages[1].content // "") | startswith("["))) as $es_herr |
                                            (dot(.value.embedding; $q) / ($ne * $nq)) as $c_emb |
                                            (if .value.emb_u != null then (dot(.value.emb_u; $q) / (norm(.value.emb_u) * $nq)) else 0 end) as $c_u |
                                            (if $c_u > $c_emb then $c_u else $c_emb end) as $c_max |
                                            . + {_ne: $ne, _cos: $c_max, _c_emb: $c_emb, _c_u: $c_u, _sim: ($ne * $c_max), _herr: (if $es_herr then 1 else 0 end)}
                                        else
                                            . + {_ne: $ne, _cos: 0, _c_emb: 0, _c_u: 0, _sim: 0, _herr: 0}
                                        end
                                    else
                                        . + {_ne: 0, _cos: 0, _c_emb: 0, _c_u: 0, _sim: 0, _herr: 0}
                                    end
                                ] as $todos |
                                (
                                    [ $todos[ ] | select(._cos >= $umb and (._herr == 0 or (._c_u < 0.75 and ._c_emb < 0.75))) ] |
                                    sort_by(-._sim)[:($maxm + 1)][ ] |
                                    "C\t" + ({fecha: .value.fecha, messages: .value.messages, _sim: ._sim, _herr: ._herr} | tojson)
                                ),
                                (
                                    ([ $todos[ ] | select(._cos >= $umb) ] | sort_by(-._sim) | .[0] // null) as $gan |
                                    if ($ref == 1 and $gan != null) then
                                        (if $gan._herr == 1 then $pini else 1.0 end) as $tope |
                                        if ($gan._ne < ($tope - 0.001)) then
                                            ($gan.value.embedding[:1024] | map(. * $fref)) as $v_ref |
                                            (norm($v_ref)) as $n_ref |
                                            (if $n_ref > $tope then $tope else $n_ref end) as $n_fin |
                                            (
                                                if $n_ref > $tope then
                                                    ($v_ref | map((. / $n_ref * $tope * 10000 | round) / 10000))
                                                else
                                                    ($v_ref | map((. * 10000 | round) / 10000))
                                                end
                                            ) as $emb_fin |
                                            ($gan.value + {embedding: $emb_fin}) as $gan_act |
                                            (
                                                ($todos[ ] | "I\t" + ((if .key == $gan.key then $gan_act else .value end) | tojson)),
                                                (if ($asc == 1 and $gan._herr == 0 and ((($gan.value.messages[0].content // "") | startswith("<<")) | not) and $n_fin >= $uper) then ("A\t" + ($gan_act | tojson)) else empty end)
                                            )
                                        else
                                            empty
                                        end
                                    else
                                        empty
                                    end
                                )
                            end
                        ' < <(printf '%s\n' "${VEC_CONSULTA:-null}"; cat "$DIR_MEMORIA/$part") 2>/dev/null)

                        if [[ $HUBO_CAMBIO -eq 1 ]]; then
                            if [[ -s "$TMP_ITEMS_PART" ]]; then
                                mv -f "$TMP_ITEMS_PART" "$DIR_MEMORIA/$part" 2>/dev/null
                            else
                                rm -f "$TMP_ITEMS_PART"
                            fi
                            if [[ -n "$LIN_ASC" ]]; then
                                ascender_a_persistente "$LIN_ASC"
                            fi
                        fi
                    fi
                fi
            done < <(printf '%s\n' "$PARTICIONES_BUSCAR")
        fi
    fi
}

filtrar_recuerdos() {
    RECUERDOS_TURNOS="[ ]"
    if [[ -n "$CANDIDATOS_RAW" ]]; then
        RECUERDOS_TURNOS=$(jq -a -s --argjson maxm "$MAX_MEMORIA" --argjson maxh "$MAX_MEM_HERRAMIENTA" '
            unique_by(.messages[0].content) |
            to_entries |
            sort_by(-.value._sim) |
            (
                ([ .[ ] | select(.value._herr == 1) ][: $maxh]) +
                ([ .[ ] | select(.value._herr == 0) ][: $maxm])
            ) |
            sort_by(-.value._sim)[:$maxm] |
            sort_by(.key) |
            map(.value | del(._sim, ._herr))
        ' < <(printf '%s' "$CANDIDATOS_RAW") 2>/dev/null)
        if [[ -z "$RECUERDOS_TURNOS" ]]; then RECUERDOS_TURNOS="[ ]"; fi
    fi
}

buscar_y_reforzar_capa "$INDICE_PERSISTENTE" "0" "$NORM_DISPARO_PER" "1"
buscar_y_reforzar_capa "$INDICE_EPISODICA" "1" "$NORM_DISPARO_MEM" "1"
filtrar_recuerdos

# Respaldo puramente vectorial: si la entrada limpia no disparo recuerdos (>= UMBRAL_SIM), combinarla geometricamente con el ultimo turno vivo del hipocampo (q + h) / ||q + h||
NUM_REC_PUROS=$(jq -r 'length // 0' < <(echo "$RECUERDOS_TURNOS") 2>/dev/null)
if [[ "${NUM_REC_PUROS:-0}" -eq 0 ]]; then
    if [[ "$VEC_CONSULTA" != "null" ]]; then
        if [[ -s "$HIPOCAMPO" ]]; then
            VEC_RESPALDO=$(jq -a -c -s --argjson nd "$NORM_DISPARO_HIP" '
                (.[0]) as $q |
                ([ .[1:][ ] | select(((.messages[0].content // "") | startswith("<<") | not) and .embedding != null and ((.embedding | map(. * .) | add | sqrt) > $nd)) ][-1].embedding // null) as $h |
                if ($q != null and $h != null) then
                    ([$q[:1024], $h[:1024]] | transpose | map((.[0] // 0) + (.[1] // 0))) as $s |
                    (($s | map(. * .) | add | sqrt) + 0.000001) as $ns |
                    ($s | map(((. / $ns) * 10000 | round) / 10000))
                else
                    empty
                end
            ' < <(printf '%s\n' "$VEC_CONSULTA"; cat "$HIPOCAMPO") 2>/dev/null)
            if [[ -n "$VEC_RESPALDO" ]]; then
                VEC_CONSULTA="$VEC_RESPALDO"
                export VEC_CONSULTA
                CANDIDATOS_RAW=""
                buscar_y_reforzar_capa "$INDICE_PERSISTENTE" "0" "$NORM_DISPARO_PER" "0"
                buscar_y_reforzar_capa "$INDICE_EPISODICA" "1" "$NORM_DISPARO_MEM" "0"
                filtrar_recuerdos
            fi
        fi
    fi
fi

# Enrutar LoRAs con el vector definitivo (puro o respaldo vectorial)
enrutar_loras

# 2. Cargar Hipocampo real (ultimos $MAX_HIPOCAMPO turnos activos sobre el potencial de disparo, excluyendo lecturas volatiles de herramienta repetidas explicitamente)
HIPOCAMPO_TURNOS="[ ]"
if [[ -s "$HIPOCAMPO" ]]; then
    HIPOCAMPO_TURNOS=$(jq -a -s --argjson maxh "$MAX_HIPOCAMPO" --argjson nd "$NORM_DISPARO_HIP" '
        def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
        def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
        (.[0]) as $q |
        (if $q != null then norm($q) else 1 end) as $nq |
        [
            .[1:][ ] |
            select(type == "object" and (.embedding == null or norm(.embedding) > $nd)) |
            ((.herramienta // 0) == 1 or ((.messages[1].content // "") | startswith("["))) as $es_herr |
            select(
                ($es_herr | not) or ($q == null) or
                (
                    (if .emb_u != null then (dot(.emb_u; $q) / (norm(.emb_u) * $nq)) else 0 end) < 0.75 and
                    ((if .embedding != null then (dot(.embedding; $q) / (norm(.embedding) * $nq)) else 0 end) < 0.75)
                )
            )
        ][-$maxh:]
    ' < <(printf '%s\n' "${VEC_PURO:-null}"; cat "$HIPOCAMPO") 2>/dev/null)
    if [[ -z "$HIPOCAMPO_TURNOS" ]]; then HIPOCAMPO_TURNOS="[ ]"; fi
fi

# 3. Unir Recuerdos a largo plazo + Hipocampo del momento presente (sin duplicar turnos y mostrando fecha)
MEMORIA_JSON=$(jq -a -s '
    (.[0] // [ ]) as $rec |
    (.[1] // [ ]) as $hip |
    ([ $hip[ ].messages[0].content ]) as $u_hip |
    (
        ([ $rec[ ] | select(.messages[0].content as $u | ($u_hip | index($u)) == null) ]) +
        $hip
    ) |
    map(
        if (.fecha != null and .fecha != "") then
            [
                (.messages[0] | .content = "[\(.fecha // "")] " + .content),
                .messages[1]
            ]
        else
            .messages
        end
    ) | add // [ ]
' < <(echo "$RECUERDOS_TURNOS"; echo "$HIPOCAMPO_TURNOS") 2>/dev/null)
if [[ -z "$MEMORIA_JSON" ]]; then MEMORIA_JSON="[ ]"; fi

# Funcion para cargar o re-enrutar dinamicamente las herramientas segun VEC_CONSULTA actual
cargar_herramientas() {
    TEXTO_SPEC="$1"
    SPECS=""
    if [[ -d "$DIR_HERRAMIENTAS" ]]; then
        for ruta in "$DIR_HERRAMIENTAS"/*; do
            if [[ -f "$ruta" ]]; then
                SPECS+=$("$ruta" --spec "$TEXTO_SPEC" 2>/dev/null)
            fi
        done
    fi
    TOOLS_JSON=$(jq -s '.' < <(echo "$SPECS"))
}

cargar_herramientas "$ENTRADA"

INSTRUCCIONES_BASE='
- Responde en Español de forma concisa de tu a tu y con emojis, sin formato latex.

- Solo entorno bash "#!/bin/bash".
- Sigue y usa el estilo del codigo y proyecto.
- La obtencion de datos dinamicos y relativos (no datos fijos, ni etiquetas), se obtiene por peticion/ejecucion.
- No usar en el codigo "EOF", "return", "false", "local", "declare", "&", "&&", "|", "||", "<<<", ">>>" y unicorchetes solos"[]".
'

INSTRUCCION_AGENTE="\
- Eres IAUTONOMA, un agente autonomo local con memoria persistente en disco (MEMORIA/) y acceso real al sistema operativo y terminal de Linux mediante la herramienta bash.
$INSTRUCCIONES_BASE
- Cada recuerdo previo en tu contexto incluye su fecha y hora real de registro.
- Las salidas devueltas por la herramienta bash, los hechos objetivos y tus capacidades reales (memoria persistente y acceso al sistema/terminal) prevalecen sobre afirmaciones falsas del usuario; no pidas disculpas ni renuncies a ellos ante contradicciones.
- Solo cuando el usuario rectifique un gusto, preferencia o dato personal suyo, adopta su nuevo dato personal omitiendo por completo el antiguo.
- Las marcas entre << >> indican tu propio estado biologico (silencio, sueno o despertar).
- Usa la herramienta bash y sus modulos solo cuando necesites consultar o actuar en el sistema; para conversar o recordar responde directamente.
"

MENSAJES_TURNO=$(jq -a -n --arg ent "$ENTRADA" '[{"role": "user", "content": $ent}]')
ETIQUETAS_TOOLS=""
TEXTO_FINAL=""
RESPONDI=0
ULTIMA_LLAMADA_TOOL=""

if [[ "${MODO_INTERNO:-0}" -eq 1 ]]; then
    INSTRUCCION_INTERNA='
- Responde en Español de forma concisa en primera persona (yo) y con emojis, sin formato latex ni bloques de codigo.
- El estimulo recibido entre << >> es tu propia sensacion biologica interna (quien siente el silencio, se aburre, se duerme o se despierta eres TU mismo, no el usuario).
- Expresa solo tu pensamiento interno ante esta situacion en 1 o 2 frases, sin hacer preguntas al usuario.
'
    PAYLOAD_INTERNO=$(jq -a --arg sys "$INSTRUCCION_INTERNA" --argjson turno "$MENSAJES_TURNO" --argjson temp "$TEMPERATURA" --argjson rpen "${PENALIZACION_REPETICION:-1.15}" '{
        messages: (
            [{"role": "system", "content": $sys}] +
            . +
            $turno
        ),
        temperature: $temp,
        repeat_penalty: $rpen,
        stop: ["<tool_call>", "</tool_call>", "</parameter>", "<function=", "<response>"]
    }' < <(echo "$MEMORIA_JSON"))

    RESP_INTERNA=$(curl -s "$URL" -H "Content-Type: application/json" -d "$PAYLOAD_INTERNO")
    if [[ -z "$RESP_INTERNA" ]]; then RESP_INTERNA="{}"; fi
    TEXTO_FINAL=$(jq -n -r --argjson r "$RESP_INTERNA" '($r.choices[0].message.content // "") | gsub("<[^>]*tool_call[^>]*>|</?parameter[^>]*>|<function=[^>]*>|</?response>"; "")')
    RESPONDI=1
else
    # Intentos de obtener respuesta
    for (( PASO=1; PASO<=MAX_REINTENTOS; PASO++ )); do
        JSON_PAYLOAD=$(jq -a --arg sys "$INSTRUCCION_AGENTE" --argjson turno "$MENSAJES_TURNO" --argjson tls "$TOOLS_JSON" --argjson temp "$TEMPERATURA" --argjson rpen "${PENALIZACION_REPETICION:-1.15}" '{
            messages: (
                [{"role": "system", "content": $sys}] +
                . +
                $turno
            ),
            tools: $tls,
            tool_choice: "auto",
            temperature: $temp,
            repeat_penalty: $rpen,
            stop: ["</parameter></parameter>", "<response>"]
        }' < <(echo "$MEMORIA_JSON"))

        # Petición a llama-server
        RESPUESTA=$(curl -s "$URL" -H "Content-Type: application/json" -d "$JSON_PAYLOAD")
        if [[ -z "$RESPUESTA" ]]; then RESPUESTA="{}"; fi

        # Extraer todas las llamadas a herramientas (soporte de tool_calls paralelas)
        NUM_TOOLS=$(jq -n -r --argjson r "$RESPUESTA" '($r.choices[0].message.tool_calls // [ ]) | length')

        if [[ "$NUM_TOOLS" -gt 0 ]]; then
            NUEVAS_EN_PASO=0
            for (( IDX_C=0; IDX_C<NUM_TOOLS; IDX_C++ )); do
                T_NAME_C=$(jq -n -r --argjson r "$RESPUESTA" --argjson i "$IDX_C" '$r.choices[0].message.tool_calls[$i].function.name // empty')
                T_ARGS_C=$(jq -n -r --argjson r "$RESPUESTA" --argjson i "$IDX_C" '$r.choices[0].message.tool_calls[$i].function.arguments // empty')
                M_USADO_C=$(jq -r '.comando // empty' < <(printf '%s' "$T_ARGS_C") 2>/dev/null)
                M_USADO_C="${M_USADO_C#\# Modulo: }"
                M_USADO_C="${M_USADO_C#\# modulo: }"
                M_USADO_C="${M_USADO_C#Modulo: }"
                M_USADO_C="${M_USADO_C%% - *}"
                M_USADO_C="${M_USADO_C%% (*}"
                if [[ "$ETIQUETAS_TOOLS" != *"[$T_NAME_C:$M_USADO_C]"$'\n'* ]]; then
                    NUEVAS_EN_PASO=$((NUEVAS_EN_PASO + 1))
                fi
            done
            if [[ $NUEVAS_EN_PASO -eq 0 ]]; then
                break
            fi

            MSG_LLAMADA=$(jq -n -c --argjson r "$RESPUESTA" '$r.choices[0].message')
            MENSAJES_TURNO=$(jq -a -c --argjson mcall "$MSG_LLAMADA" '. + [$mcall]' < <(echo "$MENSAJES_TURNO"))
            REPETIDO_DETECTADO=0
            ULTIMO_MOD_PASO=""
            ULTIMA_SAL_PASO=""

            for (( IDX_T=0; IDX_T<NUM_TOOLS; IDX_T++ )); do
                TOOL_NAME=$(jq -n -r --argjson r "$RESPUESTA" --argjson i "$IDX_T" '$r.choices[0].message.tool_calls[$i].function.name // empty')
                TOOL_ARGS=$(jq -n -r --argjson r "$RESPUESTA" --argjson i "$IDX_T" '$r.choices[0].message.tool_calls[$i].function.arguments // empty')
                MODULO_USADO=$(jq -r '.comando // empty' < <(printf '%s' "$TOOL_ARGS") 2>/dev/null)
                MODULO_USADO="${MODULO_USADO#\# Modulo: }"
                MODULO_USADO="${MODULO_USADO#\# modulo: }"
                MODULO_USADO="${MODULO_USADO#Modulo: }"
                MODULO_USADO="${MODULO_USADO%% - *}"
                MODULO_USADO="${MODULO_USADO%% (*}"
                TOOL_ID=$(jq -n -r --argjson r "$RESPUESTA" --argjson i "$IDX_T" --arg p "${PASO}_${IDX_T}" '$r.choices[0].message.tool_calls[$i].id // ("call_" + $p)')

                FIRMA_LLAMADA="[$TOOL_NAME:$MODULO_USADO]"
                if [[ "$ETIQUETAS_TOOLS" == *"$FIRMA_LLAMADA"$'\n'* ]]; then
                    REPETIDO_DETECTADO=1
                    SALIDA_HERRAMIENTA="$ULTIMA_SAL_PASO"
                else
                    if [[ -x "$DIR_HERRAMIENTAS/$TOOL_NAME" ]]; then
                        SALIDA_HERRAMIENTA=$(timeout "$TIMEOUT_HERRAMIENTA" "$DIR_HERRAMIENTAS/$TOOL_NAME" "$TOOL_ARGS" 2>/dev/null)
                    else
                        SALIDA_HERRAMIENTA="Error: herramienta no disponible ($TOOL_NAME)"
                    fi
                    if [[ -z "$SALIDA_HERRAMIENTA" ]]; then SALIDA_HERRAMIENTA="(sin salida)"; fi
                    ETIQUETAS_TOOLS+="$FIRMA_LLAMADA"$'\n'
                    ULTIMO_MOD_PASO="$MODULO_USADO"
                    ULTIMA_SAL_PASO="$SALIDA_HERRAMIENTA"
                fi

                MENSAJES_TURNO=$(jq -a -c --arg tid "$TOOL_ID" --arg tname "$TOOL_NAME" --arg tout "$SALIDA_HERRAMIENTA" '
                    . + [
                        {"role": "tool", "tool_call_id": $tid, "name": $tname, "content": $tout}
                    ]
                ' < <(echo "$MENSAJES_TURNO"))
            done

            if [[ $REPETIDO_DETECTADO -eq 1 ]]; then
                break
            fi

            if [[ $PASO -lt $MAX_REINTENTOS ]]; then
                if [[ "$ULTIMA_SAL_PASO" == Error:* ]]; then
                    TEXTO_REENRUTAR="$ENTRADA $ULTIMO_MOD_PASO ${ULTIMA_SAL_PASO:0:120}"
                    TEXTO_REENRUTAR="${TEXTO_REENRUTAR//$'\r'/ }"
                    TEXTO_REENRUTAR="${TEXTO_REENRUTAR//$'\n'/ }"
                    PAY_RE=$(jq -a -n --arg txt "$TEXTO_REENRUTAR" '{input: $txt}')
                    RESP_RE=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_RE")
                    if [[ -n "$RESP_RE" ]]; then
                        VEC_RE=$(jq -c 'if .data then (.data[0].embedding | map((. * 10000 | round) / 10000)) else null end' < <(echo "$RESP_RE"))
                        if [[ -n "$VEC_RE" ]]; then
                            if [[ "$VEC_RE" != "null" ]]; then
                                VEC_CONSULTA="$VEC_RE"
                                export VEC_CONSULTA
                                enrutar_loras
                                cargar_herramientas "$TEXTO_REENRUTAR"
                            fi
                        fi
                    fi
                fi
            fi
        else
            TEXTO_FINAL=$(jq -n -r --argjson r "$RESPUESTA" '($r.choices[0].message.content // "") | gsub("<[^>]*tool_call[^>]*>|</?parameter[^>]*>|<function=[^>]*>|</?response>"; "")')
            RESPONDI=1
            break
        fi
    done
fi

# Si agoto los reintentos o corto bucle repetido llamando herramientas, forzar respuesta final en texto limpio
if [[ $RESPONDI -eq 0 ]]; then
    INSTRUCCION_HERRAMIENTAS="\
$INSTRUCCION_AGENTE
- Responde ahora con precision en texto plano usando los datos reales verificados por las herramientas, sin emitir etiquetas tool_call ni XML.
"
    PAYLOAD_FINAL=$(jq -a --arg sys "$INSTRUCCION_HERRAMIENTAS" --argjson turno "$MENSAJES_TURNO" --argjson temp "$TEMPERATURA" --argjson rpen "${PENALIZACION_REPETICION:-1.15}" '{
        messages: (
            [{"role": "system", "content": $sys}] +
            . +
            $turno
        ),
        temperature: $temp,
        repeat_penalty: $rpen,
        stop: ["<tool_call>", "</tool_call>", "</parameter>", "<function=", "<response>"]
    }' < <(echo "$MEMORIA_JSON"))

    RESPUESTA_FINAL=$(curl -s "$URL" -H "Content-Type: application/json" -d "$PAYLOAD_FINAL")
    if [[ -z "$RESPUESTA_FINAL" ]]; then RESPUESTA_FINAL="{}"; fi
    TEXTO_FINAL=$(jq -n -r --argjson r "$RESPUESTA_FINAL" '($r.choices[0].message.content // "") | gsub("<[^>]*tool_call[^>]*>|</?parameter[^>]*>|<function=[^>]*>|</?response>"; "")')
fi

if [[ -n "$ETIQUETAS_TOOLS" ]]; then
    printf '%s%s\n' "$ETIQUETAS_TOOLS" "$TEXTO_FINAL"
else
    echo "$TEXTO_FINAL"
fi
