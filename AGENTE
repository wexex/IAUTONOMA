    }' < <(echo "$MEMORIA_JSON"))

    RESPUESTA_FINAL=$(curl -s "$URL" -H "Content-Type: application/json" -d "$PAYLOAD_FINAL")
    if [[ -z "$RESPUESTA_FINAL" ]]; then RESPUESTA_FINAL="{}"; fi
    TEXTO_FINAL=$(jq -r '(.choices[0].message.content // "") | gsub("<[^>]*tool_call[^>]*>|</?parameter[^>]*>|<function=[^>]*>|</?response>"; "")' < <(printf '%s' "$RESPUESTA_FINAL") 2>/dev/null)
fi

if [[ -n "$ETIQUETAS_TOOLS" ]]; then
    if [[ -n "$TEXTO_FINAL" ]]; then
        if [[ -n "${ARCH_TRAZA_TOOL:-}" ]]; then
            TRAZA_JSON=$(jq -a -c --arg txt "$TEXTO_FINAL" '
                if any(.[ ]; .role == "tool" and (((.content // "") | startswith("BLOQUEADO:")) or ((.content // "") | startswith("Error: herramienta no disponible")))) then
                    empty
                else
                    [
                        to_entries[ ] |
                        if (.key == 0 and .value.role == "user") then
                            {
                                role: "user",
