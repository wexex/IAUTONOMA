                        def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                        def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                        (.[0]) as $q |
                        (norm($q)) as $nq |
                        (.[1:]) as $evs |
                        [
                            $evs | to_entries[ ] |
                            select(.value.embedding != null and ((.value.embedding | length) == ($q | length))) |
                            (dot(.value.embedding; $q) / (norm(.value.embedding) * $nq)) as $s |
                            select($s >= $umb) |
                            {idx: .key, s: $s, fecha: .value.fecha, ts: (.value.ts // null), messages: .value.messages}
                        ] as $hits |
                        if ($hits | length) > 0 then
                            ($hits | sort_by(-.s)[:$maxr] | sort_by(.idx) | map({fecha: .fecha, ts: .ts, messages: .messages})) as $sel |
                            ([ $evs[ ] | select(type == "object" and .evento == "sueno") ][-1] // null) as $ult_s |
                            if ($ult_s != null) then
                                ($sel + [{fecha: $ult_s.fecha, ts: ($ult_s.ts // null), messages: $ult_s.messages}])
                            else
                                $sel
                            end
                        else
                            [ ]
                        end
                    ' < <(printf '%s\n' "$VEC_PURO"; cat "$RELOJ") 2>/dev/null)
                    if [[ -z "$RELOJ_TURNOS" ]]; then RELOJ_TURNOS="[ ]"; fi
                fi
            fi
        fi
    fi
fi

