# 3. Unir cascada ordenada (Largo plazo -> Reloj -> Hipocampo semantico -> Hilo) con edad relativa [FECHA | hace X] y sensor vigente
MEMORIA_JSON=$(jq -a -s --argjson ahora_ts "$TS_AHORA" --arg ahora_f "$FECHA_AHORA" '
    def ymd_dias($y; $m; $d):
        (if $m <= 2 then ($y - 1) else $y end) as $yr |
        (if $m <= 2 then ($m + 12) else $m end) as $mo |
        (($yr * 365) + (($yr / 4) | floor) - (($yr / 100) | floor) + (($yr / 400) | floor) + (((153 * ($mo - 3) + 2) / 5) | floor) + $d);
    def fseg($f):
        if ($f != null and ($f | length) >= 19) then
            (try ($f[0:4] | tonumber) catch 0) as $y |
            (try ($f[5:7] | tonumber) catch 0) as $mo |
            (try ($f[8:10] | tonumber) catch 0) as $d |
            (try ($f[11:13] | tonumber) catch 0) as $h |
            (try ($f[14:16] | tonumber) catch 0) as $mi |
            (try ($f[17:19] | tonumber) catch 0) as $s |
            if $y > 0 then ((ymd_dias($y; $mo; $d) * 86400) + ($h * 3600) + ($mi * 60) + $s) else 0 end
        else 0 end;
    def fmt_edad($dt):
        if $dt < 60 then "hace \($dt | floor)s"
        elif $dt < 3600 then "hace \((($dt / 60) | floor))m"
        elif $dt < 86400 then "hace \((($dt / 3600) | floor))h"
        else "hace \((($dt / 86400) | floor))d"
        end;
    (fseg($ahora_f)) as $ahora_seg |
    (.[0] // [ ]) as $rec |
    (.[1] // [ ]) as $rel |
    (.[2] // [ ]) as $hip |
    ([ $hip[ ].messages[0].content ]) as $u_hip |
    ([ $rel[ ].messages[0].content ]) as $u_rel |
    (
        ([ $rec[ ] | select(.messages[0].content as $u | (($u_hip | index($u)) == null) and (($u_rel | index($u)) == null)) ]) +
        ([ $rel[ ] | select(.messages[0].content as $u | ($u_hip | index($u)) == null) ]) +
        $hip
    ) |
    map(
        (
            if (.ts != null and (.ts | type) == "number") then
                ($ahora_ts - .ts)
            else
                (fseg(.fecha)) as $fs |
                if $fs > 0 then ($ahora_seg - $fs) else -1 end
            end | if . < -1 then 0 else . end
        ) as $dt |
        (
            if (.fecha != null and .fecha != "") then
                if $dt >= 0 then "[\(.fecha) | \(fmt_edad($dt))] " else "[\(.fecha)] " end
            else
                ""
            end
        ) as $pref |
        (
            if (.sensor != null and (.sensor | length) > 0) then
                (.messages[1] | .content = "[Salida real herramienta: \(.sensor)]\n" + (.content // ""))
            else
                .messages[1]
            end
        ) as $m_ast |
        [
            (.messages[0] | .content = $pref + (.content // "")),
            $m_ast
        ]
    ) | add // [ ]
' < <(echo "$RECUERDOS_TURNOS"; echo "$RELOJ_TURNOS"; echo "$HIPOCAMPO_TURNOS") 2>/dev/null)
if [[ -z "$MEMORIA_JSON" ]]; then MEMORIA_JSON="[ ]"; fi

