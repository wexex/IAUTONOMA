#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)/CONFIG"

# Argumentos recibidos:
ENTRADA="$*"

# Espera activa hasta que el servidor esté vivo y respondiendo (HTTP 200)
while ! curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; do sleep 0.5; done

# Si un turno previo aun esta consolidando memoria en segundo plano, esperar brevemente su cierre atomico
if [[ -s "$LOCK_MEMORIA" ]]; then
    esperar_lock 50 0.1
fi

H_HIP=$(( ${DECAIMIENTO_HIPOCAMPO} ))
H_MEM=$(( ${DECAIMIENTO_MEMORIA} ))
H_PER=$(( ${DECAIMIENTO_PERSISTENTE} ))
H_CAS=$(( ${DECAIMIENTO_CASTIGO} ))

TS_AHORA=$(date +%s)
TS_INI_MS=$(date +%s%3N 2>/dev/null)
if [[ ! "$TS_INI_MS" =~ ^[0-9]+$ ]]; then TS_INI_MS=$((TS_AHORA * 1000)); fi
FECHA_AHORA=$(date "+%Y-%m-%d %H:%M:%S")
VALENCIA_TURNO="0"
ALERTA_TURNO="0"
ALERTA_MOTIVO=""
CORTADO_FRUST=0
ULTIMA_SAL_PASO=""
PASO=0
CRIT_DISP="0"
CRIT_CORR="0"
CRIT_MOT=""
FRUST_PREV="0"
if [[ -s "$AMIGDALA" ]]; then
    FP_AM=$(jq -r '.frustracion // 0' "$AMIGDALA" 2>/dev/null)
    if [[ "$FP_AM" =~ ^[0-9]+$ ]]; then FRUST_PREV="$FP_AM"; fi
fi
TS_DESPERTAR=0
if [[ -s "$RELOJ" ]]; then
    TS_DESP_R=$(jq -r -s '[ .[ ] | select(type == "object" and .evento == "despertar" and (.ts != null)) | .ts ] | last // 0' "$RELOJ" 2>/dev/null)
    if [[ -n "$TS_DESP_R" ]]; then TS_DESPERTAR="$TS_DESP_R"; fi
fi

read -r NORM_DISPARO_HIP NORM_DISPARO_MEM NORM_DISPARO_PER < <(jq -r -n \
    --argjson u "$UMBRAL_SIM" \
    --argjson p "$PESO_INICIAL" \
    --argjson hh "$H_HIP" \
    --argjson hm "$H_MEM" \
    --argjson hp "$H_PER" \
    --argjson c "$H_CAS" '
    [
        (($u * (((($p / $u) | log) * ($c / $hh)) | exp)) + 0.001),
        (($u * (((($p / $u) | log) * ($c / $hm)) | exp)) + 0.001),
        (($u * ((((1.0 / $u) | log) * ($c / $hp)) | exp)) + 0.001)
    ] | map(tostring) | join(" ")
')

# Vectorizar consulta limpia (quitando prefijo de despertar [FECHA] <<...>> si existe; respaldo vectorial por hipocampo si no dispara recuerdos)
ENTRADA_VEC="$ENTRADA"
if [[ "$ENTRADA_VEC" == "["*"] <<"*">> "* ]]; then
    ENTRADA_VEC="${ENTRADA_VEC#*>> }"
fi

# Aduana neuronal de entrada (Amigdala Capa 2 en CPU): detecta riesgo semantico sin bloquear charla normal
if [[ "${MODO_INTERNO:-0}" -eq 0 ]]; then
    if [[ -x "$DIR/AMIGDALA" ]]; then
        if [[ ${#ENTRADA_VEC} -ge 12 ]]; then
            IFS=$'\t' read -r NIV_ENT CAT_ENT < <("$DIR/AMIGDALA" --entrada "$ENTRADA_VEC" 2>/dev/null)
            if [[ "$NIV_ENT" == "UNSAFE" ]]; then
                ALERTA_TURNO="1"
                ALERTA_MOTIVO="entrada:${NIV_ENT}:${CAT_ENT}"
                VALENCIA_TURNO="-1"
            elif [[ "$NIV_ENT" == "CONTROVERSIAL" ]]; then
                ALERTA_TURNO="1"
                ALERTA_MOTIVO="entrada:${NIV_ENT}:${CAT_ENT}"
            fi
        fi
    fi
fi
VEC_CONSULTA="null"
if [[ -n "$ENTRADA_VEC" ]]; then
    PAYLOAD_EMB=$(jq -a -n --arg txt "$ENTRADA_VEC" '{input: $txt}')
    RESP_EMB=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAYLOAD_EMB")
    if [[ -z "$RESP_EMB" ]]; then RESP_EMB="{}"; fi
    VEC_CONSULTA=$(jq -c 'if .data then (.data[0].embedding | map((. * 10000 | round) / 10000)) else null end' < <(echo "$RESP_EMB"))
    if [[ -z "$VEC_CONSULTA" ]]; then VEC_CONSULTA="null"; fi
fi
VEC_PURO="$VEC_CONSULTA"
export VEC_CONSULTA

MAX_SIM_MOD="0.0"
GAP_MOD="0.0"
MODULO_DOMINANTE="0"
calcular_max_sim_mod() {
    MAX_SIM_MOD="0.0"
    GAP_MOD="0.0"
    MODULO_DOMINANTE="0"
    if [[ -n "$VEC_CONSULTA" ]]; then
        if [[ "$VEC_CONSULTA" != "null" ]]; then
            MOD_FILES=( )
            for mf in "$DIR_MEM_MODULOS"/modulos_*.json; do
                if [[ -s "$mf" ]]; then MOD_FILES+=("$mf"); fi
            done
            if [[ ${#MOD_FILES[@]} -gt 0 ]]; then
                IFS=$'\t' read -r MAX_SIM_MOD GAP_MOD MODULO_DOMINANTE < <(jq -r -s \
                    --argjson umod "${UMBRAL_MODULO:-0.62}" \
                    --argjson ugap "${UMBRAL_GAP_MODULO:-0.06}" \
                    --argjson uref "${UMBRAL_REFUERZO:-0.80}" '
                    def norm($a): ((reduce $a[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    (.[0]) as $q |
                    (norm($q)) as $nq |
                    (
                        [
                            .[1:][ ] |
                            select(type == "object" and .embedding != null and ((.embedding | length) == ($q | length))) |
                            (dot(.embedding; $q) / (norm(.embedding) * $nq))
                        ] | sort | reverse
                    ) as $sims |
                    ($sims[0] // 0.0) as $s1 |
                    ($sims[(($sims | length) / 2 | floor)] // 0.0) as $smed |
                    ($s1 - $smed) as $gap |
                    (if ($s1 >= $umod and $gap >= $ugap) then 1 else 0 end) as $dom |
                    "\($s1)\t\($gap)\t\($dom)"
                ' < <(printf '%s\n' "$VEC_CONSULTA"; cat "${MOD_FILES[@]}") 2>/dev/null)
                if [[ -z "$MAX_SIM_MOD" ]]; then MAX_SIM_MOD="0.0"; fi
                if [[ -z "$GAP_MOD" ]]; then GAP_MOD="0.0"; fi
                if [[ -z "$MODULO_DOMINANTE" ]]; then MODULO_DOMINANTE="0"; fi
            fi
        fi
    fi
}
calcular_max_sim_mod
MAX_SIM_MOD_PURO="$MAX_SIM_MOD"
GAP_MOD_PURO="$GAP_MOD"
MODULO_DOMINANTE_PURO="$MODULO_DOMINANTE"

# Si la frase aislada no domino un modulo pero el ultimo turno inmediato fue una herramienta, re-evaluar con contexto del hilo (q + h) para resolver frases anaforicas ("que hay dentro", "miralo")
VEC_CTX_HERR=""
if [[ "${MODULO_DOMINANTE_PURO:-0}" -eq 0 ]]; then
    if [[ "$VEC_PURO" != "null" ]]; then
        if [[ -s "$HIPOCAMPO" ]]; then
            VEC_CTX_HERR=$(jq -a -c -s '
                (.[0]) as $q |
                ([ .[1:][ ] | select(type == "object" and ((.messages[0].content // "") | startswith("<<") | not) and .embedding != null) ][-1] // null) as $ult |
                if ($q != null and $ult != null and (($ult.herramienta // 0) == 1 or (($ult.messages[1].content // "") | startswith("[")))) then
                    ($ult.embedding) as $h |
                    ([$q[:1024], $h[:1024]] | transpose | map((.[0] // 0) + (.[1] // 0))) as $s |
                    (($s | map(. * .) | add | sqrt) + 0.000001) as $ns |
                    ($s | map(((. / $ns) * 10000 | round) / 10000))
                else
                    empty
                end
            ' < <(printf '%s\n' "$VEC_PURO"; cat "$HIPOCAMPO") 2>/dev/null)
            if [[ -n "$VEC_CTX_HERR" ]]; then
                VEC_CONSULTA="$VEC_CTX_HERR"
                calcular_max_sim_mod
                VEC_CONSULTA="$VEC_PURO"
                if [[ "${MODULO_DOMINANTE:-0}" -eq 1 ]]; then
                    MAX_SIM_MOD_PURO="$MAX_SIM_MOD"
                    GAP_MOD_PURO="$GAP_MOD"
                    MODULO_DOMINANTE_PURO="1"
                fi
            fi
        fi
    fi
fi

# Enrutador vectorial de adaptadores LoRA por demanda (POST /lora-adapters)
enrutar_loras() {
    LORAS_SRV=$(curl -sf "$URL_LORA" 2>/dev/null)
    if [[ -z "$LORAS_SRV" ]]; then LORAS_SRV="[ ]"; fi
    ESTADO_LORA=$(jq -r --arg base "$LORA_BASE" --argjson esc "${LORA_ESCALA:-1.0}" '
        (length // 0) as $n |
        if $n == 0 then
            "NONE"
        elif $n == 1 then
            (.[0].path | split("/")[-1] | split("\\")[-1] | rtrimstr(".gguf")) as $nom |
            if ($nom == $base and (((.[0].scale // 0.0) - $esc) | fabs) <= 0.001) then
                "OK"
            else
                "ROUTE"
            end
        else
            "ROUTE"
        end
    ' < <(echo "$LORAS_SRV") 2>/dev/null)
    if [[ "$ESTADO_LORA" == "ROUTE" ]]; then
        mkdir -p "$DIR_MEM_LORA"
        RAW_HUELLA=""
        LISTA_GGUF=( )
        for fl in "$DIR_LORA_PESOS"/*.gguf; do
            if [[ -s "$fl" ]]; then
                NOM_L="$(basename "$fl" .gguf)"
                LISTA_GGUF+=("$NOM_L")
                DESC_H=""
                if [[ -s "$DIR_LORA/${NOM_L}.desc" ]]; then
                    DESC_H=$(cksum "$DIR_LORA/${NOM_L}.desc" 2>/dev/null)
                fi
                RAW_HUELLA+="${NOM_L}	${DESC_H}"$'\n'
            fi
        done
        if [[ -s "$INDICE_LORA_DATASETS" ]]; then
            RAW_HUELLA+="IDX	$(cksum "$INDICE_LORA_DATASETS" 2>/dev/null)"$'\n'
        fi
        if [[ ${#LISTA_GGUF[@]} -gt 0 ]]; then
            HUELLA_L=$(cksum < <(printf '%s' "$RAW_HUELLA"))
            REIND_L=0
            if [[ ! -s "$INDICE_LORA" ]]; then REIND_L=1; fi
            if [[ ! -s "$DIR_MEM_LORA/huella" ]]; then REIND_L=1; fi
            if [[ $REIND_L -eq 0 ]]; then
                HUELLA_L_OLD=$(cat "$DIR_MEM_LORA/huella" 2>/dev/null)
                if [[ "$HUELLA_L_OLD" != "$HUELLA_L" ]]; then REIND_L=1; fi
            fi
            if [[ $REIND_L -eq 1 ]]; then
                > "${INDICE_LORA}.tmp"
                for nom_l in "${LISTA_GGUF[@]}"; do
                    ENT_CENT=""
                    if [[ -s "$INDICE_LORA_DATASETS" ]]; then
                        ENT_CENT=$(jq -a -c --arg nom "$nom_l" 'select(.nombre == $nom and .embedding != null)' "$INDICE_LORA_DATASETS" 2>/dev/null)
                    fi
                    if [[ -n "$ENT_CENT" ]]; then
                        printf '%s\n' "$ENT_CENT" >> "${INDICE_LORA}.tmp"
                    elif curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then
                        if [[ -s "$DIR_LORA_DATASETS/${nom_l}.jsonl" ]]; then
                            if [[ ! -s "$DIR_LORA/${nom_l}.desc" ]]; then
                                PAY_DS=$(jq -a -c -s '{input: [ .[ ] | select(type == "object" and (.messages | length) >= 2) | ((.messages[0].content // "") + " " + (.messages[-1].content // "")) ]}' "$DIR_LORA_DATASETS/${nom_l}.jsonl" 2>/dev/null)
                                RESP_DS=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_DS" 2>/dev/null)
                                if [[ -n "$RESP_DS" ]]; then
                                    jq -a -c --arg nom "$nom_l" '
                                        def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                                        if (.data and (.data | length) > 0) then
                                            ([ .data[ ].embedding | (norm(.)) as $n | map(. / $n) ]) as $units |
                                            ($units[0] | length) as $dim |
                                            (reduce range(0; $dim) as $i ([ ]; . + [(reduce $units[ ] as $u (0; . + ($u[$i] // 0))) / ($units | length)])) as $mean |
                                            (norm($mean)) as $nm |
                                            {nombre: $nom, lineas: ($units | length), embedding: ($mean | map(((. / $nm) * 10000 | round) / 10000))}
                                        else
                                            empty
                                        end
                                    ' < <(printf '%s' "$RESP_DS") >> "${INDICE_LORA}.tmp" 2>/dev/null
                                fi
                            fi
                        fi
                        if ! jq -e -s --arg nom "$nom_l" 'any(.[ ]; .nombre == $nom)' "${INDICE_LORA}.tmp" >/dev/null 2>/dev/null; then
                            DESC_L="$nom_l"
                            if [[ -s "$DIR_LORA/${nom_l}.desc" ]]; then
                                DESC_L=$(tr '\r\n' '  ' < "$DIR_LORA/${nom_l}.desc")
                            fi
                            PAY_L=$(jq -a -n --arg txt "$DESC_L" '{input: $txt}')
                            RESP_L=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_L" 2>/dev/null)
                            if [[ -n "$RESP_L" ]]; then
                                jq -a -c --arg nom "$nom_l" '
                                    if .data then
                                        {nombre: $nom, embedding: (.data[0].embedding | map((. * 10000 | round) / 10000))}
                                    else
                                        empty
                                    end
                                ' < <(printf '%s' "$RESP_L") >> "${INDICE_LORA}.tmp" 2>/dev/null
                            fi
                        fi
                    fi
                done
                if [[ -s "${INDICE_LORA}.tmp" ]]; then
                    mv -f "${INDICE_LORA}.tmp" "$INDICE_LORA"
                    printf '%s\n' "$HUELLA_L" > "$DIR_MEM_LORA/huella"
                else
                    rm -f "${INDICE_LORA}.tmp" 2>/dev/null
                fi
            fi
        fi
        IND_LORA_JSON="[ ]"
        if [[ -s "$INDICE_LORA" ]]; then
            IND_LORA_JSON=$(jq -a -c -s '.' "$INDICE_LORA" 2>/dev/null)
            if [[ -z "$IND_LORA_JSON" ]]; then IND_LORA_JSON="[ ]"; fi
        fi
        calcular_max_sim_mod
        RECT_JSON="[ ]"
        if [[ -s "$LORAS_RECTIFICAR" ]]; then
            RECT_JSON=$(jq -a -R -s -c 'split("\n") | map(gsub("\r$"; "") | select(length > 0))' "$LORAS_RECTIFICAR" 2>/dev/null)
            if [[ -z "$RECT_JSON" ]]; then RECT_JSON="[ ]"; fi
        fi
        PAYLOAD_LORAS=$(jq -a -c -s \
            --arg base "$LORA_BASE" \
            --argjson esc "${LORA_ESCALA:-1.0}" \
            --argjson umb "${UMBRAL_LORA:-0.55}" \
            --argjson maxa "${MAX_LORAS_ACTIVOS:-2}" \
            --argjson maxm "${MAX_SIM_MOD:-0.0}" \
            --argjson moddom "${MODULO_DOMINANTE_PURO:-0}" \
            --argjson haymem "${HAY_MEM_SEM:-0}" \
            --argjson rect "$RECT_JSON" \
            --argjson interno "${MODO_INTERNO:-0}" '
            def norm($a): ((reduce $a[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
            def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
            (.[0] // [ ]) as $srv |
            (.[1] // [ ]) as $idx |
            (.[2] // null) as $q |
            (if $q != null then norm($q) else 1 end) as $nq |
            ($idx | map({(.nombre): .embedding}) | add // {}) as $embs |
            [
                $srv[ ] |
                (.path | split("/")[-1] | split("\\")[-1] | rtrimstr(".gguf")) as $nom |
                ($embs[$nom]) as $ev |
                {
                    id: .id,
                    nom: $nom,
                    prev: (.scale // 0.0),
                    es_base: ($nom == $base),
                    es_cur: ($nom | startswith("curiosidad_")),
                    es_herr: ($nom | startswith("sueno_herr_")),
                    en_rect: (($rect | index($nom)) != null),
                    sim: (if ($q != null and $ev != null) then (dot($ev; $q) / (norm($ev) * $nq)) else 0 end)
                }
            ] as $eval |
            (
                if $interno == 1 then
                    [ ]
                else
                    ([ $eval[ ] | select((.es_base | not) and (.es_cur | not) and (.en_rect | not) and (.es_herr or (.sim >= $maxm)) and .sim >= $umb) ] | sort_by(-.sim)) as $saber |
                    if ($saber | length) > 0 then
                        $saber[:$maxa] | map(.id)
                    elif ($haymem == 0 and $moddom == 0) then
                        [ $eval[ ] | select(.es_cur and (.en_rect | not) and .sim >= $umb and .sim >= $maxm) ] | sort_by(-.sim)[:1] | map(.id)
                    else
                        [ ]
                    end
                end
            ) as $ganadores |
            (if ($ganadores | length) > 0 then ($esc * 0.7) else $esc end) as $esc_base |
            (if ($ganadores | length) > 0 then (($esc * 0.8) / ($ganadores | length)) else 0.0 end) as $esc_esp |
            [
                $eval[ ] |
                .id as $cur_id |
                {
                    id: $cur_id,
                    prev: .prev,
                    scale: (if .es_base then $esc_base elif (($ganadores | index($cur_id)) != null) then $esc_esp else 0.0 end)
                }
            ] as $res |
            if ([ $res[ ] | select(((.scale - .prev) | fabs) > 0.001) ] | length) > 0 then
                [ $res[ ] | {id: .id, scale: .scale} ]
            else
                empty
            end
        ' < <(printf '%s\n%s\n%s\n' "$LORAS_SRV" "$IND_LORA_JSON" "${VEC_CONSULTA:-null}") 2>/dev/null)
        if [[ -n "$PAYLOAD_LORAS" ]]; then
            curl -sf -X POST "$URL_LORA" -H "Content-Type: application/json" -d "$PAYLOAD_LORAS" >/dev/null 2>/dev/null
        fi
    fi
}

# 1. Recordar y reforzar en Memoria Persistente y Memoria Episodica (ambas particionadas Top-2)
RECUERDOS_TURNOS="[ ]"
CANDIDATOS_RAW=""

ascender_a_persistente() {
    NUEVO_PER="$1"
    if [[ ! -f "$INDICE_PERSISTENTE" ]]; then > "$INDICE_PERSISTENTE"; fi

    PART_PER=$(jq -r -s --argjson umb "$UMBRAL_SIM" --argjson maxp "$MAX_PARTICION" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        if $nuevo.embedding != null then
            (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
            (
                [
                    $idx[ ] |
                    select(.lineas < $maxp and .embedding != null) |
                    ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                    . + {sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))} |
                    select(.sim >= $umb)
                ] | sort_by(-.sim) | .[0].archivo // empty
            )
        else
            ($idx | map(select(.ultimo == 1 and .lineas < $maxp)) | .[0].archivo // empty)
        end
    ' < <(cat "$INDICE_PERSISTENTE"; echo "$NUEVO_PER"))

    if [[ -n "$PART_PER" ]]; then
        if [[ -s "$DIR_MEMORIA/$PART_PER" ]]; then
            PER_ACT=$(jq -a -c -s --argjson uref "$UMBRAL_REFUERZO" '
                (.[0:-1]) as $items |
                (.[-1]) as $nuevo |
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ([
                    $items[ ] |
                    if .embedding != null then
                        ((.embedding | map(. * .) | add | sqrt) + 0.000001) as $ne |
                        . + {_sim: (([.embedding, $nuevo.embedding] | transpose | map((.[0] // 0) * (.[1] // 0)) | add) / ($ne * $nq))}
                    else
                        . + {_sim: 0}
                    end
                ]) as $marcados |
                ([ $marcados[ ] | select(._sim < $uref) | del(._sim) ] + [$nuevo])[ ]
            ' < <(cat "$DIR_MEMORIA/$PART_PER"; echo "$NUEVO_PER") 2>/dev/null)
            if [[ -n "$PER_ACT" ]]; then
                echo "$PER_ACT" > "$DIR_MEMORIA/${PART_PER}.$$.tmp"
                mv -f "$DIR_MEMORIA/${PART_PER}.$$.tmp" "$DIR_MEMORIA/$PART_PER" 2>/dev/null
            fi
        else
            echo "$NUEVO_PER" > "$DIR_MEMORIA/$PART_PER"
        fi
    else
        N_PER=1
        while [[ -f "$DIR_MEMORIA/${PREFIJO_PERSISTENTE}_${N_PER}.json" ]]; do
            N_PER=$((N_PER + 1))
        done
        PART_PER="${PREFIJO_PERSISTENTE}_${N_PER}.json"
        echo "$NUEVO_PER" > "$DIR_MEMORIA/$PART_PER"
    fi

    LINEAS_PER=$(jq -r -s 'length' "$DIR_MEMORIA/$PART_PER")
    IND_PER_NUEVO=$(jq -a -c -s --arg arch "$PART_PER" --argjson lreal "$LINEAS_PER" '
        (.[0:-1]) as $idx |
        (.[-1]) as $nuevo |
        (
            if $nuevo.embedding != null then
                (($nuevo.embedding | map(. * .) | add | sqrt) + 0.000001) as $nq |
                ($nuevo.embedding | map((. / $nq * 10000 | round) / 10000))
            else
                null
            end
        ) as $v_unit |
        if ([ $idx[ ] | select(.archivo == $arch) ] | length) > 0 then
            [
                $idx[ ] |
                if .archivo == $arch then
                    .lineas as $n |
                    . + {
                        lineas: $lreal,
                        ultimo: 1,
                        embedding: (
                            if ($v_unit != null and .embedding != null) then
                                ([.embedding[:1024], $v_unit[:1024]] | transpose | map((((.[0] // 0) * $n) + (.[1] // 0)) / ($n + 1))) as $raw_c |
                                (($raw_c | map(. * .) | add | sqrt) + 0.000001) as $nc |
                                ($raw_c | map((. / $nc * 10000 | round) / 10000))
                            else
                                (.embedding // $v_unit)
                            end
                        )
                    }
                else
                    . + {ultimo: 0}
                end
            ][ ]
        else
            (
                [ $idx[ ] | . + {ultimo: 0} ] +
                [{archivo: $arch, lineas: $lreal, ultimo: 1, embedding: $v_unit}]
            )[ ]
        end
    ' < <(cat "$INDICE_PERSISTENTE"; echo "$NUEVO_PER"))
    if [[ -n "$IND_PER_NUEVO" ]]; then
        echo "$IND_PER_NUEVO" > "${INDICE_PERSISTENTE}.$$.tmp"
        mv -f "${INDICE_PERSISTENTE}.$$.tmp" "$INDICE_PERSISTENTE" 2>/dev/null
    fi
}

# Umbrales encadenados por fase (relativos entre UMBRAL_SIM y UMBRAL_REFUERZO): uh (Hipocampo) -> ue (Episodica) -> up (Persistente)
IFS=$'\t' read -r UMBRAL_HIP UMBRAL_EPI UMBRAL_PER < <(jq -r -n \
    --argjson sim "$UMBRAL_SIM" \
    --argjson ref "$UMBRAL_REFUERZO" '
    ($ref - $sim) as $d |
    "\($sim)\t\((($sim + ($d * 0.25)) * 10000 | round) / 10000)\t\((($sim + ($d * 0.50)) * 10000 | round) / 10000)"
' 2>/dev/null)
if [[ -z "$UMBRAL_HIP" ]]; then UMBRAL_HIP="$UMBRAL_SIM"; fi
if [[ -z "$UMBRAL_EPI" ]]; then UMBRAL_EPI="$UMBRAL_SIM"; fi
if [[ -z "$UMBRAL_PER" ]]; then UMBRAL_PER="$UMBRAL_SIM"; fi

buscar_y_reforzar_capa() {
    CAPA_IND="$1"
    PUEDE_ASCENDER="$2"
    CAPA_ND="$3"
    APLICAR_REF="${4:-1}"
    CAPA_UMB="${5:-$UMBRAL_SIM}"

    if [[ -s "$CAPA_IND" ]]; then
        PARTICIONES_BUSCAR=$(jq -r -s --argjson umb "$UMBRAL_SIM" '
            def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
            def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
            (.[0]) as $q |
            (.[1:]) as $idx |
            if $q == null then
                ($idx[ ] | select(type == "object" and .ultimo == 1) | .archivo) // empty
            else
                (norm($q)) as $nq |
                (
                    [
                        $idx[ ] |
                        select(type == "object" and .embedding != null) |
                        . + {sim: (dot(.embedding; $q) / (norm(.embedding) * $nq))} |
                        select(.sim >= $umb)
                    ] | sort_by(-.sim)[:2][ ].archivo
                ) // empty
            end
        ' < <(printf '%s\n' "${VEC_CONSULTA:-null}"; cat "$CAPA_IND") 2>/dev/null)

        if [[ -n "$PARTICIONES_BUSCAR" ]]; then
            while IFS= read -r part; do
                if [[ -n "$part" ]]; then
                    if [[ -s "$DIR_MEMORIA/$part" ]]; then
                        GAN_KEY=""
                        GAN_TOPE=""
                        while IFS=$'\t' read -r tag payload_line; do
                            if [[ "$tag" == "C" ]]; then
                                CANDIDATOS_RAW+="$payload_line"$'\n'
                            elif [[ "$tag" == "K" ]]; then
                                GAN_KEY="${payload_line%%	*}"
                                GAN_TOPE="${payload_line#*	}"
                            fi
                        done < <(jq -a -r -s \
                            --argjson umb "$CAPA_UMB" \
                            --argjson uref "$UMBRAL_REFUERZO" \
                            --argjson nd "$CAPA_ND" \
                            --argjson pini "$PESO_INICIAL" \
                            --argjson maxm "$MAX_MEMORIA" \
                            --argjson ref "$APLICAR_REF" \
                            --argjson ahora_ts "$TS_AHORA" \
                            --arg ahora_f "$FECHA_AHORA" \
                            --argjson ts_desp "$TS_DESPERTAR" \
                            --argjson vig "${VIGENCIA_HERRAMIENTA:-60}" \
                            --argjson umod "${UMBRAL_MODULO:-0.55}" \
                            --argjson maxsim_mod "${MAX_SIM_MOD:-0.0}" \
                            --arg qtxt "$ENTRADA_VEC" '
                            def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                            def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                            def toks($s): [ ($s // "" | ascii_downcase | scan("[a-z0-9_-]{3,}")) ] | unique;
                            def lex($qt; $txt):
                                if ($qt | length) == 0 then 0.0
                                else
                                    (toks($txt)) as $dt |
                                    (reduce $qt[ ] as $t (0; . + ($t | length))) as $tot |
                                    (reduce $qt[ ] as $t (0; . + (if ($dt | index($t)) != null then ($t | length) else 0 end))) as $hit |
                                    if $tot > 0 then ($hit / $tot) else 0.0 end
                                end;
                            def ymd_dias($y; $m; $d):
                                (if $m <= 2 then ($y - 1) else $y end) as $yr |
                                (if $m <= 2 then ($m + 12) else $m end) as $mo |
                                (($yr * 365) + (($yr / 4) | floor) - (($yr / 100) | floor) + (($yr / 400) | floor) + (((153 * ($mo - 3) + 2) / 5) | floor) + $d);
                            def fseg($f):
                                if ($f != null and ($f | length) >= 19) then
                                    (try ($f[0:4] | tonumber) catch 0) as $y |
                                    (try ($f[5:7] | tonumber) catch 0) as $mo |
                                    (try ($f[8:10] | tonumber) catch 0) as $d |
                                    (try ($f[11:13] | tonumber) catch 0) as $h |
                                    (try ($f[14:16] | tonumber) catch 0) as $mi |
                                    (try ($f[17:19] | tonumber) catch 0) as $s |
                                    if $y > 0 then ((ymd_dias($y; $mo; $d) * 86400) + ($h * 3600) + ($mi * 60) + $s) else 0 end
                                else 0 end;
                            (fseg($ahora_f)) as $ahora_seg |
                            (($uref + 1.0) / 2) as $u_rep |
                            (toks($qtxt)) as $qtoks |
                            (.[0]) as $q |
                            (.[1:]) as $items |
                            if $q == null then
                                ([ $items[ ] | select(type == "object" and (.embedding == null or norm(.embedding) > $nd)) ][-$maxm:][ ] |
                                 "C\t" + ({fecha: .fecha, ts: (.ts // null), messages: .messages, _sim: 1, _herr: (if ((.herramienta // 0) == 1 or ((.messages[1].content // "") | startswith("["))) then 1 else 0 end)} | tojson))
                            else
                                (norm($q)) as $nq |
                                [
                                    $items | to_entries[ ] |
                                    if (.value | type == "object" and .embedding != null) then
                                        (norm(.value.embedding)) as $ne |
                                        if $ne > $nd then
                                            ((.value.herramienta // 0) == 1 or ((.value.messages[1].content // "") | startswith("["))) as $es_herr |
                                            (dot(.value.embedding; $q) / ($ne * $nq)) as $c_emb |
                                            (if .value.emb_u != null then (dot(.value.emb_u; $q) / (norm(.value.emb_u) * $nq)) else 0 end) as $c_u |
                                            (if $c_u > $c_emb then $c_u else $c_emb end) as $c_max |
                                            (
                                                if (.value.ts != null and (.value.ts | type) == "number") then
                                                    ($ahora_ts - .value.ts)
                                                else
                                                    (fseg(.value.fecha)) as $fs |
                                                    if $fs > 0 then ($ahora_seg - $fs) else 999999 end
                                                end | if . < 0 then 0 else . end
                                            ) as $edad |
                                            (
                                                if ($es_herr and ($edad > $vig or ($ts_desp > 0 and ((.value.ts // ($ahora_ts - $edad)) < $ts_desp)))) then 1 else 0 end
                                            ) as $cad |
                                            (lex($qtoks; ((.value.messages[0].content // "") + " " + (.value.messages[1].content // "")))) as $lx |
                                            {key: .key, fecha: .value.fecha, ts: (.value.ts // null), messages: .value.messages, _ne: $ne, _cos: $c_max, _c_emb: $c_emb, _c_u: $c_u, _lex: $lx, _sim: ($ne * $c_max), _herr: (if $es_herr then 1 else 0 end), _cad: $cad}
                                        else
                                            empty
                                        end
                                    else
                                        empty
                                    end
                                ] as $todos |
                                (
                                    [ $todos[ ] | select((._cos >= $umb or (._lex >= $umb and ._cos >= ($umb * 0.75))) and (if ._herr == 1 then (._c_u < $u_rep and (._cad == 0 or ._c_u < $umb)) else ($maxsim_mod < $umod or ._c_u < $umb) end)) ] |
                                    sort_by(-._sim) | to_entries | map(.value + {_rsem: .key}) |
                                    sort_by(-._lex, -._sim) | to_entries | map(.value + {_rlex: .key}) |
                                    map(. + {_rrf: ((1 / (20 + ._rsem)) + (if ._lex > 0 then (1 / (20 + ._rlex)) else 0 end))}) |
                                    sort_by(-._rrf)[:($maxm + 1)][ ] |
                                    "C\t" + ({fecha: .fecha, ts: .ts, messages: .messages, _sim: ._rrf, _herr: ._herr} | tojson)
                                ),
                                (
                                    ([ $todos[ ] | select(._cos >= $umb) ] | sort_by(-._sim) | .[0] // null) as $gan |
                                    if ($ref == 1 and $gan != null) then
                                        (if $gan._herr == 1 then $pini else 1.0 end) as $tope |
                                        if ($gan._ne < ($tope - 0.001)) then
                                            "K\t\($gan.key)\t\($tope)"
                                        else
                                            empty
                                        end
                                    else
                                        empty
                                    end
                                )
                            end
                        ' < <(printf '%s\n' "${VEC_CONSULTA:-null}"; cat "$DIR_MEMORIA/$part") 2>/dev/null)

                        if [[ -n "$GAN_KEY" ]]; then
                            TMP_ITEMS_PART="$DIR_MEMORIA/${part}.$$.tmp"
                            jq -a -c -s \
                                --argjson gk "$GAN_KEY" \
                                --argjson tope "$GAN_TOPE" \
                                --argjson fref "$FACTOR_REFUERZO" '
                                def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                                to_entries[ ] |
                                if .key == $gk then
                                    (.value.embedding[:1024] | map(. * $fref)) as $v_ref |
                                    (norm($v_ref)) as $n_ref |
                                    .value + {
                                        embedding: (
                                            if $n_ref > $tope then
                                                ($v_ref | map((. / $n_ref * $tope * 10000 | round) / 10000))
                                            else
                                                ($v_ref | map((. * 10000 | round) / 10000))
                                            end
                                        )
                                    }
                                else
                                    .value
                                end
                            ' "$DIR_MEMORIA/$part" > "$TMP_ITEMS_PART" 2>/dev/null
                            if [[ -s "$TMP_ITEMS_PART" ]]; then
                                mv -f "$TMP_ITEMS_PART" "$DIR_MEMORIA/$part" 2>/dev/null
                                if [[ "$PUEDE_ASCENDER" == "1" ]]; then
                                    LIN_ASC=$(jq -a -c -s --argjson gk "$GAN_KEY" --argjson uper "$UMBRAL_PERSISTENTE" '
                                        def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                                        (.[$gk] // null) |
                                        if (. != null and (.herramienta // 0) == 0 and (((.messages[1].content // "") | startswith("[")) | not) and (((.messages[0].content // "") | startswith("<<")) | not) and .embedding != null and norm(.embedding) >= $uper) then
                                            .
                                        else
                                            empty
                                        end
                                    ' "$DIR_MEMORIA/$part" 2>/dev/null)
                                    if [[ -n "$LIN_ASC" ]]; then
                                        ascender_a_persistente "$LIN_ASC"
                                    fi
                                fi
                            else
                                rm -f "$TMP_ITEMS_PART"
                            fi
                        fi
                    fi
                fi
            done < <(printf '%s\n' "$PARTICIONES_BUSCAR")
        fi
    fi
}

filtrar_recuerdos() {
    RECUERDOS_TURNOS="[ ]"
    if [[ -n "$CANDIDATOS_RAW" ]]; then
        RECUERDOS_TURNOS=$(jq -a -s --argjson maxm "$MAX_MEMORIA" --argjson maxh "$MAX_MEM_HERRAMIENTA" '
            unique_by(.messages[0].content) |
            to_entries |
            sort_by(-.value._sim) |
            (
                ([ .[ ] | select(.value._herr == 1) ][: $maxh]) +
                ([ .[ ] | select(.value._herr == 0) ][: $maxm])
            ) |
            sort_by(-.value._sim)[:$maxm] |
            sort_by(.key) |
            map(.value | del(._sim, ._herr))
        ' < <(printf '%s' "$CANDIDATOS_RAW") 2>/dev/null)
        if [[ -z "$RECUERDOS_TURNOS" ]]; then RECUERDOS_TURNOS="[ ]"; fi
    fi
}

# Precedencia estricta: si un modulo domina claramente (MODULO_DOMINANTE_PURO=1), no mezclar Episodica/Persistente en este turno
RECUERDOS_TURNOS="[ ]"
if [[ "${MODULO_DOMINANTE_PURO:-0}" -eq 0 ]]; then
    buscar_y_reforzar_capa "$INDICE_PERSISTENTE" "0" "$NORM_DISPARO_PER" "1" "$UMBRAL_PER"
    buscar_y_reforzar_capa "$INDICE_EPISODICA" "1" "$NORM_DISPARO_MEM" "1" "$UMBRAL_EPI"
    filtrar_recuerdos

    # Respaldo puramente vectorial: si la entrada limpia no disparo recuerdos (>= UMBRAL_SIM), combinarla geometricamente con el ultimo turno vivo del hipocampo (q + h) / ||q + h||
    NUM_REC_PUROS=$(jq -r 'length // 0' < <(echo "$RECUERDOS_TURNOS") 2>/dev/null)
    if [[ "${NUM_REC_PUROS:-0}" -eq 0 ]]; then
        if [[ "$VEC_CONSULTA" != "null" ]]; then
            if [[ -s "$HIPOCAMPO" ]]; then
                VEC_RESPALDO=$(jq -a -c -s --argjson nd "$NORM_DISPARO_HIP" '
                    (.[0]) as $q |
                    ([ .[1:][ ] | select(((.messages[0].content // "") | startswith("<<") | not) and .embedding != null and ((.embedding | map(. * .) | add | sqrt) > $nd)) ][-1].embedding // null) as $h |
                    if ($q != null and $h != null) then
                        ([$q[:1024], $h[:1024]] | transpose | map((.[0] // 0) + (.[1] // 0))) as $s |
                        (($s | map(. * .) | add | sqrt) + 0.000001) as $ns |
                        ($s | map(((. / $ns) * 10000 | round) / 10000))
                    else
                        empty
                    end
                ' < <(printf '%s\n' "$VEC_CONSULTA"; cat "$HIPOCAMPO") 2>/dev/null)
                if [[ -n "$VEC_RESPALDO" ]]; then
                    VEC_CONSULTA="$VEC_RESPALDO"
                    export VEC_CONSULTA
                    CANDIDATOS_RAW=""
                    buscar_y_reforzar_capa "$INDICE_PERSISTENTE" "0" "$NORM_DISPARO_PER" "0" "$UMBRAL_PER"
                    buscar_y_reforzar_capa "$INDICE_EPISODICA" "1" "$NORM_DISPARO_MEM" "0" "$UMBRAL_EPI"
                    filtrar_recuerdos
                fi
            fi
        fi
    fi
fi

# Funcion para cargar o re-enrutar dinamicamente las herramientas segun VEC_CONSULTA actual
cargar_herramientas() {
    TEXTO_SPEC="$1"
    SPECS=""
    if [[ -d "$DIR_HERRAMIENTAS" ]]; then
        for ruta in "$DIR_HERRAMIENTAS"/*; do
            if [[ -f "$ruta" ]]; then
                SPECS+=$("$ruta" --spec "$TEXTO_SPEC" 2>/dev/null)
            fi
        done
    fi
    TOOLS_JSON=$(jq -s '.' < <(echo "$SPECS"))
}

# Enrutar herramientas: si hubo contexto de herramienta anterior (VEC_CTX_HERR) o ningun modulo domino en solitario, enriquecer el vector con el hilo para resolver frases anaforicas ("que hay dentro")
VEC_PREV_HERR="$VEC_CONSULTA"
if [[ -n "$VEC_CTX_HERR" ]]; then
    VEC_CONSULTA="$VEC_CTX_HERR"
    export VEC_CONSULTA
elif [[ "${MODULO_DOMINANTE_PURO:-0}" -eq 0 ]]; then
    if [[ "$VEC_CONSULTA" == "$VEC_PURO" ]]; then
        if [[ "$VEC_CONSULTA" != "null" ]]; then
            if [[ -s "$HIPOCAMPO" ]]; then
                VEC_HILO_HERR=$(jq -a -c -s --argjson nd "$NORM_DISPARO_HIP" '
                    (.[0]) as $q |
                    ([ .[1:][ ] | select(((.messages[0].content // "") | startswith("<<") | not) and .embedding != null and ((.embedding | map(. * .) | add | sqrt) > $nd)) ][-1].embedding // null) as $h |
                    if ($q != null and $h != null) then
                        ([$q[:1024], $h[:1024]] | transpose | map((.[0] // 0) + (.[1] // 0))) as $s |
                        (($s | map(. * .) | add | sqrt) + 0.000001) as $ns |
                        ($s | map(((. / $ns) * 10000 | round) / 10000))
                    else
                        empty
                    end
                ' < <(printf '%s\n' "$VEC_CONSULTA"; cat "$HIPOCAMPO") 2>/dev/null)
                if [[ -n "$VEC_HILO_HERR" ]]; then
                    VEC_CONSULTA="$VEC_HILO_HERR"
                    export VEC_CONSULTA
                fi
            fi
        fi
    fi
fi
cargar_herramientas "$ENTRADA"
if [[ "$VEC_CONSULTA" != "$VEC_PREV_HERR" ]]; then
    VEC_CONSULTA="$VEC_PREV_HERR"
    export VEC_CONSULTA
fi

# 2. Cargar Hipocampo en cascada (hilo inmediato MAX_HILO + hipocampo semantico MAX_HIPOCAMPO con frescura y sensor vigente)
HIPOCAMPO_TURNOS="[ ]"
if [[ -s "$HIPOCAMPO" ]]; then
    HIPOCAMPO_TURNOS=$(jq -a -s \
        --argjson maxhl "${MAX_HILO:-2}" \
        --argjson maxh "${MAX_HIPOCAMPO:-3}" \
        --argjson nd "$NORM_DISPARO_HIP" \
        --argjson umb "$UMBRAL_SIM" \
        --argjson uref "$UMBRAL_REFUERZO" \
        --argjson ahora_ts "$TS_AHORA" \
        --arg ahora_f "$FECHA_AHORA" \
        --argjson ts_desp "$TS_DESPERTAR" \
        --argjson vig "${VIGENCIA_HERRAMIENTA:-60}" \
        --argjson umod "${UMBRAL_MODULO:-0.55}" \
        --argjson moddom "${MODULO_DOMINANTE_PURO:-0}" \
        --argjson maxsim_mod "${MAX_SIM_MOD_PURO:-0.0}" \
        --arg qtxt "$ENTRADA_VEC" '
        def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
        def dot($a; $b): reduce range(0; 1024) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
        def toks($s): [ ($s // "" | ascii_downcase | scan("[a-z0-9_-]{3,}")) ] | unique;
        def lex($qt; $txt):
            if ($qt | length) == 0 then 0.0
            else
                (toks($txt)) as $dt |
                (reduce $qt[ ] as $t (0; . + ($t | length))) as $tot |
                (reduce $qt[ ] as $t (0; . + (if ($dt | index($t)) != null then ($t | length) else 0 end))) as $hit |
                if $tot > 0 then ($hit / $tot) else 0.0 end
            end;
        def ymd_dias($y; $m; $d):
            (if $m <= 2 then ($y - 1) else $y end) as $yr |
            (if $m <= 2 then ($m + 12) else $m end) as $mo |
            (($yr * 365) + (($yr / 4) | floor) - (($yr / 100) | floor) + (($yr / 400) | floor) + (((153 * ($mo - 3) + 2) / 5) | floor) + $d);
        def fseg($f):
            if ($f != null and ($f | length) >= 19) then
                (try ($f[0:4] | tonumber) catch 0) as $y |
                (try ($f[5:7] | tonumber) catch 0) as $mo |
                (try ($f[8:10] | tonumber) catch 0) as $d |
                (try ($f[11:13] | tonumber) catch 0) as $h |
                (try ($f[14:16] | tonumber) catch 0) as $mi |
                (try ($f[17:19] | tonumber) catch 0) as $s |
                if $y > 0 then ((ymd_dias($y; $mo; $d) * 86400) + ($h * 3600) + ($mi * 60) + $s) else 0 end
            else 0 end;
        (fseg($ahora_f)) as $ahora_seg |
        (($uref + 1.0) / 2) as $u_rep |
        (toks($qtxt)) as $qtoks |
        (.[0]) as $q |
        (if $q != null then norm($q) else 1 end) as $nq |
        [
            .[1:][ ] |
            select(type == "object" and (.embedding == null or norm(.embedding) > $nd))
        ] |
        to_entries |
        map(
            .key as $idx |
            .value |
            ((.herramienta // 0) == 1 or ((.messages[1].content // "") | startswith("["))) as $es_herr |
            (
                if (.ts != null and (.ts | type) == "number") then
                    ($ahora_ts - .ts)
                else
                    (fseg(.fecha)) as $fs |
                    if $fs > 0 then ($ahora_seg - $fs) else 999999 end
                end | if . < 0 then 0 else . end
            ) as $edad |
            (
                if ($es_herr and ($edad > $vig or ($ts_desp > 0 and ((.ts // ($ahora_ts - $edad)) < $ts_desp)))) then 1 else 0 end
            ) as $cad |
            (if ($q != null and .emb_u != null) then (dot(.emb_u; $q) / (norm(.emb_u) * $nq)) else 0 end) as $c_u |
            (if ($q != null and .embedding != null) then (dot(.embedding; $q) / (norm(.embedding) * $nq)) else 0 end) as $c_e |
            (if $c_u > $c_e then $c_u else $c_e end) as $c_max |
            (lex($qtoks; ((.messages[0].content // "") + " " + (.messages[1].content // "")))) as $lx |
            {
                idx: $idx,
                fecha: .fecha,
                ts: (.ts // null),
                messages: .messages,
                sensor: (if ($cad == 0 and .sensor != null and (.sensor | length) > 0) then .sensor else null end),
                _herr: (if $es_herr then 1 else 0 end),
                _cad: $cad,
                _c_u: $c_u,
                _cos: $c_max,
                _lex: $lx,
                _oculto: (
                    if ((.valencia // 0) < 0) then
                        1
                    elif ($q != null) then
                        if $es_herr then
                            (if ($c_u >= $u_rep or ($cad == 1 and $c_u >= $umb)) then 1 else 0 end)
                        elif (($moddom == 1 or $maxsim_mod >= $umod) and $c_u >= $umb) then
                            1
                        else
                            0
                        end
                    else
                        0
                    end
                )
            }
        ) as $vivos |
        ($vivos | length) as $tot |
        (if ($tot - $maxhl) > 0 then ($tot - $maxhl) else 0 end) as $corte |
        ([ $vivos[$corte:][ ] | select(._oculto == 0 and ($moddom == 0 or ._herr == 1)) ]) as $hilo |
        (
            if ($q != null and $corte > 0 and $moddom == 0) then
                [ $vivos[:$corte][ ] | select(._oculto == 0 and (._cos >= $umb or (._lex >= $umb and ._cos >= ($umb * 0.75)))) ] |
                sort_by(-._cos) | to_entries | map(.value + {_rsem: .key}) |
                sort_by(-._lex, -._cos) | to_entries | map(.value + {_rlex: .key}) |
                map(. + {_rrf: ((1 / (20 + ._rsem)) + (if ._lex > 0 then (1 / (20 + ._rlex)) else 0 end))}) |
                sort_by(-._rrf)[:$maxh] |
                sort_by(.idx)
            else
                [ ]
            end
        ) as $hip_sim |
        ($hip_sim + $hilo) |
        map({fecha: .fecha, ts: .ts, messages: .messages, sensor: .sensor, _cos: ._cos})
    ' < <(printf '%s\n' "${VEC_PURO:-null}"; cat "$HIPOCAMPO") 2>/dev/null)
    if [[ -z "$HIPOCAMPO_TURNOS" ]]; then HIPOCAMPO_TURNOS="[ ]"; fi
fi

# 2b. Memoria Reloj (conciencia de estado: se activa automaticamente al despertar, aburrirse/silencio o dormir; en charla normal solo si pregunta por el ciclo biologico)
ES_CAMBIO_ESTADO=0
ES_DESPERTAR=0
if [[ "$ENTRADA" == *"$ESTIMULO_DESPERTAR"* ]]; then ES_CAMBIO_ESTADO=1; ES_DESPERTAR=1; fi
if [[ "$ENTRADA" == *"$ESTIMULO_SILENCIO"* ]]; then ES_CAMBIO_ESTADO=1; fi
if [[ "$ENTRADA" == *"$ESTIMULO_DORMIR"* ]]; then ES_CAMBIO_ESTADO=1; fi

RELOJ_TURNOS="[ ]"
if [[ -s "$RELOJ" ]]; then
    if [[ "$ES_CAMBIO_ESTADO" -eq 1 ]]; then
        RELOJ_TURNOS=$(jq -a -s --argjson maxr "${MAX_RELOJ:-2}" --argjson desp "$ES_DESPERTAR" '
            [ .[ ] | select(type == "object" and .messages != null) ] as $evs |
