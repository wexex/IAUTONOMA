                                read -r ES_ACIERTO SUMA_SIM < <(jq -r -n --argjson s "$SIM_VAL" --argjson uref "$UMBRAL_REFUERZO" --argjson acc "$SUMA_SIM" '
                                    [(if $s >= $uref then 1 else 0 end), ($acc + $s)] | map(tostring) | join(" ")
