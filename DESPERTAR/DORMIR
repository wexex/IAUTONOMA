                                SPEC_RD=$(VEC_CONSULTA="$VEC_RD" "$DIR_HERRAMIENTAS/bash" --spec "$PREG_R" 2>/dev/null)
                                TOOLS_RD=$(jq -s '.' < <(printf '%s' "$SPEC_RD") 2>/dev/null)
                                if [[ -z "$TOOLS_RD" ]]; then TOOLS_RD="[ ]"; fi

                                PAY_REM=$(jq -a -n --arg sys "$SYS_REM_HERR" --arg u "$PREG_R" --argjson tls "$TOOLS_RD" --argjson temp "$TEMPERATURA" --argjson rpen "${PENALIZACION_REPETICION:-1.05}" '{
                                    messages: [
                                        {"role": "system", "content": $sys},
                                        {"role": "user", "content": $u}
