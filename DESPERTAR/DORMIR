                                RESP_REM=$(curl -sf "$URL" -H "Content-Type: application/json" -d "$PAY_REM" 2>/dev/null)
                                TC_D=$(jq -r '(.choices[0].message.tool_calls // [ ]) | length' < <(printf '%s' "$RESP_REM") 2>/dev/null)
                                TXT_REM=""
                                if [[ "${TC_D:-0}" -eq 0 ]]; then
                                    TXT_REM=$(jq -r '(.choices[0].message.content // "") | gsub("[\r\n]+"; " ")' < <(printf '%s' "$RESP_REM") 2>/dev/null)
                                fi

                                SIM_VAL="0"
                                if [[ -n "$TXT_REM" ]]; then
                                    PAY_SIM=$(jq -a -n --arg a "$TXT_REM" --arg b "$ESP_R" '{input: [$a, $b]}')
                                    RESP_SIM=$(curl -sf "$URL_MEMORIA" -H "Content-Type: application/json" -d "$PAY_SIM" 2>/dev/null)
                                    SIM_VAL=$(jq -r '
                                        def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                                        def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                                        if (.data and (.data | length) >= 2) then
                                            (dot(.data[0].embedding; .data[1].embedding) / (norm(.data[0].embedding) * norm(.data[1].embedding)))
                                        else
