#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/CONFIG"

UN_CICLO=0
if [[ "$1" == "--un-ciclo" ]]; then UN_CICLO=1; fi

mkdir -p "$DIR_SUENO" "$DIR_REGISTROS" "$DIR_LORA_DATASETS" "$DIR_LORA_PESOS"

# Evitar instancias duplicadas de DORMIR
if [[ -s "$PID_DORMIR" ]]; then
    PID_PREV=$(cat "$PID_DORMIR" 2>/dev/null)
    if [[ -n "$PID_PREV" ]]; then
        if [[ "$PID_PREV" != "$$" ]]; then
            if kill -0 "$PID_PREV" 2>/dev/null; then
                exit 0
            fi
        fi
    fi
fi

echo "$$" > "$PID_DORMIR"
ULTIMA_AL_DORMIR=""
if [[ -s "$ULTIMA_INTERACCION" ]]; then
    ULTIMA_AL_DORMIR=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
fi

registrar_sueno() {
    printf '[%s] %s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$1" >> "$LOG_SUENO"
}

registrar_reloj_sueno() {
    RES_REL="$1"
    F_RS=$(date "+%Y-%m-%d %H:%M:%S")
    TS_RS=$(date +%s)
    if [[ ! -f "$RELOJ" ]]; then > "$RELOJ"; fi
    LIN_RS=$(jq -a -c -n --arg f "$F_RS" --argjson ts "$TS_RS" --arg a "$RES_REL" '{
        fecha: $f,
        ts: $ts,
        evento: "sueno",
        messages: [
            {"role": "user", "content": "<<Sueno consolidado>>"},
            {"role": "assistant", "content": $a}
        ],
        embedding: null
    }' 2>/dev/null)
    if [[ -n "$LIN_RS" ]]; then
        RELOJ_S=$(jq -a -c -s --argjson maxp "$MAX_PARTICION" '.[-$maxp:][ ]' < <(cat "$RELOJ"; printf '%s\n' "$LIN_RS") 2>/dev/null)
        if [[ -n "$RELOJ_S" ]]; then
            printf '%s\n' "$RELOJ_S" > "${RELOJ}.$$.tmp"
            mv -f "${RELOJ}.$$.tmp" "$RELOJ" 2>/dev/null
        fi
    fi
}

dormir_puerto() {
    P_OBJ="$1"
    if command -v taskkill >/dev/null 2>/dev/null; then
        while IFS= read -r win_pid; do
            if [[ -n "$win_pid" ]]; then
                if [[ "$win_pid" != "0" ]]; then
                    taskkill //F //T //PID "$win_pid" >/dev/null 2>/dev/null
                fi
            fi
        done < <(awk -v p=":$P_OBJ" '$4 == "LISTENING" { if (substr($2, length($2) - length(p) + 1) == p) print $5 }' < <(netstat -ano 2>/dev/null))
    elif command -v fuser >/dev/null 2>/dev/null; then
        fuser -k "${P_OBJ}/tcp" >/dev/null 2>/dev/null
    fi
}

apagar_servidores() {
    dormir_puerto "$PUERTO"
    dormir_puerto "$PUERTO_MEMORIA"
}

REM_ACTIVO=0
limpiar_al_salir() {
    if [[ $REM_ACTIVO -eq 1 ]]; then
        apagar_servidores
        REM_ACTIVO=0
    fi
    if [[ -s "$LOCK_MEMORIA" ]]; then
        LPID_S=$(cat "$LOCK_MEMORIA" 2>/dev/null)
        if [[ "$LPID_S" == "$$" ]]; then
            rm -f "$LOCK_MEMORIA" 2>/dev/null
        fi
    fi
    rm -rf "$DIR_SANDBOX_SUENO" 2>/dev/null
    rm -f "$PID_DORMIR" 2>/dev/null
}
trap limpiar_al_salir EXIT
trap 'limpiar_al_salir; exit 143' TERM
trap 'limpiar_al_salir; exit 130' INT

DESPERTO=0
comprobar_despertar() {
    DESPERTO=0
    if [[ -f "$SENAL_DESPERTAR" ]]; then
        DESPERTO=1
    elif [[ -s "$ULTIMA_INTERACCION" ]]; then
        ULT_ACT=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
        if [[ -n "$ULTIMA_AL_DORMIR" ]]; then
            if [[ "$ULT_ACT" != "$ULTIMA_AL_DORMIR" ]]; then
                DESPERTO=1
                date +%s > "$SENAL_DESPERTAR"
            fi
        fi
    fi
}

# Localizar Python y entrenador
PY_BIN="$DIR_ENTRENAMIENTO/venv/Scripts/python.exe"
if [[ ! -x "$PY_BIN" ]]; then
    PY_BIN="$DIR_ENTRENAMIENTO/venv/bin/python"
fi
SCRIPT_PY="$DIR_ENTRENAMIENTO/entrenar_lora.py"

if [[ ! -x "$PY_BIN" ]]; then
    registrar_sueno "[ERROR] No existe entorno Python en $DIR_ENTRENAMIENTO/venv"
    exit 1
fi
if [[ ! -s "$SCRIPT_PY" ]]; then
    registrar_sueno "[ERROR] No existe entrenador $SCRIPT_PY"
    exit 1
fi

vaciar_aprobados_capa() {
    PART_VAC="$1"
    ARCH_APROB="$2"
    IND_OBJ="$3"
    RUTA_PART="$DIR_MEMORIA/$PART_VAC"

    if [[ -s "$RUTA_PART" ]]; then
        if [[ -s "$ARCH_APROB" ]]; then
            ESPERA_L=0
            while [[ $ESPERA_L -lt 100 ]]; do
                if [[ ! -s "$LOCK_MEMORIA" ]]; then break; fi
                LPID_L=$(cat "$LOCK_MEMORIA" 2>/dev/null)
                if [[ -z "$LPID_L" ]]; then break; fi
                if ! kill -0 "$LPID_L" 2>/dev/null; then
                    rm -f "$LOCK_MEMORIA" 2>/dev/null
                    break
                fi
                sleep 0.1
                ESPERA_L=$((ESPERA_L + 1))
            done
            echo "$$" > "$LOCK_MEMORIA"

            QUEDAN_JSON=$(jq -a -c -s '
                (.[0]) as $aprob |
                .[1:][ ] |
                select((.messages[0].content // "") as $u | ($aprob | index($u)) == null)
            ' < <(jq -a -R -s 'split("\n") | map(gsub("\r$"; "") | select(length > 0))' "$ARCH_APROB"; cat "$RUTA_PART") 2>/dev/null)

            if [[ -n "$QUEDAN_JSON" ]]; then
                printf '%s\n' "$QUEDAN_JSON" > "${RUTA_PART}.$$.tmp"
                mv -f "${RUTA_PART}.$$.tmp" "$RUTA_PART" 2>/dev/null
                LINEAS_Q=$(( $(wc -l < "$RUTA_PART") ))
                if [[ -s "$IND_OBJ" ]]; then
                    IND_ACT=$(jq -a -c --arg arch "$PART_VAC" --argjson lq "$LINEAS_Q" '
                        if .archivo == $arch then . + {lineas: $lq} else . end
                    ' "$IND_OBJ" 2>/dev/null)
                    if [[ -n "$IND_ACT" ]]; then
                        printf '%s\n' "$IND_ACT" > "${IND_OBJ}.$$.tmp"
                        mv -f "${IND_OBJ}.$$.tmp" "$IND_OBJ" 2>/dev/null
                    fi
                fi
            else
                rm -f "$RUTA_PART" 2>/dev/null
                if [[ -s "$IND_OBJ" ]]; then
                    IND_ACT=$(jq -a -c --arg arch "$PART_VAC" 'select(.archivo != $arch)' "$IND_OBJ" 2>/dev/null)
                    if [[ -n "$IND_ACT" ]]; then
                        printf '%s\n' "$IND_ACT" > "${IND_OBJ}.$$.tmp"
                        mv -f "${IND_OBJ}.$$.tmp" "$IND_OBJ" 2>/dev/null
                    else
                        > "$IND_OBJ"
                    fi
                fi
            fi

            rm -f "$LOCK_MEMORIA" 2>/dev/null
        fi
    fi
}

actualizar_indice_lora() {
    NOM_IDX="$1"
    LIN_IDX="$2"
    ARCH_CENT="$3"

    if [[ ! -f "$INDICE_LORA_DATASETS" ]]; then > "$INDICE_LORA_DATASETS"; fi
    CENT_EMB="null"
    if [[ -s "$ARCH_CENT" ]]; then
        CENT_EMB=$(cat "$ARCH_CENT" 2>/dev/null)
        if [[ -z "$CENT_EMB" ]]; then CENT_EMB="null"; fi
    fi

    NUEVO_IND=$(jq -a -c -s --arg nom "$NOM_IDX" --argjson lin "$LIN_IDX" '
        (.[0:-1]) as $idx |
        (.[-1]) as $emb |
        (
            [ $idx[ ] | select(.nombre != $nom) ] +
            [{nombre: $nom, lineas: $lin, embedding: $emb}]
        )[ ]
    ' < <(cat "$INDICE_LORA_DATASETS"; printf '%s\n' "$CENT_EMB") 2>/dev/null)

    if [[ -n "$NUEVO_IND" ]]; then
        printf '%s\n' "$NUEVO_IND" > "${INDICE_LORA_DATASETS}.$$.tmp"
        mv -f "${INDICE_LORA_DATASETS}.$$.tmp" "$INDICE_LORA_DATASETS" 2>/dev/null
    fi
}

quitar_de_rectificar() {
    NOM_Q="$1"
    if [[ -s "$LORAS_RECTIFICAR" ]]; then
        REST_R=$(grep -Fxv "$NOM_Q" "$LORAS_RECTIFICAR" 2>/dev/null)
        if [[ -n "$REST_R" ]]; then
            printf '%s\n' "$REST_R" > "${LORAS_RECTIFICAR}.$$.tmp"
            mv -f "${LORAS_RECTIFICAR}.$$.tmp" "$LORAS_RECTIFICAR" 2>/dev/null
        else
            rm -f "$LORAS_RECTIFICAR" 2>/dev/null
        fi
    fi
}

purgar_lora_obsoleto() {
    NOM_P="$1"
    rm -f "$DIR_LORA_PESOS/${NOM_P}.gguf" "$DIR_LORA_DATASETS/${NOM_P}.jsonl" "$DIR_LORA/${NOM_P}.desc" 2>/dev/null
    if [[ -s "$INDICE_LORA_DATASETS" ]]; then
        IND_P=$(jq -a -c --arg nom "$NOM_P" 'select(.nombre != $nom)' "$INDICE_LORA_DATASETS" 2>/dev/null)
        if [[ -n "$IND_P" ]]; then
            printf '%s\n' "$IND_P" > "${INDICE_LORA_DATASETS}.$$.tmp"
            mv -f "${INDICE_LORA_DATASETS}.$$.tmp" "$INDICE_LORA_DATASETS" 2>/dev/null
        else
            > "$INDICE_LORA_DATASETS"
        fi
    fi
    if [[ -s "$INDICE_LORA" ]]; then
        IND_ML=$(jq -a -c --arg nom "$NOM_P" 'select(.nombre != $nom)' "$INDICE_LORA" 2>/dev/null)
        if [[ -n "$IND_ML" ]]; then
            printf '%s\n' "$IND_ML" > "${INDICE_LORA}.$$.tmp"
            mv -f "${INDICE_LORA}.$$.tmp" "$INDICE_LORA" 2>/dev/null
        else
            > "$INDICE_LORA"
        fi
    fi
    rm -f "$DIR_MEM_LORA/huella" 2>/dev/null
    quitar_de_rectificar "$NOM_P"
    rm -rf "$DIR_SUENO/$NOM_P" 2>/dev/null
}

# FASE 1: SUENO LIGERO (Solo prepara: organiza por clase vectorial declarativa o procedimental, fusiona <50% o abre particion correlativa y arma dataset)
fase_ligero() {
    TAREA_ELEGIDA=""
    PART_ELEGIDA=""

    MAX_LORA="${MAX_EJEMPLOS_LORA:-10}"
    MITAD_LORA=$(( MAX_LORA / 2 ))
    if [[ $MITAD_LORA -lt 1 ]]; then MITAD_LORA=1; fi

    LISTA_CLAVES=( )
    LISTA_TIPOS=( )
    LISTA_CLASES=( )
    LISTA_PARTS=( )
    PARTS_EN_CURSO=( )

    # 1a. Tareas ya preparadas / pausadas / rectificaciones en SUENO/
    for est in "$DIR_SUENO"/*/estado.json; do
        if [[ -s "$est" ]]; then
            NOM_E=$(jq -r '.nombre // empty' "$est" 2>/dev/null)
            PART_E=$(jq -r '.particion // empty' "$est" 2>/dev/null)
            FASE_E=$(jq -r '.fase // empty' "$est" 2>/dev/null)
            CLASE_E=$(jq -r '.clase // "declarativo"' "$est" 2>/dev/null)
            if [[ -n "$NOM_E" ]]; then
                if [[ "$FASE_E" == "purgar" ]]; then
                    purgar_lora_obsoleto "$NOM_E"
                    registrar_sueno "[N1/N2 LIGERO] LoRA $NOM_E purgado tras rectificacion (< $MIN_RECUERDOS_SUENO ejemplos validos)."
                    printf '[%s] PURGA_RECTIFICACION LoRA=%s | clase=%s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$NOM_E" "$CLASE_E" >> "$LOG_LORA_ENTRENAR"
                elif [[ "$FASE_E" != "completado" ]]; then
                    LISTA_CLAVES+=("$NOM_E")
                    LISTA_TIPOS+=("activa")
                    LISTA_CLASES+=("$CLASE_E")
                    LISTA_PARTS+=("$PART_E")
                    if [[ -n "$PART_E" ]]; then
                        PARTS_EN_CURSO+=("$PART_E")
                    fi
                fi
            fi
        fi
    done

    # 1b. Particiones persistentes (declarativas) con >= MIN_RECUERDOS_SUENO recuerdos validos
    for pf in "$DIR_MEMORIA/${PREFIJO_PERSISTENTE}_"*.json; do
        if [[ -s "$pf" ]]; then
            BASE_P="$(basename "$pf")"
            EN_CURSO=0
            for pe in "${PARTS_EN_CURSO[@]}"; do
                if [[ "$pe" == "$BASE_P" ]]; then EN_CURSO=1; fi
            done
            if [[ $EN_CURSO -eq 0 ]]; then
                VALIDOS_P=$(jq -r -s '
                    [
                        .[ ] |
                        select(
                            type == "object" and
                            (.herramienta // 0) == 0 and
                            (((.messages[0].content // "") | length) > 0) and
                            (((.messages[1].content // "") | length) > 0) and
                            (((.messages[0].content // "") | startswith("<<")) | not) and
                            (((.messages[1].content // "") | startswith("[")) | not)
                        )
                    ] | unique_by(.messages[0].content) | length
                ' "$pf" 2>/dev/null)
                if [[ "${VALIDOS_P:-0}" -ge "${MIN_RECUERDOS_SUENO:-3}" ]]; then
                    LISTA_CLAVES+=("NUEVA::$BASE_P")
                    LISTA_TIPOS+=("nueva")
                    LISTA_CLASES+=("declarativo")
                    LISTA_PARTS+=("$BASE_P")
                fi
            fi
        fi
    done

    # 1c. Particiones procedimentales (trazas completas de herramientas: usar + leer)
    for pf in "$DIR_MEMORIA/${PREFIJO_PROCEDIMENTAL}_"*.json; do
        if [[ -s "$pf" ]]; then
            BASE_P="$(basename "$pf")"
            EN_CURSO=0
            for pe in "${PARTS_EN_CURSO[@]}"; do
                if [[ "$pe" == "$BASE_P" ]]; then EN_CURSO=1; fi
            done
            if [[ $EN_CURSO -eq 0 ]]; then
                VALIDOS_H=$(jq -r -s '
                    [
                        .[ ] |
                        select(
                            type == "object" and
                            (.messages | type) == "array" and
                            (.messages | length) >= 4 and
                            (((.messages[0].content // "") | length) > 0) and
                            (((.messages[-1].content // "") | length) > 0) and
                            (.messages[-1].role == "assistant") and
                            any(.messages[ ]; .tool_calls != null and (.tool_calls | length) > 0) and
                            any(.messages[ ]; .role == "tool")
                        )
                    ] | unique_by(.messages[0].content) | length
                ' "$pf" 2>/dev/null)
                if [[ "${VALIDOS_H:-0}" -ge "${MIN_RECUERDOS_SUENO:-3}" ]]; then
                    LISTA_CLAVES+=("NUEVA::$BASE_P")
                    LISTA_TIPOS+=("nueva")
                    LISTA_CLASES+=("procedimental")
                    LISTA_PARTS+=("$BASE_P")
                fi
            fi
        fi
    done

    TOTAL_T="${#LISTA_CLAVES[@]}"
    if [[ $TOTAL_T -eq 0 ]]; then
        registrar_sueno "[N1/N2 LIGERO] Sin particiones persistentes ni procedimentales pendientes (minimo: $MIN_RECUERDOS_SUENO recuerdos)."
    else
        # Secuenciacion round-robin para rotar entre diferentes entrenamientos
        IDX_SEL=0
        ULT_TURNO=""
        if [[ -s "$DIR_SUENO/ultimo_turno" ]]; then
            ULT_TURNO=$(cat "$DIR_SUENO/ultimo_turno" 2>/dev/null)
        fi
        if [[ -n "$ULT_TURNO" ]]; then
            if [[ $TOTAL_T -gt 1 ]]; then
                for (( i_t=0; i_t<TOTAL_T; i_t++ )); do
                    if [[ "${LISTA_CLAVES[$i_t]}" == "$ULT_TURNO" ]]; then
                        IDX_SEL=$(( (i_t + 1) % TOTAL_T ))
                        break
                    fi
                done
            fi
        fi

        CLAVE_SEL="${LISTA_CLAVES[$IDX_SEL]}"
        TIPO_SEL="${LISTA_TIPOS[$IDX_SEL]}"
        CLASE_SEL="${LISTA_CLASES[$IDX_SEL]}"
        PART_ELEGIDA="${LISTA_PARTS[$IDX_SEL]}"

        if [[ "$TIPO_SEL" == "activa" ]]; then
            TAREA_ELEGIDA="$CLAVE_SEL"
            DIR_TAREA="$DIR_SUENO/$TAREA_ELEGIDA"
            FASE_PRE=$(jq -r '.fase // "profundo"' "$DIR_TAREA/estado.json" 2>/dev/null)
            CICLO_PRE=$(jq -r '.ciclo // 0' "$DIR_TAREA/estado.json" 2>/dev/null)
            registrar_sueno "[N1/N2 LIGERO] Reanudando $TAREA_ELEGIDA (clase=$CLASE_SEL, fase=$FASE_PRE, ciclo=$CICLO_PRE)."
        else
            PREF_NOM="sueno_"
            if [[ "$CLASE_SEL" == "procedimental" ]]; then
                PREF_NOM="sueno_herr_"
            fi

            # Calcular centroide unitario real de los recuerdos validos de la particion
            if [[ "$CLASE_SEL" == "procedimental" ]]; then
                CENT_PART=$(jq -a -c -s '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    [
                        .[ ] |
                        select(
                            type == "object" and
                            (.messages | type) == "array" and
                            (.messages | length) >= 4 and
                            (((.messages[0].content // "") | length) > 0) and
                            (((.messages[-1].content // "") | length) > 0) and
                            (.messages[-1].role == "assistant") and
                            any(.messages[ ]; .tool_calls != null and (.tool_calls | length) > 0) and
                            any(.messages[ ]; .role == "tool") and
                            .embedding != null and ((.embedding | length) > 0)
                        )
                    ] | unique_by(.messages[0].content) |
                    if length > 0 then
                        ([ .[ ].embedding | (norm(.)) as $n | map(. / $n) ]) as $units |
                        ($units[0] | length) as $dim |
                        (reduce range(0; $dim) as $i ([ ]; . + [(reduce $units[ ] as $u (0; . + ($u[$i] // 0))) / ($units | length)])) as $mean |
                        (norm($mean)) as $nm |
                        ($mean | map(((. / $nm) * 10000 | round) / 10000))
                    else
                        null
                    end
                ' "$DIR_MEMORIA/$PART_ELEGIDA" 2>/dev/null)
            else
                CENT_PART=$(jq -a -c -s '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    [
                        .[ ] |
                        select(
                            type == "object" and
                            (.herramienta // 0) == 0 and
                            (((.messages[0].content // "") | length) > 0) and
                            (((.messages[1].content // "") | length) > 0) and
                            (((.messages[0].content // "") | startswith("<<")) | not) and
                            (((.messages[1].content // "") | startswith("[")) | not) and
                            .embedding != null and ((.embedding | length) > 0)
                        )
                    ] | unique_by(.messages[0].content) |
                    if length > 0 then
                        ([ .[ ].embedding | (norm(.)) as $n | map(. / $n) ]) as $units |
                        ($units[0] | length) as $dim |
                        (reduce range(0; $dim) as $i ([ ]; . + [(reduce $units[ ] as $u (0; . + ($u[$i] // 0))) / ($units | length)])) as $mean |
                        (norm($mean)) as $nm |
                        ($mean | map(((. / $nm) * 10000 | round) / 10000))
                    else
                        null
                    end
                ' "$DIR_MEMORIA/$PART_ELEGIDA" 2>/dev/null)
            fi
            if [[ -z "$CENT_PART" ]]; then CENT_PART="null"; fi

            # Buscar LoRA existente de la misma clase vectorial con < 50% de MAX_EJEMPLOS_LORA para fusionar
            LORA_FUSION=""
            LINEAS_FUSION=0
            EMB_FUSION="null"
            if [[ "$CENT_PART" != "null" ]]; then
                if [[ -s "$INDICE_LORA_DATASETS" ]]; then
                    CAND_FUSION=$(jq -a -c -s --arg clase "$CLASE_SEL" --argjson umb "$UMBRAL_SIM" --argjson mitad "$MITAD_LORA" '
                        def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                        def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                        (.[0:-1]) as $idx |
                        (.[-1]) as $q |
                        (norm($q)) as $nq |
                        [
                            $idx[ ] |
                            ((.nombre // "") | startswith("sueno_herr_")) as $es_herr |
                            ((.nombre // "") | startswith("sueno_")) as $es_sueno |
                            select(
                                (
                                    if $clase == "procedimental" then
                                        $es_herr
                                    else
                                        ($es_sueno and ($es_herr | not))
                                    end
                                ) and
                                ((.lineas // 0) > 0) and
                                ((.lineas // 0) < $mitad) and
                                .embedding != null and
                                ((.embedding | length) == ($q | length))
                            ) |
                            (norm(.embedding)) as $ne |
                            . + {_sim: (dot(.embedding; $q) / ($ne * $nq))} |
                            select(._sim >= $umb)
                        ] | sort_by(-._sim) | .[0] // empty
                    ' < <(cat "$INDICE_LORA_DATASETS"; printf '%s\n' "$CENT_PART") 2>/dev/null)

                    if [[ -n "$CAND_FUSION" ]]; then
                        NOM_F=$(jq -r '.nombre // empty' < <(printf '%s' "$CAND_FUSION") 2>/dev/null)
                        if [[ -n "$NOM_F" ]]; then
                            EN_RECT_F=0
                            if [[ -s "$LORAS_RECTIFICAR" ]]; then
                                if grep -Fxq "$NOM_F" "$LORAS_RECTIFICAR" 2>/dev/null; then
                                    EN_RECT_F=1
                                fi
                            fi
                            if [[ $EN_RECT_F -eq 0 ]]; then
                                if [[ ! -d "$DIR_SUENO/$NOM_F" ]]; then
                                    if [[ -s "$DIR_LORA_DATASETS/${NOM_F}.jsonl" ]]; then
                                        LORA_FUSION="$NOM_F"
                                        LINEAS_FUSION=$(jq -r '.lineas // 0' < <(printf '%s' "$CAND_FUSION") 2>/dev/null)
                                        EMB_FUSION=$(jq -a -c '.embedding // null' < <(printf '%s' "$CAND_FUSION") 2>/dev/null)
                                    fi
                                fi
                            fi
                        fi
                    fi
                fi
            fi

            ES_FUSION=0
            CUPO_NUEVOS="$MAX_LORA"
            if [[ -n "$LORA_FUSION" ]]; then
                TAREA_ELEGIDA="$LORA_FUSION"
                ES_FUSION=1
                CUPO_NUEVOS=$(( MAX_LORA - LINEAS_FUSION ))
                if [[ $CUPO_NUEVOS -lt 1 ]]; then CUPO_NUEVOS=1; fi
            else
                # Particion nueva correlativa sin sobrescribir ningun LoRA ni dataset previo
                N_SUENO=1
                while true; do
                    CAND_N="${PREF_NOM}${N_SUENO}"
                    OCUPADO=0
                    if [[ -e "$DIR_LORA_DATASETS/${CAND_N}.jsonl" ]]; then OCUPADO=1; fi
                    if [[ -e "$DIR_LORA_PESOS/${CAND_N}.gguf" ]]; then OCUPADO=1; fi
                    if [[ -d "$DIR_SUENO/${CAND_N}" ]]; then OCUPADO=1; fi
                    if [[ -s "$INDICE_LORA_DATASETS" ]]; then
                        if jq -e -s --arg n "$CAND_N" 'any(.[ ]; .nombre == $n)' "$INDICE_LORA_DATASETS" >/dev/null 2>/dev/null; then
                            OCUPADO=1
                        fi
                    fi
                    if [[ $OCUPADO -eq 0 ]]; then
                        TAREA_ELEGIDA="$CAND_N"
                        break
                    fi
                    N_SUENO=$((N_SUENO + 1))
                done
            fi

            DIR_TAREA="$DIR_SUENO/$TAREA_ELEGIDA"
            mkdir -p "$DIR_TAREA"

            EMB_REF="$CENT_PART"
            if [[ $ES_FUSION -eq 1 ]]; then
                if [[ "$EMB_FUSION" != "null" ]]; then
                    EMB_REF="$EMB_FUSION"
                fi
            fi

            if [[ "$CLASE_SEL" == "procedimental" ]]; then
                NUEVOS_SEL=$(jq -a -c -s --argjson cupo "$CUPO_NUEVOS" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    (.[0:-1]) as $items |
                    (.[-1]) as $ref |
                    [
                        $items[ ] |
                        select(
                            type == "object" and
                            (.messages | type) == "array" and
                            (.messages | length) >= 4 and
                            (((.messages[0].content // "") | length) > 0) and
                            (((.messages[-1].content // "") | length) > 0) and
                            (.messages[-1].role == "assistant") and
                            any(.messages[ ]; .tool_calls != null and (.tool_calls | length) > 0) and
                            any(.messages[ ]; .role == "tool")
                        )
                    ] |
                    (reduce .[ ] as $it ({}; .[$it.messages[0].content] = $it) | [ .[ ] ]) |
                    (
                        if ($ref != null and ($ref | length) > 0) then
                            (norm($ref)) as $nr |
                            map(
                                if (.embedding != null and (.embedding | length) == ($ref | length)) then
                                    . + {_s: (dot(.embedding; $ref) / (norm(.embedding) * $nr))}
                                else
                                    . + {_s: 0}
                                end
                            ) | sort_by(-._s) | map(del(._s))
                        else
                            .
                        end
                    )[:$cupo][ ]
                ' < <(cat "$DIR_MEMORIA/$PART_ELEGIDA"; printf '%s\n' "$EMB_REF") 2>/dev/null)
            else
                NUEVOS_SEL=$(jq -a -c -s --argjson cupo "$CUPO_NUEVOS" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    def dot($a; $b): reduce range(0; ($a | length)) as $i (0; . + (($a[$i] // 0) * ($b[$i] // 0)));
                    (.[0:-1]) as $items |
                    (.[-1]) as $ref |
                    [
                        $items[ ] |
                        select(
                            type == "object" and
                            (.herramienta // 0) == 0 and
                            (((.messages[0].content // "") | length) > 0) and
                            (((.messages[1].content // "") | length) > 0) and
                            (((.messages[0].content // "") | startswith("<<")) | not) and
                            (((.messages[1].content // "") | startswith("[")) | not)
                        )
                    ] |
                    (reduce .[ ] as $it ({}; .[$it.messages[0].content] = $it) | [ .[ ] ]) |
                    (
                        if ($ref != null and ($ref | length) > 0) then
                            (norm($ref)) as $nr |
                            map(
                                if (.embedding != null and (.embedding | length) == ($ref | length)) then
                                    . + {_s: (dot(.embedding; $ref) / (norm(.embedding) * $nr))}
                                else
                                    . + {_s: 0}
                                end
                            ) | sort_by(-._s) | map(del(._s))
                        else
                            .
                        end
                    )[:$cupo][ ]
                ' < <(cat "$DIR_MEMORIA/$PART_ELEGIDA"; printf '%s\n' "$EMB_REF") 2>/dev/null)
            fi

            printf '%s\n' "$NUEVOS_SEL" > "$DIR_TAREA/nuevos_raw.json"

            # Armar dataset de trabajo (fusionando con el dataset existente si ES_FUSION=1)
            if [[ "$CLASE_SEL" == "procedimental" ]]; then
                if [[ $ES_FUSION -eq 1 ]]; then
                    jq -a -c -s '
                        [
                            .[ ] |
                            select(type == "object" and (.messages | type) == "array" and (.messages | length) >= 4) |
                            {messages: .messages}
                        ] |
                        reduce .[ ] as $it ({}; .[$it.messages[0].content] = $it) |
                        [ .[ ] ][ ]
                    ' "$DIR_LORA_DATASETS/${TAREA_ELEGIDA}.jsonl" "$DIR_TAREA/nuevos_raw.json" > "$DIR_TAREA/dataset.jsonl" 2>/dev/null
                else
                    jq -a -c '{messages: .messages}' "$DIR_TAREA/nuevos_raw.json" > "$DIR_TAREA/dataset.jsonl" 2>/dev/null
                fi

                jq -a -c '
                    ([ .messages[ ] | select(.tool_calls != null and (.tool_calls | length) > 0) ][0].tool_calls[0]) as $tc |
                    ($tc.function.arguments // "{}") as $raw_args |
                    (if ($raw_args | type) == "string" then (try ($raw_args | fromjson) catch {comando: $raw_args}) else $raw_args end) as $obj_args |
                    {
                        u: (.messages[0].content // ""),
                        tool_name: ($tc.function.name // "bash"),
                        tool_cmd: ($obj_args.comando // ""),
                        tool_out: ([ .messages[ ] | select(.role == "tool") ][0].content // ""),
                        a: (.messages[-1].content // "")
                    }
                ' "$DIR_TAREA/dataset.jsonl" > "$DIR_TAREA/origen.json" 2>/dev/null
                jq -a -c '{u: (.messages[0].content // "")}' "$DIR_TAREA/nuevos_raw.json" > "$DIR_TAREA/origen_nuevos.json" 2>/dev/null
            else
                if [[ $ES_FUSION -eq 1 ]]; then
                    jq -a -c -s '
                        [
                            .[ ] |
                            select(type == "object" and (.messages | length) >= 2) |
                            {
                                messages: [
                                    {"role": "user", "content": .messages[0].content},
                                    {"role": "assistant", "content": .messages[1].content}
                                ]
                            }
                        ] |
                        reduce .[ ] as $it ({}; .[$it.messages[0].content] = $it) |
                        [ .[ ] ][ ]
                    ' "$DIR_LORA_DATASETS/${TAREA_ELEGIDA}.jsonl" "$DIR_TAREA/nuevos_raw.json" > "$DIR_TAREA/dataset.jsonl" 2>/dev/null
                else
                    jq -a -c '
                        {
                            messages: [
                                {"role": "user", "content": .messages[0].content},
                                {"role": "assistant", "content": .messages[1].content}
                            ]
                        }
                    ' "$DIR_TAREA/nuevos_raw.json" > "$DIR_TAREA/dataset.jsonl" 2>/dev/null
                fi

                jq -a -c '{u: .messages[0].content, a: .messages[1].content}' "$DIR_TAREA/dataset.jsonl" > "$DIR_TAREA/origen.json" 2>/dev/null
                jq -a -c '{u: .messages[0].content, a: .messages[1].content}' "$DIR_TAREA/nuevos_raw.json" > "$DIR_TAREA/origen_nuevos.json" 2>/dev/null
            fi

            # Calcular y guardar centroide unitario real del dataset (combinado ponderado si ES_FUSION=1)
            if [[ $ES_FUSION -eq 1 ]]; then
                CENT_FINAL=$(jq -a -c -s --argjson nold "$LINEAS_FUSION" '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    (.[0:-1]) as $nuevos |
                    (.[-1]) as $old |
                    ([ $nuevos[ ] | select(.embedding != null and (.embedding | length) > 0) | .embedding | (norm(.)) as $n | map(. / $n) ]) as $units |
                    if ($old != null and ($old | length) > 0 and ($units | length) > 0 and ($units[0] | length) == ($old | length)) then
                        ($old | length) as $dim |
                        (norm($old)) as $no |
                        ($old | map(. / $no)) as $uold |
                        (reduce range(0; $dim) as $i ([ ]; . + [(((($uold[$i] // 0) * $nold) + (reduce $units[ ] as $u (0; . + ($u[$i] // 0)))) / ($nold + ($units | length)))])) as $mean |
                        (norm($mean)) as $nm |
                        ($mean | map(((. / $nm) * 10000 | round) / 10000))
                    elif ($units | length) > 0 then
                        ($units[0] | length) as $dim |
                        (reduce range(0; $dim) as $i ([ ]; . + [(reduce $units[ ] as $u (0; . + ($u[$i] // 0))) / ($units | length)])) as $mean |
                        (norm($mean)) as $nm |
                        ($mean | map(((. / $nm) * 10000 | round) / 10000))
                    else
                        $old
                    end
                ' < <(cat "$DIR_TAREA/nuevos_raw.json"; printf '%s\n' "$EMB_FUSION") 2>/dev/null)
            else
                CENT_FINAL=$(jq -a -c -s '
                    def norm($v): ((reduce $v[ ] as $x (0; . + ($x * $x))) | sqrt) + 0.000001;
                    ([ .[ ] | select(.embedding != null and (.embedding | length) > 0) | .embedding | (norm(.)) as $n | map(. / $n) ]) as $units |
                    if ($units | length) > 0 then
                        ($units[0] | length) as $dim |
                        (reduce range(0; $dim) as $i ([ ]; . + [(reduce $units[ ] as $u (0; . + ($u[$i] // 0))) / ($units | length)])) as $mean |
                        (norm($mean)) as $nm |
                        ($mean | map(((. / $nm) * 10000 | round) / 10000))
                    else
                        null
                    end
                ' "$DIR_TAREA/nuevos_raw.json" 2>/dev/null)
            fi
            if [[ -z "$CENT_FINAL" ]]; then CENT_FINAL="null"; fi
            printf '%s\n' "$CENT_FINAL" > "$DIR_TAREA/centroide.json"
            rm -f "$DIR_TAREA/nuevos_raw.json" 2>/dev/null

            NUM_EJ=$(( $(wc -l < "$DIR_TAREA/dataset.jsonl") ))
            NUM_NUEVOS=$(( $(wc -l < "$DIR_TAREA/origen_nuevos.json") ))
            G_ACC="${GRAD_ACCUM_SUENO:-2}"
            PASOS_EP=$(( (NUM_EJ + G_ACC - 1) / G_ACC ))
            if [[ $PASOS_EP -lt 1 ]]; then PASOS_EP=1; fi
            EP_INIT=$(( ${PASOS_OBJ_SUENO:-16} / PASOS_EP ))
            if [[ $EP_INIT -lt 1 ]]; then EP_INIT=1; fi

            jq -a -n \
                --arg nom "$TAREA_ELEGIDA" \
                --arg part "$PART_ELEGIDA" \
                --arg clase "$CLASE_SEL" \
                --argjson fus "$ES_FUSION" \
                --argjson ep0 "$EP_INIT" \
                --argjson lr "${LR_SUENO:-0.0005}" \
                --argjson nej "${NUM_EJ:-0}" '{
                nombre: $nom,
                particion: $part,
                clase: $clase,
                es_fusion: $fus,
                fase: "profundo",
                ciclo: 0,
                epocas_obj: $ep0,
                mejor_epocas: 0,
                lr: $lr,
                num_ejemplos: $nej,
                mejor_errores: 9999,
                mejor_sim: 0.0,
                reset_lr: 0
            }' > "$DIR_TAREA/estado.json"

            if [[ $ES_FUSION -eq 1 ]]; then
                registrar_sueno "[N1/N2 LIGERO] Fusion preparada en $TAREA_ELEGIDA (clase=$CLASE_SEL ; $LINEAS_FUSION previos + $NUM_NUEVOS nuevos de $PART_ELEGIDA = $NUM_EJ total ; epocas_iniciales=$EP_INIT)."
            else
                registrar_sueno "[N1/N2 LIGERO] Nueva particion preparada $TAREA_ELEGIDA (clase=$CLASE_SEL ; $NUM_EJ recuerdos desde $PART_ELEGIDA ; max=$MAX_LORA ; epocas_iniciales=$EP_INIT)."
            fi

            MODO_REG_L="nueva"
            if [[ $ES_FUSION -eq 1 ]]; then MODO_REG_L="fusion"; fi
            printf '[%s] SUENO LoRA=%s | clase=%s | modo=%s | origen=%s | ejemplos=%s | epocas_obj=%s\n' \
                "$(date "+%Y-%m-%d %H:%M:%S")" "$TAREA_ELEGIDA" "$CLASE_SEL" "$MODO_REG_L" "$PART_ELEGIDA" "$NUM_EJ" "$EP_INIT" >> "$LOG_LORA_ENTRENAR"
            jq -r '"  - " + ((.u // "") | gsub("[\r\n]+"; " "))' "$DIR_TAREA/origen.json" >> "$LOG_LORA_ENTRENAR" 2>/dev/null
        fi
    fi
}

# FASE 2: SUENO PROFUNDO (Solo entrena: pausable paso a paso en CPU sobre candidato.gguf)
fase_profundo() {
    NOM_T="$1"
    DIR_T="$DIR_SUENO/$NOM_T"
    EST_F="$DIR_T/estado.json"

    apagar_servidores
    comprobar_despertar
    if [[ $DESPERTO -eq 1 ]]; then
        registrar_sueno "[N3 PROFUNDO] Despertar detectado antes de entrenar $NOM_T."
        PROFUNDO_RC=42
    else
        EP_OBJ=$(jq -r '.epocas_obj // 1' "$EST_F" 2>/dev/null)
        LR_ACT=$(jq -r '.lr // 0.0005' "$EST_F" 2>/dev/null)
        RST_LR=$(jq -r '.reset_lr // 0' "$EST_F" 2>/dev/null)
        CLASE_T=$(jq -r '.clase // "declarativo"' "$EST_F" 2>/dev/null)

        R_SCRIPT="$SCRIPT_PY"
        R_DS="$DIR_T/dataset.jsonl"
        R_OUT="$DIR_T/candidato.gguf"
        R_CKPT="$DIR_T/modelo.ckpt"
        R_CACHE="$DIR_T/cache.pt"
        R_STOP="$SENAL_DESPERTAR"
        R_MODS="$DIR_MODULOS"

        if command -v cygpath >/dev/null 2>/dev/null; then
            R_SCRIPT="$(cygpath -w "$SCRIPT_PY")"
            R_DS="$(cygpath -w "$R_DS")"
            R_OUT="$(cygpath -w "$R_OUT")"
            R_CKPT="$(cygpath -w "$R_CKPT")"
            R_CACHE="$(cygpath -w "$R_CACHE")"
            R_STOP="$(cygpath -w "$R_STOP")"
            R_MODS="$(cygpath -w "$R_MODS")"
        fi

        ARGS_EXTRA=( )
        if [[ "${RST_LR:-0}" -eq 1 ]]; then
            ARGS_EXTRA+=(--reset-lr)
        fi

        registrar_sueno "[N3 PROFUNDO] Entrenando $NOM_T (clase=$CLASE_T, epocas_obj=$EP_OBJ, lr=$LR_ACT, capas=${CAPA_INICIO_SUENO}..23)..."

        "$PY_BIN" "$R_SCRIPT" \
            --dataset "$R_DS" \
            --out "$R_OUT" \
            --base-model "$MODELO_BASE_HF" \
            --modules-dir "$R_MODS" \
            --checkpoint "$R_CKPT" \
            --cache-file "$R_CACHE" \
            --stop-file "$R_STOP" \
            --start-layer "${CAPA_INICIO_SUENO:-18}" \
            --rank "${RANGO_LORA_SUENO:-4}" \
            --alpha "${ALFA_LORA_SUENO:-16}" \
            --epochs "$EP_OBJ" \
            --lr "$LR_ACT" \
            --grad-accum "${GRAD_ACCUM_SUENO:-2}" \
            --compact \
            "${ARGS_EXTRA[@]}" >> "$LOG_SUENO" 2>> "$LOG_SUENO"
        PROFUNDO_RC=$?

        if [[ $PROFUNDO_RC -eq 42 ]]; then
            registrar_sueno "[N3 PROFUNDO] Pausado en checkpoint por despertar del usuario ($NOM_T)."
        elif [[ $PROFUNDO_RC -eq 0 ]]; then
            EST_NUEVO=$(jq -a -c '. + {fase: "rem", reset_lr: 0}' "$EST_F" 2>/dev/null)
            printf '%s\n' "$EST_NUEVO" > "${EST_F}.tmp"
            mv -f "${EST_F}.tmp" "$EST_F" 2>/dev/null
            registrar_sueno "[N3 PROFUNDO] Epoca(s) completada(s) y candidato exportado ($NOM_T). Pasando a REM."
        else
            registrar_sueno "[N3 PROFUNDO] Error en entrenamiento de $NOM_T (rc=$PROFUNDO_RC)."
        fi
    fi
}

crear_sandbox_sueno() {
    rm -rf "$DIR_SANDBOX_SUENO" 2>/dev/null
    mkdir -p \
        "$DIR_SANDBOX_SUENO/DESPERTAR" \
        "$DIR_SANDBOX_SUENO/HERRAMIENTAS" \
        "$DIR_SANDBOX_SUENO/MODULOS" \
        "$DIR_SANDBOX_SUENO/LORA/DATASETS" \
        "$DIR_SANDBOX_SUENO/MEMORIA/MODULOS" \
        "$DIR_SANDBOX_SUENO/MEMORIA/LORA" \
        "$DIR_SANDBOX_SUENO/REGISTROS/OLVIDO"
}

poblar_sandbox_recuerdo() {
    CMD_REC="$1"
    OUT_REC="$2"
    CMD_REC="${CMD_REC#\# Modulo: }"
    CMD_REC="${CMD_REC#\# modulo: }"
    CMD_REC="${CMD_REC#Modulo: }"
    CMD_REC="${CMD_REC#bash:}"
    CMD_REC="${CMD_REC#bash }"
    MOD_REC="${CMD_REC%% *}"
    REST_REC="${CMD_REC#"$MOD_REC"}"
    REST_REC="${REST_REC# }"
    ARG_REC="${REST_REC%% *}"
    ARG_REL="${ARG_REC#/}"

    if [[ "$MOD_REC" == "mirar" ]]; then
        if [[ -n "$ARG_REL" ]]; then
            if [[ "$ARG_REL" != *".."* ]]; then
                if [[ "$OUT_REC" == Error:* ]]; then
                    rm -f "$DIR_SANDBOX_SUENO/$ARG_REL" 2>/dev/null
                else
                    mkdir -p "$DIR_SANDBOX_SUENO/$(dirname "$ARG_REL")" 2>/dev/null
                    printf '%s\n' "$OUT_REC" > "$DIR_SANDBOX_SUENO/$ARG_REL" 2>/dev/null
                fi
            fi
        fi
    elif [[ "$MOD_REC" == "listar" ]]; then
        SUB_DIR="$DIR_SANDBOX_SUENO"
        if [[ -n "$ARG_REL" ]]; then
            if [[ "$ARG_REL" != *".."* ]]; then
                SUB_DIR="$DIR_SANDBOX_SUENO/$ARG_REL"
                mkdir -p "$SUB_DIR" 2>/dev/null
            fi
        fi
        while IFS= read -r l_arch; do
            if [[ -n "$l_arch" ]]; then
                if [[ "$l_arch" != *"/"* ]]; then
                    if [[ "$l_arch" != *".."* ]]; then
                        if [[ ! -d "$SUB_DIR/$l_arch" ]]; then
                            : > "$SUB_DIR/$l_arch" 2>/dev/null
                        fi
                    fi
                fi
            fi
        done < <(printf '%s\n' "$OUT_REC")
    elif [[ "$MOD_REC" == "buscar_texto" ]]; then
        ARG2_REC="${REST_REC#"$ARG_REC"}"
        ARG2_REC="${ARG2_REC# }"
        ARG2_REL="${ARG2_REC#/}"
        if [[ -n "$ARG2_REL" ]]; then
            if [[ "$ARG2_REL" != *".."* ]]; then
                mkdir -p "$DIR_SANDBOX_SUENO/$(dirname "$ARG2_REL")" 2>/dev/null
                if [[ "$OUT_REC" != Error:* ]]; then
                    printf '%s\n' "$OUT_REC" > "$DIR_SANDBOX_SUENO/$ARG2_REL" 2>/dev/null
                fi
            fi
        fi
    else
        for m_rec_ok in identificar escribir anadir editar; do
            if [[ "$MOD_REC" == "$m_rec_ok" ]]; then
                if [[ -n "$ARG_REL" ]]; then
                    if [[ "$ARG_REL" != *".."* ]]; then
                        if [[ "$OUT_REC" != Error:* ]]; then
                            mkdir -p "$DIR_SANDBOX_SUENO/$(dirname "$ARG_REL")" 2>/dev/null
                            if [[ ! -e "$DIR_SANDBOX_SUENO/$ARG_REL" ]]; then
                                : > "$DIR_SANDBOX_SUENO/$ARG_REL" 2>/dev/null
                            fi
                        fi
                    fi
                fi
                break
            fi
        done
    fi
}

ejecutar_en_sandbox_sueno() {
    CMD_SB="$1"
    MOD_REC="$2"
    OUT_REC="$3"

    CMD_SB="${CMD_SB#\# Modulo: }"
    CMD_SB="${CMD_SB#\# modulo: }"
    CMD_SB="${CMD_SB#Modulo: }"
    CMD_SB="${CMD_SB#bash:}"
    CMD_SB="${CMD_SB#bash }"
    CMD_SB="${CMD_SB%% - *}"
    MOD_SB="${CMD_SB%% *}"

    if grep -qE '(\.\.|(^|[[:space:]])/|[A-Za-z]:\\|~|\brm\b|\bmkfs\b|\bdd\b|\bchmod\b|\bshutdown\b|\breboot\b|\bpoweroff\b|\bsubir_github\b|&|;|\|)' < <(printf '%s' "$CMD_SB"); then
        echo "Error: fuera de los limites del sandbox SUENO ($CMD_SB)"
    elif [[ "$MOD_SB" == "ruta" ]]; then
        if [[ -n "$OUT_REC" ]]; then
            if [[ "$MOD_REC" == "ruta" ]]; then
                printf '%s\n' "$OUT_REC"
            else
                echo "La ruta es: /SUENO"
            fi
        else
            echo "La ruta es: /SUENO"
        fi
    else
        ES_MEM_SB=0
        for m_mem_sb in hora fecha maquina buscar_internet; do
            if [[ "$MOD_SB" == "$m_mem_sb" ]]; then ES_MEM_SB=1; fi
        done
        if [[ "$MOD_SB" == meteo_* ]]; then ES_MEM_SB=1; fi

        if [[ $ES_MEM_SB -eq 1 ]]; then
            if [[ "$MOD_SB" == "$MOD_REC" ]]; then
                if [[ -n "$OUT_REC" ]]; then
                    printf '%s\n' "$OUT_REC"
                else
                    echo "(sin datos de $MOD_SB en este recuerdo)"
                fi
            else
                echo "(sin datos de $MOD_SB en este recuerdo)"
            fi
        else
            head -c 4000 < <(timeout "$TIMEOUT_HERRAMIENTA" bash -c 'if cd "$1"; then for f in "$2"/*; do if [[ -f "$f" ]]; then source "$f"; fi; done; eval "$3"; fi' _ "$DIR_SANDBOX_SUENO" "$DIR_MODULOS" "$CMD_SB" 2>/dev/null)
        fi
    fi
}

# FASE 3: SUENO REM (Sandbox fisico SUEÑO/ + doble rol usuario/agente + paralisis del SO real)
fase_rem() {
    NOM_T="$1"
    DIR_T="$DIR_SUENO/$NOM_T"
    EST_F="$DIR_T/estado.json"
    CLASE_T=$(jq -r '.clase // "declarativo"' "$EST_F" 2>/dev/null)
    REM_PAUSADO=0

    comprobar_despertar
    if [[ $DESPERTO -eq 1 ]]; then
        REM_PAUSADO=1
    else
        registrar_sueno "[REM] Iniciando fase REM (sandbox SUEÑO/ con doble rol, clase=$CLASE_T) para $NOM_T..."
        crear_sandbox_sueno

        REM_ACTIVO=1
        true < <(setsid "$DIR/DESPERTAR/MEMORIA" </dev/null >/dev/null 2>/dev/null)

        cd "$DIR"
        REL_CAND="MEMORIA/SUENO/${NOM_T}/candidato.gguf"
        ESC_REM="${LORA_ESCALA:-0.70}"
        LORAS_REM="${REL_CAND}:${ESC_REM}"
        if [[ -n "$LORA_BASE" ]]; then
            if [[ "$NOM_T" != "$LORA_BASE" ]]; then
                if [[ -s "LORA/${LORA_BASE}.gguf" ]]; then
                    read -r ESC_REM_BASE ESC_REM_CAND < <(awk -v e="$ESC_REM" 'BEGIN { printf "%.4f %.4f\n", e * 0.7, e * 0.8 }')
                    LORAS_REM="LORA/${LORA_BASE}.gguf:${ESC_REM_BASE},${REL_CAND}:${ESC_REM_CAND}"
                fi
            fi
        fi
        true < <(setsid llama-server \
            -m "$MODELO" \
            --lora-scaled "$LORAS_REM" \
            --host "$HOST" \
            --port "$PUERTO" \
            -c 4096 -n 256 -np 1 \
            --jinja -ngl 99 \
            --reasoning off \
            -fa on -ctk q8_0 -ctv q8_0 -cram 0 -lm none --no-host \
            </dev/null >/dev/null 2>/dev/null)

        SERV_OK=0
        INT_R=0
        while [[ $INT_R -lt 120 ]]; do
            comprobar_despertar
            if [[ $DESPERTO -eq 1 ]]; then
                REM_PAUSADO=1
                break
            fi
            if curl -sf "http://${HOST}:${PUERTO}/health" >/dev/null 2>/dev/null; then
                if curl -sf "http://${HOST}:${PUERTO_MEMORIA}/health" >/dev/null 2>/dev/null; then
                    SERV_OK=1
                    break
                fi
            fi
            sleep 0.5
            INT_R=$((INT_R + 1))
        done

        if [[ $REM_PAUSADO -eq 1 ]]; then
            apagar_servidores
            REM_ACTIVO=0
            rm -rf "$DIR_SANDBOX_SUENO" 2>/dev/null
            registrar_sueno "[REM] Pausado por despertar del usuario antes del examen ($NOM_T)."
        elif [[ $SERV_OK -eq 0 ]]; then
            apagar_servidores
            REM_ACTIVO=0
            rm -rf "$DIR_SANDBOX_SUENO" 2>/dev/null
            registrar_sueno "[REM] Error: no respondieron los servidores en fase REM ($NOM_T)."
        else
