                                fi
                            fi
                            if [[ -n "$PART_ORIG" ]]; then
                                vaciar_aprobados_capa "$PART_ORIG" "$DIR_T/best_aprobados.txt" "$IND_ORIG"
                            fi
                            quitar_de_rectificar "$NOM_T"
                            rm -f "$DIR_MEM_LORA/huella" 2>/dev/null
                            registrar_sueno "[REM] Tope de ciclos ($MAX_CICLOS_REM) en $NOM_T -> Promovido mejor LoRA (errores=$MEJ_ERR, sim=$MEJ_SIM) y vaciados aprobados."
                            rm -rf "$DIR_T"
                        elif [[ "${ES_RECT_T:-0}" -eq 1 ]]; then
                            purgar_lora_obsoleto "$NOM_T"
                            registrar_sueno "[REM] Tope de ciclos ($MAX_CICLOS_REM) en rectificacion de $NOM_T sin aprobados -> LoRA obsoleto purgado."
                        else
                            registrar_sueno "[REM] Tope de ciclos ($MAX_CICLOS_REM) en $NOM_T sin aprobados -> Conservado estado previo sin sobrescribir."
                            rm -rf "$DIR_T"
                        fi
                    elif [[ "$MEJORO" -eq 1 ]]; then
                        EP_EXTRA=$(jq -r -n --argjson e "$NUM_ERRORES" --argjson tot "$TOTAL_EXAM" --argjson pobj "${PASOS_OBJ_SUENO:-16}" --argjson pep "$PASOS_EP" '
                            ((($pobj * 0.5) * ($e / $tot) / $pep) | floor) as $calc |
                            if $calc < 1 then 1 else $calc end
                        ')
                        EP_NUEVA=$((EP_ACT + EP_EXTRA))
                        EST_NUEVO=$(jq -a -c --argjson c "$CICLO_SIG" --argjson ep "$EP_NUEVA" --argjson me "$MEJ_ERR" --argjson ms "$MEJ_SIM" --argjson mep "$MEJ_EP" '
                            . + {fase: "profundo", ciclo: $c, epocas_obj: $ep, mejor_epocas: $mep, mejor_errores: $me, mejor_sim: $ms, reset_lr: 0}
                        ' "$EST_F" 2>/dev/null)
                        printf '%s\n' "$EST_NUEVO" > "${EST_F}.tmp"
                        mv -f "${EST_F}.tmp" "$EST_F" 2>/dev/null
                        registrar_sueno "[REM] Progreso en $NOM_T -> +$EP_EXTRA epoca(s) conservadora(s) (epocas_obj=$EP_NUEVA) para siguiente ciclo Profundo."
                    else
                        if [[ -s "$DIR_T/best.ckpt" ]]; then
                            cp -f "$DIR_T/best.ckpt" "$DIR_T/modelo.ckpt" 2>/dev/null
                        fi
                        if [[ -s "$DIR_T/best.gguf" ]]; then
                            cp -f "$DIR_T/best.gguf" "$DIR_T/candidato.gguf" 2>/dev/null
                        fi
                        EP_FINO=$(jq -r -n --argjson pobj "${PASOS_OBJ_SUENO:-16}" --argjson pep "$PASOS_EP" '
                            ((($pobj * 0.25) / $pep) | floor) as $calc |
                            if $calc < 1 then 1 else $calc end
                        ')
                        EP_ROLL=$((MEJ_EP + EP_FINO))
                        LR_FINO=$(jq -r -n --argjson lr "$LR_ACT" '($lr * 0.5)')
                        EST_NUEVO=$(jq -a -c --argjson c "$CICLO_SIG" --argjson ep "$EP_ROLL" --argjson lr "$LR_FINO" '
                            . + {fase: "profundo", ciclo: $c, epocas_obj: $ep, lr: $lr, reset_lr: 1}
                        ' "$EST_F" 2>/dev/null)
                        printf '%s\n' "$EST_NUEVO" > "${EST_F}.tmp"
                        mv -f "${EST_F}.tmp" "$EST_F" 2>/dev/null
                        registrar_sueno "[REM] Sobreajuste detectado en $NOM_T -> Rollback a epoca $MEJ_EP y LR ajustado a $LR_FINO (epocas_obj=$EP_ROLL)."
                    fi
                fi

                printf '%s\n' "$NOM_T" > "$DIR_SUENO/ultimo_turno"
            fi
        fi
    fi
}

# Bucle principal de ciclos de sueno (Ligero prepara -> Profundo entrena -> REM testea, en round-robin)
registrar_sueno "=== INICIO DE SUENO (PID=$$, modelo=$NOMBRE_IA) ==="

while true; do
    if [[ ! -e "$PARADA_OLVIDO" ]]; then
        OLV_VIVO=0
        if [[ -s "$PID_OLVIDO" ]]; then
            OPID_D=$(cat "$PID_OLVIDO" 2>/dev/null)
            if [[ -n "$OPID_D" ]]; then
                if kill -0 "$OPID_D" 2>/dev/null; then
                    OLV_VIVO=1
                fi
            fi
        fi
        if [[ $OLV_VIVO -eq 0 ]]; then
            if [[ -x "$DIR/DESPERTAR/OLVIDO" ]]; then
                true < <(setsid "$DIR/DESPERTAR/OLVIDO" --daemon </dev/null >/dev/null 2>/dev/null)
            fi
        fi
    fi

    comprobar_despertar
    if [[ $DESPERTO -eq 1 ]]; then
        registrar_sueno "=== DESPERTAR DETECTADO: fin limpio de DORMIR ==="
        break
    fi

    fase_ligero
    if [[ -z "$TAREA_ELEGIDA" ]]; then
        registrar_sueno "=== SUENO COMPLETADO: sin tareas pendientes ==="
        break
    fi

    FASE_ACTUAL=$(jq -r '.fase // "profundo"' "$DIR_SUENO/$TAREA_ELEGIDA/estado.json" 2>/dev/null)

    if [[ "$FASE_ACTUAL" == "profundo" ]]; then
        PROFUNDO_RC=0
        fase_profundo "$TAREA_ELEGIDA"
        if [[ $PROFUNDO_RC -eq 42 ]]; then
            break
        elif [[ $PROFUNDO_RC -ne 0 ]]; then
            break
        fi
        FASE_ACTUAL="rem"
    fi

    if [[ "$FASE_ACTUAL" == "rem" ]]; then
        fase_rem "$TAREA_ELEGIDA"
        if [[ $REM_PAUSADO -eq 1 ]]; then
            break
        fi
    fi

    if [[ $UN_CICLO -eq 1 ]]; then
        registrar_sueno "=== FIN DE CICLO UNICO (--un-ciclo) ==="
        break
    fi
done
