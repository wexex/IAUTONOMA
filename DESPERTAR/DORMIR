                    quitar_de_rectificar "$NOM_T"
                    rm -rf "$DIR_T"
                    rm -f "$DIR_MEM_LORA/huella" 2>/dev/null
                    registrar_reloj_sueno "Consolide en sueno el adaptador $NOM_T ($LIN_FINAL recuerdos)."
                    registrar_sueno "[REM] EXITO 0 ERROR en $NOM_T ($LIN_FINAL ejemplos) -> Consolidado en $OUT_GGUF."
                else
                    MEJORO=$(jq -r -n --argjson e "$NUM_ERRORES" --argjson me "$MEJ_ERR" --argjson s "$SIM_MEDIA" --argjson ms "$MEJ_SIM" '
                        if ($e < $me) or ($e == $me and $s >= $ms) then 1 else 0 end
