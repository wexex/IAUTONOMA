                                        RESP_LECT=$(curl -sf "$URL" -H "Content-Type: application/json" -d "$PAY_LECT" 2>/dev/null)
                                        TC_LOOP=$(jq -r '(.choices[0].message.tool_calls // [ ]) | length' < <(printf '%s' "$RESP_LECT") 2>/dev/null)
                                        if [[ "${TC_LOOP:-0}" -eq 0 ]]; then
                                            TXT_REM=$(jq -r '(.choices[0].message.content // "") | gsub("[\r\n]+"; " ")' < <(printf '%s' "$RESP_LECT") 2>/dev/null)
