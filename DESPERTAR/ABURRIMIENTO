#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/CONFIG"

echo "$$" > "$PID_ABURRIMIENTO"
SEG_DESPIERTO=$(( ${TIEMPO_DESPIERTO} ))
SEG_MITAD=$(( SEG_DESPIERTO / 2 ))
ULTIMA_VISTA=""
FASE=0

dormir_puerto() {
    P_OBJ="$1"
    if command -v taskkill >/dev/null 2>/dev/null; then
        while IFS= read -r win_pid; do
            if [[ -n "$win_pid" ]]; then
                if [[ "$win_pid" != "0" ]]; then
                    taskkill //F //T //PID "$win_pid" >/dev/null 2>/dev/null
                fi
            fi
        done < <(awk -v p=":$P_OBJ" '$4 == "LISTENING" { if (substr($2, length($2) - length(p) + 1) == p) print $5 }' < <(netstat -ano 2>/dev/null))
    elif command -v fuser >/dev/null 2>/dev/null; then
        fuser -k "${P_OBJ}/tcp" >/dev/null 2>/dev/null
    fi
}

while true; do
    if [[ ! -e "$PARADA_OLVIDO" ]]; then
        OLV_VIVO=0
        if [[ -s "$PID_OLVIDO" ]]; then
            OPID_A=$(cat "$PID_OLVIDO" 2>/dev/null)
            if [[ -n "$OPID_A" ]]; then
                if kill -0 "$OPID_A" 2>/dev/null; then
                    OLV_VIVO=1
                fi
            fi
        fi
        if [[ $OLV_VIVO -eq 0 ]]; then
            if [[ -x "$DIR/DESPERTAR/OLVIDO" ]]; then
                true < <(setsid "$DIR/DESPERTAR/OLVIDO" --daemon </dev/null >/dev/null 2>/dev/null)
            fi
        fi
    fi

    ULTIMA=0
    if [[ -s "$ULTIMA_INTERACCION" ]]; then
        ULTIMA=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
    fi
    if [[ -z "$ULTIMA" ]]; then ULTIMA=0; fi

    if [[ "$ULTIMA" != "$ULTIMA_VISTA" ]]; then
        ULTIMA_VISTA="$ULTIMA"
        FASE=0
    fi

    AHORA=$(date +%s)
    TRANSCURRIDO=$((AHORA - ULTIMA))

    if [[ $FASE -eq 0 ]]; then
        if [[ $TRANSCURRIDO -ge $SEG_MITAD ]]; then
            if [[ $TRANSCURRIDO -lt $SEG_DESPIERTO ]]; then
                "$DIR/ENTRADA" --interno "$ESTIMULO_SILENCIO" >/dev/null 2>/dev/null
                FASE=1
            fi
        fi
    fi

    if [[ $TRANSCURRIDO -ge $SEG_DESPIERTO ]]; then
        "$DIR/ENTRADA" --interno "$ESTIMULO_DORMIR" >/dev/null 2>/dev/null
        ULTIMA_POST=0
        if [[ -s "$ULTIMA_INTERACCION" ]]; then
            ULTIMA_POST=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
        fi
        if [[ "$ULTIMA_POST" == "$ULTIMA_VISTA" ]]; then
            dormir_puerto "$PUERTO"
            dormir_puerto "$PUERTO_MEMORIA"
            rm -f "$PID_ABURRIMIENTO" "$SENAL_DESPERTAR" 2>/dev/null
            if [[ -x "$DIR/DESPERTAR/DORMIR" ]]; then
                true < <(setsid "$DIR/DESPERTAR/DORMIR" </dev/null >/dev/null 2>/dev/null)
            fi
            exit 0
        fi
    fi

    sleep 5
done
