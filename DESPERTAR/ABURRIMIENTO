#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/CONFIG"

mkdir -p "$DIR_REGISTROS_ESTADO" "$DIR_REGISTROS_LOGS"
echo "$$" > "$PID_ABURRIMIENTO"
SEG_DESPIERTO=$(( ${TIEMPO_DESPIERTO} ))
SEG_MITAD=$(( SEG_DESPIERTO / 2 ))
ULTIMA_VISTA=""
FASE=0

REFLEJO_OK=1
reflejo_hipnico() {
    REFLEJO_OK=1
    # 1. Comprobar estabilidad de escritura: esperar si ENTRADA --consolidar sigue activo
    esperar_lock 30 0.5
    if [[ -s "$LOCK_MEMORIA" ]]; then
        LPID_H=$(cat "$LOCK_MEMORIA" 2>/dev/null)
        if [[ -n "$LPID_H" ]]; then
            if kill -0 "$LPID_H" 2>/dev/null; then
                printf '[%s] [REFLEJO HIPNICO] Abortado paso a sueno: consolidacion activa (PID %s)\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$LPID_H" >> "$LOG_SUENO"
                REFLEJO_OK=0
            fi
        fi
    fi

    # 2. Verificar integridad JSONL de la memoria antes de entrar en sueno profundo
    if [[ $REFLEJO_OK -eq 1 ]]; then
        for f_chk in "$HIPOCAMPO" "$RELOJ" "$INDICE_PROCEDIMENTAL"; do
            if [[ -s "$f_chk" ]]; then
                if ! jq -e -s '.' "$f_chk" >/dev/null 2>/dev/null; then
                    sleep 2
                    if ! jq -e -s '.' "$f_chk" >/dev/null 2>/dev/null; then
                        printf '[%s] [REFLEJO HIPNICO] Abortado paso a sueno: JSON invalido en %s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$(basename "$f_chk")" >> "$LOG_SUENO"
                        REFLEJO_OK=0
                        break
                    fi
                fi
            fi
        done
    fi

    # 3. Doble check final de actividad del usuario
    if [[ $REFLEJO_OK -eq 1 ]]; then
        ULTIMA_FIN=0
        if [[ -s "$ULTIMA_INTERACCION" ]]; then
            ULTIMA_FIN=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
        fi
        if [[ "$ULTIMA_FIN" != "$ULTIMA_VISTA" ]]; then
            REFLEJO_OK=0
        fi
    fi
}

while true; do
    asegurar_olvido

    ULTIMA=0
    if [[ -s "$ULTIMA_INTERACCION" ]]; then
        ULTIMA=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
    fi
    if [[ -z "$ULTIMA" ]]; then ULTIMA=0; fi

    if [[ "$ULTIMA" != "$ULTIMA_VISTA" ]]; then
        ULTIMA_VISTA="$ULTIMA"
        FASE=0
    fi

    AHORA=$(date +%s)
    TRANSCURRIDO=$((AHORA - ULTIMA))

    if [[ $FASE -eq 0 ]]; then
        if [[ $TRANSCURRIDO -ge $SEG_MITAD ]]; then
            if [[ $TRANSCURRIDO -lt $SEG_DESPIERTO ]]; then
                "$DIR/ENTRADA" --interno "$ESTIMULO_SILENCIO" >/dev/null 2>/dev/null
                FASE=1
            fi
        fi
    fi

    if [[ $TRANSCURRIDO -ge $SEG_DESPIERTO ]]; then
        "$DIR/ENTRADA" --interno "$ESTIMULO_DORMIR" >/dev/null 2>/dev/null
        ULTIMA_POST=0
        if [[ -s "$ULTIMA_INTERACCION" ]]; then
            ULTIMA_POST=$(cat "$ULTIMA_INTERACCION" 2>/dev/null)
        fi
        if [[ "$ULTIMA_POST" == "$ULTIMA_VISTA" ]]; then
            reflejo_hipnico
            if [[ $REFLEJO_OK -eq 1 ]]; then
                dormir_puerto "$PUERTO"
                dormir_puerto "$PUERTO_MEMORIA"
                dormir_puerto "$PUERTO_AMIGDALA"
                rm -f "$PID_ABURRIMIENTO" "$SENAL_DESPERTAR" 2>/dev/null
                if [[ -x "$DIR/DESPERTAR/DORMIR" ]]; then
                    true < <(setsid "$DIR/DESPERTAR/DORMIR" </dev/null >/dev/null 2>/dev/null)
                fi
                exit 0
            fi
        fi
    fi

    sleep 5
done
