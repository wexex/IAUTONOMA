#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/CONFIG"

mkdir -p "$DIR_REGISTROS_LOGS"
rotar_log "$LOG_SERVER"

cd "$DIR"

ARGS_LORA=( )
if [[ -d "$DIR_LORA_PESOS" ]]; then
    LISTA_LORAS=""
    for fl in "LORA"/*.gguf; do
        if [[ -s "$fl" ]]; then
            NOM_L="$(basename "$fl" .gguf)"
            ESC_L="0.0"
            if [[ "$NOM_L" == "$LORA_BASE" ]]; then
                ESC_L="${LORA_ESCALA:-1.0}"
            fi
            if [[ -n "$LISTA_LORAS" ]]; then
                LISTA_LORAS+=","
            fi
            LISTA_LORAS+="${fl}:${ESC_L}"
        fi
    done
    if [[ -n "$LISTA_LORAS" ]]; then
        ARGS_LORA=(--lora-scaled "$LISTA_LORAS")
    fi
fi

NGL_LEN="$1"
HILOS_LEN="$2"
if [[ -z "$NGL_LEN" ]]; then
    if [[ -x "$DIR/DESPERTAR/EQUILIBRIO" ]]; then
        IFS=$'\t' read -r NGL_LEN HILOS_LEN _MODO_L _VL_L _PM_L _CP_L < <("$DIR/DESPERTAR/EQUILIBRIO" "$MODELO" "4096" "LENGUAJE" 2>/dev/null)
    fi
fi
if [[ -z "$NGL_LEN" ]]; then NGL_LEN="99"; fi
if [[ -z "$HILOS_LEN" ]]; then HILOS_LEN="2"; fi

llama-server \
-m "$MODELO" \
"${ARGS_LORA[@]}" \
--host "$HOST" \
--port "$PUERTO" \
-c 4096 -n \
2048 -np 1 \
--jinja -ngl "$NGL_LEN" \
-t "$HILOS_LEN" \
--reasoning off \
-fa on \
-ctk q8_0 \
-ctv q8_0 \
-lm none \
--no-host \
--log-colors on 2> >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_SERVER")) > >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_SERVER"))


