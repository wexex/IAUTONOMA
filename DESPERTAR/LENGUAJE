#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd)/CONFIG"

if [[ -f "$LOG_SERVER" ]]; then
    if [[ $(wc -l < "$LOG_SERVER") -ge 1000 ]]; then
        tail -n 500 "$LOG_SERVER" > "${LOG_SERVER}.tmp"
        mv "${LOG_SERVER}.tmp" "$LOG_SERVER"
    fi
fi

cd "$DIR"

ARGS_LORA=( )
if [[ -d "$DIR_LORA_PESOS" ]]; then
    LISTA_LORAS=""
    for fl in "LORA"/*.gguf; do
        if [[ -s "$fl" ]]; then
            NOM_L="$(basename "$fl" .gguf)"
            ESC_L="0.0"
            if [[ "$NOM_L" == "$LORA_BASE" ]]; then
                ESC_L="${LORA_ESCALA:-1.0}"
            fi
            if [[ -n "$LISTA_LORAS" ]]; then
                LISTA_LORAS+=","
            fi
            LISTA_LORAS+="${fl}:${ESC_L}"
        fi
    done
    if [[ -n "$LISTA_LORAS" ]]; then
        ARGS_LORA=(--lora-scaled "$LISTA_LORAS")
    fi
fi

llama-server \
-m "$MODELO" \
"${ARGS_LORA[@]}" \
--host "$HOST" \
--port "$PUERTO" \
-c 4096 -n \
2048 -np 1 \
--jinja -ngl 99 \
--reasoning off \
-fa on \
-ctk q8_0 \
-ctv q8_0 \
-cram 0 \
-lm none \
--no-host \
--log-colors on 2> >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_SERVER")) > >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_SERVER"))


