#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)/../CONFIG"

mkdir -p "$DIR_REGISTROS" "$DIR_REGISTROS_OLVIDO" "$DIR_REGISTROS_ESTADO"

# Control de instancia unica
if [[ -s "$PID_OLVIDO" ]]; then
    PID_PREV=$(cat "$PID_OLVIDO" 2>/dev/null)
    if [[ -n "$PID_PREV" ]]; then
        if [[ "$PID_PREV" != "$$" ]]; then
            if kill -0 "$PID_PREV" 2>/dev/null; then
                exit 0
            fi
        fi
    fi
fi

echo "$$" > "$PID_OLVIDO"

limpiar_olvido() {
    if [[ -s "$LOCK_MEMORIA" ]]; then
        LPID_OUT=$(cat "$LOCK_MEMORIA" 2>/dev/null)
        if [[ "$LPID_OUT" == "$$" ]]; then
            rm -f "$LOCK_MEMORIA" 2>/dev/null
        fi
    fi
    if [[ -s "$PID_OLVIDO" ]]; then
        PID_ACT=$(cat "$PID_OLVIDO" 2>/dev/null)
        if [[ "$PID_ACT" == "$$" ]]; then
            rm -f "$PID_OLVIDO" 2>/dev/null
        fi
    fi
}
trap limpiar_olvido EXIT

SEG_PER=$(( (${DECAIMIENTO_PERSISTENTE}) * 3600 ))
SEG_MEM=$(( (${DECAIMIENTO_MEMORIA}) * 3600 ))
SEG_HIP=$(( (${DECAIMIENTO_HIPOCAMPO}) * 3600 ))
CICLO_OLV="${INTERVALO_OLVIDO:-15}"

LOG_OLV_HIP="$DIR_REGISTROS_OLVIDO/hipocampo.log"
LOG_OLV_EPI="$DIR_REGISTROS_OLVIDO/episodica.log"
LOG_OLV_PER="$DIR_REGISTROS_OLVIDO/persistente.log"
LOG_OLV_PUR="$DIR_REGISTROS_OLVIDO/olvidado.log"

T_ULTIMO=$(date +%s)
if [[ -s "$TS_OLVIDO" ]]; then
    TS_PREV=$(cat "$TS_OLVIDO" 2>/dev/null)
    if [[ -n "$TS_PREV" ]]; then
        T_ULTIMO="$TS_PREV"
    fi
fi

while true; do
    FECHA_NOW=$(date "+%Y-%m-%d %H:%M:%S")
    T_AHORA=$(date +%s)
    DT_SEG=$((T_AHORA - T_ULTIMO))
    if [[ $DT_SEG -lt 1 ]]; then DT_SEG=1; fi

    CONSOLIDANDO_ACTIVO=0
    if [[ -s "$LOCK_MEMORIA" ]]; then
        LPID_OLV=$(cat "$LOCK_MEMORIA" 2>/dev/null)
        if [[ -n "$LPID_OLV" ]]; then
            if kill -0 "$LPID_OLV" 2>/dev/null; then
                CONSOLIDANDO_ACTIVO=1
            fi
        fi
    fi

    if [[ $CONSOLIDANDO_ACTIVO -eq 0 ]]; then
        T_ULTIMO="$T_AHORA"
        printf '%s\n' "$T_ULTIMO" > "$TS_OLVIDO"
        read -r FACTOR_DEC_PER FACTOR_DEC_MEM FACTOR_DEC_HIP < <(jq -r -n \
            --argjson sp "$SEG_PER" \
            --argjson sm "$SEG_MEM" \
            --argjson sh "$SEG_HIP" \
            --argjson u "$UMBRAL_SIM" \
            --argjson p "$PESO_INICIAL" \
            --argjson dt "$DT_SEG" '
            [
                ((((($u / 1.0) | log) * $dt) / $sp) | exp),
                ((((($u / $p) | log) * $dt) / $sm) | exp),
                ((((($u / $p) | log) * $dt) / $sh) | exp)
            ] | map(tostring) | join(" ")
        ')

        ARCHIVOS_DEC=( )
        if [[ -s "$HIPOCAMPO" ]]; then ARCHIVOS_DEC+=("$HIPOCAMPO"); fi
        for f in "$DIR_MEMORIA/${PREFIJO_EPISODICA}_"*.json "$DIR_MEMORIA/${PREFIJO_PERSISTENTE}_"*.json; do
            if [[ -s "$f" ]]; then ARCHIVOS_DEC+=("$f"); fi
        done

        printf '=== HIPOCAMPO | %s | Decaimiento: %sh | Umbral: %s ===\n' "$FECHA_NOW" "$DECAIMIENTO_HIPOCAMPO" "$UMBRAL_SIM" > "${LOG_OLV_HIP}.$$.tmp"
        printf '=== EPISODICA | %s | Decaimiento: %sh | Umbral: %s ===\n' "$FECHA_NOW" "$DECAIMIENTO_MEMORIA" "$UMBRAL_SIM" > "${LOG_OLV_EPI}.$$.tmp"
        printf '=== PERSISTENTE | %s | Decaimiento: %sh | Umbral: %s ===\n' "$FECHA_NOW" "$DECAIMIENTO_PERSISTENTE" "$UMBRAL_SIM" > "${LOG_OLV_PER}.$$.tmp"

        if [[ ${#ARCHIVOS_DEC[@]} -gt 0 ]]; then
            for f in "${ARCHIVOS_DEC[@]}"; do
                > "${f}.$$.tmp"
            done

            OLVIDOS_CICLO=$(awk -F'\t' -v pid="$$" -v umb="$UMBRAL_SIM" \
                -v lh="${LOG_OLV_HIP}.$$.tmp" -v le="${LOG_OLV_EPI}.$$.tmp" -v lp="${LOG_OLV_PER}.$$.tmp" '
                $1 == "V" {
                    tmp = $2 "." pid ".tmp"
                    print $3 > tmp
                    usados[tmp] = 1
                }
                $1 == "S" {
                    norma = $3 + 0
                    pct = ((norma - umb) / (1.0 - umb)) * 100.0
                    if (pct < 0) pct = 0
                    if (pct > 100) pct = 100
                    linea = sprintf("%.6f (%5.1f%%) | %s", norma, pct, $4)
                    if ($2 == "H") print linea >> lh
                    else if ($2 == "P") print linea >> lp
                    else print linea >> le
                }
                $1 == "O" {
                    print $2 "\t" $3
                }
                END {
                    for (t in usados) close(t)
                    close(lh)
                    close(le)
                    close(lp)
                }
            ' < <(jq -r \
                --argjson dp "$FACTOR_DEC_PER" \
                --argjson dm "$FACTOR_DEC_MEM" \
                --argjson dh "$FACTOR_DEC_HIP" \
                --argjson umb "$UMBRAL_SIM" \
                --arg h "$(basename "$HIPOCAMPO")" \
                --arg pp "${PREFIJO_PERSISTENTE}_" '
                def norm($a): ((reduce $a[:1024][ ] as $x (0; . + ($x * $x))) | sqrt);
                (input_filename) as $fn |
                (if ($fn | endswith($h)) then "H" elif ($fn | contains($pp)) then "P" else "E" end) as $capa |
                (if $capa == "H" then $dh elif $capa == "P" then $dp else $dm end) as $d_base |
                (.valencia // 0) as $val |
                (if $val > 0 then (if $d_base > 0 then ((($d_base | log) * 0.6) | exp) else $d_base end) elif $val < 0 then ($d_base * $d_base) else $d_base end) as $d |
                .embedding = (if .embedding then (.embedding[:1024] | map(. * $d)) else null end) |
                (if .embedding != null then norm(.embedding) else 0 end) as $nv |
                ((.messages[0].content // "") | gsub("[\r\n\t]+"; " ")) as $u |
                if (.embedding != null and $nv >= $umb) then
                    "V\t" + $fn + "\t" + (. | tojson) + "\nS\t" + $capa + "\t" + ($nv | tostring) + "\t" + $u
                else
                    "O\t" + $fn + "\t" + $u
                end
            ' "${ARCHIVOS_DEC[@]}" 2>/dev/null))

            RUTAS_CON_OLVIDO=""
            if [[ -n "$OLVIDOS_CICLO" ]]; then
                while IFS=$'\t' read -r ruta_o linea_o; do
                    if [[ -n "$linea_o" ]]; then
                        RUTAS_CON_OLVIDO+="${ruta_o}"$'\n'
                        TAG_O="EPISODICA"
                        if [[ "$ruta_o" == "$HIPOCAMPO" ]]; then
                            TAG_O="HIPOCAMPO"
                        elif [[ "$(basename "$ruta_o")" == "${PREFIJO_PERSISTENTE}_"* ]]; then
                            TAG_O="PERSISTENTE"
                        fi
                        printf '[%s] [%s] %s\n' "$FECHA_NOW" "$TAG_O" "$linea_o" >> "$LOG_OLV_PUR"
                    fi
                done < <(printf '%s\n' "$OLVIDOS_CICLO")
                rotar_log "$LOG_OLV_PUR"
            fi

            BLOQ_REP=0
            if [[ -s "$LOCK_MEMORIA" ]]; then
                LPID_R=$(cat "$LOCK_MEMORIA" 2>/dev/null)
                if [[ -n "$LPID_R" ]]; then
                    if kill -0 "$LPID_R" 2>/dev/null; then
                        BLOQ_REP=1
                    else
                        rm -f "$LOCK_MEMORIA" 2>/dev/null
                    fi
                fi
            fi

            if [[ $BLOQ_REP -eq 1 ]]; then
                for f in "${ARCHIVOS_DEC[@]}"; do
                    rm -f "${f}.$$.tmp" 2>/dev/null
                done
            else
                echo "$$" > "$LOCK_MEMORIA"
                for f in "${ARCHIVOS_DEC[@]}"; do
                    if [[ -f "${f}.$$.tmp" ]]; then
                        if [[ -f "$f" ]]; then
                            if [[ ! "$f" -nt "${f}.$$.tmp" ]]; then
                                mv -f "${f}.$$.tmp" "$f" 2>/dev/null
                            else
                                rm -f "${f}.$$.tmp" 2>/dev/null
                            fi
                        else
                            rm -f "${f}.$$.tmp" 2>/dev/null
                        fi
                    fi
                    if [[ "$f" != "$HIPOCAMPO" ]]; then
                        NOMBRE_PART=$(basename "$f")
                        CAPA_IND="$INDICE_EPISODICA"
                        if [[ "$NOMBRE_PART" == "${PREFIJO_PERSISTENTE}_"* ]]; then
                            CAPA_IND="$INDICE_PERSISTENTE"
                        fi
                        if [[ ! -s "$f" ]]; then
                            rm -f "$f"
                            printf '[%s] [CAJON VACIO] Eliminado %s\n' "$FECHA_NOW" "$NOMBRE_PART" >> "$LOG_OLV_PUR"
                            if [[ -s "$CAPA_IND" ]]; then
                                jq -a -c --arg arch "$NOMBRE_PART" 'select(.archivo != $arch)' "$CAPA_IND" > "${CAPA_IND}.$$.tmp" 2>/dev/null
                                if [[ -f "${CAPA_IND}.$$.tmp" ]]; then
                                    mv -f "${CAPA_IND}.$$.tmp" "$CAPA_IND" 2>/dev/null
                                fi
                            fi
                        elif [[ "$RUTAS_CON_OLVIDO" == *"$f"$'\n'* ]]; then
                            if [[ -s "$CAPA_IND" ]]; then
                                LINEAS_ACT=$(( $(wc -l < "$f") ))
                                jq -a -c --arg arch "$NOMBRE_PART" --argjson lin "$LINEAS_ACT" '
                                    if .archivo == $arch then . + {lineas: $lin} else . end
                                ' "$CAPA_IND" > "${CAPA_IND}.$$.tmp" 2>/dev/null
                                if [[ -s "${CAPA_IND}.$$.tmp" ]]; then
                                    mv -f "${CAPA_IND}.$$.tmp" "$CAPA_IND" 2>/dev/null
                                else
                                    rm -f "${CAPA_IND}.$$.tmp" 2>/dev/null
                                fi
                            fi
                        fi
                    fi
                done
                if [[ -s "$LOCK_MEMORIA" ]]; then
                    LPID_FIN=$(cat "$LOCK_MEMORIA" 2>/dev/null)
                    if [[ "$LPID_FIN" == "$$" ]]; then
                        rm -f "$LOCK_MEMORIA" 2>/dev/null
                    fi
                fi
            fi
        fi

        mv -f "${LOG_OLV_HIP}.$$.tmp" "$LOG_OLV_HIP" 2>/dev/null
        mv -f "${LOG_OLV_EPI}.$$.tmp" "$LOG_OLV_EPI" 2>/dev/null
        mv -f "${LOG_OLV_PER}.$$.tmp" "$LOG_OLV_PER" 2>/dev/null
    fi

    sleep "$CICLO_OLV"
done
